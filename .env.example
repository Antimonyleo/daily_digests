# --- Profile (local user YAML; setup wizard writes this under ignored data/) ---
PROFILE_PATH=data/profile.yaml

# --- Sources ---
SOURCES_PATH=config/sources.yaml

# --- LLM (OpenAI-compatible). Leave LLM_API_KEY empty to use extractive fallback. ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- LLM backend selector ---
# Options:
#   api         — uses LLM_BASE_URL + LLM_API_KEY (OpenAI-compatible)
#   extractive  — no LLM; first 2 sentences of abstract (default + fallback)
LLM_BACKEND=extractive

# --- Email delivery (Resend) ---
RESEND_API_KEY=
DIGEST_FROM=onboarding@resend.dev
DIGEST_TO=

# --- Scheduling ---
USER_TZ=America/New_York
DIGEST_HOUR=8

# --- Storage ---
DB_PATH=data/digest.db

# --- Ranking model (embeddings) ---
# Backend. Default (empty) = fastembed / ONNX: no PyTorch, ~400 MB install, CPU-
# fast. Auto-falls back to sentence-transformers for models outside fastembed's
# catalog (needs the `hf` extra: `uv sync --extra hf`). Force one with:
#   EMBED_BACKEND=fastembed | sentence-transformers
EMBED_BACKEND=
# Swap in a stronger scientific encoder without code changes. The item embedding
# cache keys on the model name, so changing this transparently re-embeds.
#   fastembed catalog: BAAI/bge-small-en-v1.5, BAAI/bge-base-en-v1.5, intfloat/e5-*
#   HF-only (needs `hf` extra): allenai/specter2_base, malteos/scincl, ncbi/MedCPT-Query-Encoder
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Compute device. Default cpu (intended local / CI mode). Only used by the
# sentence-transformers backend; fastembed runs on CPU via ONNX.
EMBED_DEVICE=cpu
# Asymmetric-retrieval prefixes. Defaults are BGE's. For E5 use "query: " /
# "passage: "; for SPECTER2/MedCPT leave both empty.
EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBED_DOC_PREFIX=

# --- Active learning ---
# Reserve up to N research slots for the high-quality items the learned ranker
# is most uncertain about, to gather informative votes. 0 = off. Only
# high-quality venues are eligible, so exploration never shows low-impact work.
EXPLORATION_SLOTS=0

# --- Quality weighting ---
# How strongly venue quality matters in research ranking. 1.0 = legacy (prestige
# is a mild tie-breaker). Higher rewards high-quality AND relevant work more and
# suppresses low-impact venues harder. Try 1.4–2.0 to bias toward quality.
RESEARCH_QUALITY_WEIGHT=1.4
# Scale of the topic-priority ordering nudge (profile.topic_priorities). Multiplied
# by a normalized 0..1 priority and added to the FINAL ordering score only — it
# never touches the relevance gate. Max nudge = scale*1.0; small by design so it
# only reorders near-ties.
TOPIC_PRIORITY_BONUS_SCALE=0.06
# Maximum selection-only boost for a qualified facet absent from the previous
# seven days of viewed digests. This is a soft preference, never a reserved slot.
TOPIC_COVERAGE_BONUS_SCALE=0.03
# A low-impact-venue paper must clear this base topic relevance to appear at all.
LOW_IMPACT_RELEVANCE_FLOOR=0.58
# When a calibrator has been fit from votes (`dd calibrate`, or auto-fit during
# run-all), derive this floor from P(relevant)=0.5, clamped near the default.
ADAPTIVE_RELEVANCE_FLOOR=true
# Max fraction of the research section that may be low-impact-venue items, so
# they cannot appear frequently even when many are related.
MAX_LOW_IMPACT_RESEARCH_FRAC=0.15

# --- Live citation enrichment (OpenAlex) ---
# Boost fast-rising work by citation velocity AND adjust by venue impact
# (2yr mean citedness) — the only quality signal for aggregator (OpenAlex/PubMed)
# items whose source name hides the real journal. This is the graded per-journal
# quality prior that keeps low-impact work infrequent even when it's on-topic.
# It can add many API calls to a first/catch-up brew, so it is opt-in. Results
# are cached for 14 days and later runs are faster.
CITATION_ENRICHMENT=false
# Sent to OpenAlex as the `mailto` query param (their "polite pool" convention).
# It is redacted from error logs, but note it does leave your machine in request
# URLs to OpenAlex. Leave empty to opt out.
CITATION_POLITE_EMAIL=
# Magnitude of the venue-impact boost/penalty applied when enrichment is on.
VENUE_QUALITY_WEIGHT=0.18

# --- Cross-day near-duplicate suppression ---
# Drop a candidate whose title+abstract embedding is within THRESHOLD cosine of
# an item shown in a sent digest over the last DAYS days — catches the same
# paper/story re-surfacing through a different source. Local; on by default.
CROSS_DAY_DEDUPE=true
CROSS_DAY_DEDUPE_DAYS=7
CROSS_DAY_DEDUPE_THRESHOLD=0.93

# --- Within-day semantic suppression (experimental opt-in) ---
# Inside a SINGLE digest, collapse semantically similar research candidates so
# one representative survives. Disabled by default because the current 0.86
# threshold can suppress distinct papers. If enabled, the top-scored item of each
# cluster is always kept.
WITHIN_DAY_DEDUPE=false
WITHIN_DAY_DEDUPE_THRESHOLD=0.86

# --- Behavior ---
# Optional non-research sections. Research is always included. Existing
# installations keep all sections enabled until the reader switches one off.
INCLUDE_INDUSTRY=true
INCLUDE_AI=true
INCLUDE_REGULATORY=true
INCLUDE_WORLD=true

# Per-section size. With ADAPTIVE_SECTION_SIZES on (default), TOP_* is the
# CEILING and MIN_* is the floor — each section flexes between them with the
# day's supply of "worth reading" items, so a rich day shows more and a thin day
# fewer. With it off, TOP_* is a fixed cap (legacy behavior).
TOP_RESEARCH=12
TOP_INDUSTRY=6
TOP_AI=4
TOP_REGULATORY=3
TOP_WORLD=3
ADAPTIVE_SECTION_SIZES=true
MIN_RESEARCH=3
MIN_INDUSTRY=3
MIN_AI=2
MIN_REGULATORY=2
MIN_WORLD=2
# Minimum topic relevance (true profile cosine, 0..1) an item must clear to earn
# a slot. Each section shows as many items as clear this bar, clamped to MIN_*..
# TOP_*, so off-topic-but-prestigious items are excluded rather than filling it.
# ~0.5-0.6 is weak/off-topic, ~0.65+ is a solid match. Raise to show fewer/stricter.
MIN_TOPIC_RELEVANCE=0.64
# Catch-up after a usage gap. If the last digest was N days ago, the ingest +
# ranking window widens to cover the gap (capped at MAX_BACKFILL_DAYS) and the
# research ceiling grows from TOP_RESEARCH toward MAX_RESEARCH_BACKLOG so a
# backlog of relevant papers surfaces instead of only the last day or two.
# Date-backfilling sources (bioRxiv/arXiv/OpenAlex/PubMed/FDA/ClinicalTrials)
# recover the gap; RSS journal feeds only expose their current window.
MAX_BACKFILL_DAYS=21
MAX_RESEARCH_BACKLOG=40
RETENTION_DAYS=30

# --- Inbound replies (Phase 7a). Optional. Configure to enable reply-to-vote. ---
REPLY_TO_EMAIL=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=          # Gmail: use an App Password, not your account password
                        # (Account -> Security -> 2-step -> App Passwords)
IMAP_MAILBOX=INBOX
