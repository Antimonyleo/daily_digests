# --- Profile (path to YAML; copy config/profile.example.yaml and edit) ---
PROFILE_PATH=config/profile.yaml

# --- Sources ---
SOURCES_PATH=config/sources.yaml

# --- LLM (OpenAI-compatible). Leave LLM_API_KEY empty to use extractive fallback. ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- LLM backend selector ---
# Options:
#   api         (default) — uses LLM_BASE_URL + LLM_API_KEY (OpenAI-compatible)
#   claude_code — subprocess to local `claude` CLI; uses your Anthropic subscription
#   codex       — subprocess to local `codex` CLI; uses your OpenAI subscription
#   extractive  — no LLM; first 2 sentences of abstract (also the fallback)
LLM_BACKEND=api

# Pin a specific model for claude_code or codex backends. Leave empty to use the CLI default.
# Recommended: claude-haiku-4-5-20251001 (cheap+fast) or gpt-5-mini.
# Premium: claude-opus-4-7 or gpt-5 (slow + uses more subscription quota).
LLM_CLI_MODEL=

# --- Email delivery (Resend) ---
RESEND_API_KEY=
DIGEST_FROM=onboarding@resend.dev
DIGEST_TO=

# --- Scheduling ---
USER_TZ=America/New_York
DIGEST_HOUR=8

# --- Storage ---
DB_PATH=data/digest.db

# --- Behavior ---
TOP_RESEARCH=8
TOP_INDUSTRY=6
TOP_REGULATORY=3
TOP_WORLD=3
RETENTION_DAYS=30

# --- Inbound replies (Phase 7a). Optional. Configure to enable reply-to-vote. ---
REPLY_TO_EMAIL=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=          # Gmail: use an App Password, not your account password
                        # (Account -> Security -> 2-step -> App Passwords)
IMAP_MAILBOX=INBOX
