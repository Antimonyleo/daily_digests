# FreshRSS Sidecar Configuration
# Copy this to .env and fill in your values before running docker compose up

# Domain for FreshRSS (the RSS reader UI). e.g., freshrss.yourdomain.com
FRESHRSS_DOMAIN=

# Domain for RSSHub (optional journal route proxy). e.g., rsshub.yourdomain.com
RSSHUB_DOMAIN=

# Your email for Let's Encrypt ACME cert renewal notifications
ACME_EMAIL=

# Timezone for cron jobs inside FreshRSS. e.g., America/New_York, Europe/London, UTC
TZ=UTC

# Minute to run FreshRSS's internal cron (feed refresh). 0-59. Default 30 = :30 past the hour.
CRON_MIN=30

# RSSHub basic-auth username (used to protect the RSSHub endpoint from abuse)
RSSHUB_BASIC_AUTH_USER=

# RSSHub basic-auth password hash. Generate with:
#   docker run caddy:2-alpine caddy hash-password --plaintext "your-password"
# Then copy the hash here (includes $2a$... prefix).
RSSHUB_BASIC_AUTH_HASH=
