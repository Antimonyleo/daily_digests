{% extends "_base.html.j2" %}
{% block title %}Brewing your morning tea…{% endblock %}
{% block extra_styles %}
  .wrap { max-width: 760px; }
  .card { padding: 34px 28px; text-align: center; }
  h1 { font-size: 32px; line-height: 1.1; margin: 10px 0 8px 0; letter-spacing: 0; }
  .lede { color: var(--muted); font-size: 14px; margin: 0 auto 24px; max-width: 500px; line-height: 1.55; }
  .cup {
    position: relative; width: 80px; height: 80px; margin: 0 auto 18px;
  }
  .cup .body {
    position: absolute; bottom: 0; left: 10px; width: 60px; height: 50px;
    background: #fff; border: 3px solid var(--accent); border-radius: 0 0 14px 14px;
  }
  .cup .handle {
    position: absolute; right: 0; top: 30px; width: 18px; height: 24px;
    border: 3px solid var(--accent); border-radius: 0 12px 12px 0;
    border-left: none;
  }
  .cup .steam {
    position: absolute; top: -2px; width: 4px; height: 18px;
    background: var(--accent); opacity: 0.45; border-radius: 4px;
    animation: steam 2.4s ease-in-out infinite;
  }
  .cup .steam.s1 { left: 28px; animation-delay: 0s; }
  .cup .steam.s2 { left: 38px; animation-delay: 0.5s; }
  .cup .steam.s3 { left: 48px; animation-delay: 1s; }
  @keyframes steam {
    0%   { transform: translateY(0) scaleY(0.6); opacity: 0; }
    35%  { opacity: 0.45; }
    100% { transform: translateY(-22px) scaleY(1); opacity: 0; }
  }
	  .progress-shell {
	    margin: 0 auto 20px; max-width: 420px; height: 10px;
	    background: #e5ebe5; border-radius: 999px; overflow: hidden;
	  }
  .progress-bar {
    height: 100%; width: 6%; border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--gold));
    transition: width 0.35s ease;
  }
  .detail {
    min-height: 22px; margin: -4px 0 14px; color: var(--accent-strong);
    font-size: 13px; font-weight: 650;
  }
  ul.stages {
    list-style: none; padding: 0; margin: 0 auto; max-width: 460px;
    text-align: left;
  }
  ul.stages li {
    padding: 11px 14px; border: 1px solid #edf1ec; border-bottom: none;
    font-size: 14px; display: flex; align-items: center; gap: 10px;
    color: var(--muted); background: #fff;
  }
  ul.stages li:first-child { border-radius: 8px 8px 0 0; }
  ul.stages li:last-child { border-bottom: 1px solid #edf1ec; border-radius: 0 0 8px 8px; }
  ul.stages li.active { color: var(--text); font-weight: 650; background: var(--gold-soft); }
  ul.stages li.done { color: var(--up); background: #f5faf6; }
  ul.stages li .marker {
    display: inline-block; width: 18px; text-align: center; font-weight: 700;
  }
  ul.stages li.done .marker::before { content: "✓"; color: var(--up); }
  ul.stages li.active .marker::before { content: "•"; color: var(--accent);
    animation: pulse 1.2s ease-in-out infinite; }
  ul.stages li:not(.active):not(.done) .marker::before { content: "·"; }
  @keyframes pulse { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }
	  .err { color: var(--down); margin-top: 16px; font-size: 13px; }
{% endblock %}
{% block body %}
<div class="card">
  <div class="cup">
    <div class="steam s1"></div>
    <div class="steam s2"></div>
    <div class="steam s3"></div>
    <div class="body"></div>
    <div class="handle"></div>
  </div>
	  <h1>Brewing your morning tea</h1>
	  <p class="lede">Fetching fresh sources, ranking them against your profile, and preparing the digest view.</p>

	  <div class="progress-shell" id="progress-shell" role="progressbar" aria-label="Brewing progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="6">
	    <div class="progress-bar" id="progress-bar"></div>
	  </div>
	  <div class="detail" id="detail" aria-live="polite">Starting the kettle...</div>

	  <ul class="stages" id="stages" aria-live="polite">
    <li data-stage="ingest"><span class="marker"></span><span class="text">Fetching from sources…</span></li>
    <li data-stage="dedupe"><span class="marker"></span><span class="text">Deduplicating…</span></li>
    <li data-stage="rank"><span class="marker"></span><span class="text">Ranking against your interests…</span></li>
    <li data-stage="summarize"><span class="marker"></span><span class="text">Summarizing top picks…</span></li>
    <li data-stage="render"><span class="marker"></span><span class="text">Rendering digest…</span></li>
    <li data-stage="done"><span class="marker"></span><span class="text">Done!</span></li>
  </ul>

	  <div class="err" id="err" role="alert" hidden></div>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
	  const RUN_ID = {{ run_id|tojson }};
	  const CSRF_TOKEN = {{ csrf_token|tojson }};
  const stagesEl = document.getElementById("stages");
	  const errEl = document.getElementById("err");
	  const detailEl = document.getElementById("detail");
	  const progressBar = document.getElementById("progress-bar");
	  const progressShell = document.getElementById("progress-shell");

  // Order; "ingest" stage covers ingest_start + ingest_done.
  const order = ["ingest", "dedupe", "rank", "summarize", "render", "done"];
  // Map backend stage -> UI stage key.
  const STAGE_MAP = {
    ingest_start: "ingest",
    ingest_done: "ingest",
    dedupe_done: "dedupe",
    rank_done: "rank",
    summarize_start: "summarize",
    summarize_done: "summarize",
    render_done: "render",
    done: "done",
    error: "error",
  };
  // Stages whose arrival means the *previous* UI stage completed.
  const COMPLETES_PREV = {
    dedupe_done: "ingest",
    rank_done: "dedupe",
    summarize_start: "rank",
    summarize_done: "summarize",
    render_done: "summarize",
    done: "render",
  };
  const PROGRESS = {
    connected: 6,
    ingest_start: 12,
    ingest_done: 36,
    dedupe_done: 46,
    rank_done: 62,
    summarize_start: 70,
    summarize_done: 84,
    render_done: 94,
    done: 100,
  };

	  function setProgress(stage, text) {
	    if (PROGRESS[stage]) {
	      if (progressBar) progressBar.style.width = PROGRESS[stage] + "%";
	      if (progressShell) progressShell.setAttribute("aria-valuenow", String(PROGRESS[stage]));
	    }
	    if (detailEl && text) detailEl.textContent = text;
	  }

  function setStage(uiKey, cls) {
    const li = stagesEl.querySelector(`li[data-stage="${uiKey}"]`);
    if (!li) return;
    li.classList.remove("active", "done");
    if (cls) li.classList.add(cls);
  }
  function markActive(uiKey) {
    // Remove active from all then set this one active.
    stagesEl.querySelectorAll("li.active").forEach((l) => l.classList.remove("active"));
    setStage(uiKey, "active");
  }
  function markDone(uiKey) {
    setStage(uiKey, "done");
  }
  function annotateText(uiKey, text) {
    const li = stagesEl.querySelector(`li[data-stage="${uiKey}"]`);
    if (li) li.querySelector(".text").textContent = text;
  }

  // Kick off the run, then connect SSE.
  fetch("/run/start", {
	    method: "POST",
	    headers: { "Content-Type": "application/json", "X-CSRF-Token": CSRF_TOKEN },
    body: JSON.stringify({ run_id: RUN_ID }),
  }).then((r) => {
    if (!r.ok) throw new Error("HTTP " + r.status);
  }).catch((e) => {
    errEl.hidden = false;
    errEl.textContent = "Could not start pipeline: " + e.message;
  });

  const es = new EventSource(`/run/stream?run_id=${encodeURIComponent(RUN_ID)}`);
  es.onmessage = (ev) => {
    let data;
    try { data = JSON.parse(ev.data); } catch (_) { return; }
    const stage = data.stage;
    const payload = data.payload || {};
    if (stage === "error") {
      es.close();
      errEl.hidden = false;
      errEl.textContent = "Pipeline failed: " + (payload.message || "unknown error");
      return;
    }
    const uiKey = STAGE_MAP[stage];
    if (!uiKey) return;
    setProgress(stage);

    const prev = COMPLETES_PREV[stage];
    if (prev) markDone(prev);

    // Live text for ingest progress.
    if (stage === "ingest_start") {
      annotateText("ingest", `Fetching from ${payload.sources || "?"} sources…`);
      setProgress(stage, `Contacting ${payload.sources || "?"} sources`);
      markActive("ingest");
    } else if (stage === "ingest_done") {
      annotateText("ingest", `Fetched ${payload.raw_items || 0} items from ${payload.sources || "?"} sources.`);
      setProgress(stage, `Fetched ${payload.raw_items || 0} raw items`);
    } else if (stage === "dedupe_done") {
      annotateText("dedupe", `Deduplicated to ${payload.english || payload.deduped || 0} items.`);
      setProgress(stage, `Kept ${payload.english || payload.deduped || 0} English items`);
      markActive("rank");
    } else if (stage === "rank_done") {
      annotateText("rank", `Picked ${payload.picked || 0} top items.`);
      setProgress(stage, `Selected ${payload.picked || 0} top entries`);
      markActive("summarize");
    } else if (stage === "summarize_start") {
      annotateText("summarize", `Summarizing ${payload.items || 0} items via ${payload.backend || "extractive"}…`);
      setProgress(stage, `Summarizing with ${payload.backend || "extractive"}`);
      markActive("summarize");
    } else if (stage === "summarize_done") {
      annotateText("summarize", `Summarized ${payload.items || 0} items.`);
      setProgress(stage, `Summarized ${payload.items || 0} entries`);
      markActive("render");
    } else if (stage === "render_done") {
      annotateText("render", `Rendered ${(payload.html_bytes || 0).toLocaleString()} bytes.`);
      setProgress(stage, "Rendering the final page");
      markActive("done");
    } else if (stage === "done") {
      setProgress(stage, "Ready");
      markDone("done");
      es.close();
      const did = encodeURIComponent(payload.digest_id || "");
      const n = payload.total_items || 0;
      setTimeout(() => {
        window.location.href = `/done?digest_id=${did}&n=${n}`;
      }, 600);
    }
  };
  es.onerror = () => { /* leave stream; auto-reconnects */ };
})();
</script>
{% endblock %}
