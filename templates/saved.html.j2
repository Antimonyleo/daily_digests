{% extends "_base.html.j2" %}
{% from "_feedback_controls.html.j2" import feedback_controls %}
{% block title %}Saved reading · DailyDigest{% endblock %}
{% block extra_styles %}
  .rating-help { color: var(--muted); font-size: 12px; margin: 8px 0; }
  .wrap { max-width: 920px; }
  .saved-header {
    display: flex; align-items: end; justify-content: space-between; gap: 18px;
    margin-bottom: 18px;
  }
  .eyebrow {
    color: var(--accent); font-size: 12px; font-weight: 800;
    letter-spacing: 0.09em; text-transform: uppercase; margin-bottom: 7px;
  }
  h1 { margin: 0; font-size: clamp(30px, 5vw, 44px); line-height: 1.05; }
  .subhead { color: var(--muted); margin: 9px 0 0; line-height: 1.5; }
  .saved-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .search-card {
    display: grid; grid-template-columns: 1fr auto; gap: 8px;
    padding: 14px; margin-bottom: 14px; border: 1px solid var(--border);
    border-radius: 12px; background: var(--card); box-shadow: var(--shadow);
  }
  .search-card input {
    width: 100%; min-height: 42px; padding: 9px 12px;
    border: 1px solid var(--border); border-radius: 8px;
    background: var(--panel); color: var(--text);
  }
  .archive-meta { color: var(--muted); font-size: 13px; margin: 0 0 12px; }
  .saved-list { display: grid; gap: 10px; }
  .saved-card {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px;
    padding: 18px; border: 1px solid var(--border); border-radius: 12px;
    background: var(--card); box-shadow: 0 8px 26px rgba(21, 34, 27, 0.05);
  }
  .saved-title {
    color: var(--text); font-size: 17px; font-weight: 760;
    line-height: 1.35; text-decoration: none;
  }
  .saved-title:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .saved-meta { color: var(--muted); font-size: 12px; margin-top: 7px; }
  .saved-summary { color: var(--text); opacity: 0.82; font-size: 13px; line-height: 1.55; margin-top: 10px; }
  .vote-row, .reason-chip-row, .feedback-actions { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .vote-btn, .reason-chip { min-height:44px; border:1px solid var(--control-border); border-radius:8px; padding:8px; background:var(--panel); color:var(--text); cursor:pointer; }
  .vote-btn.active, .reason-chip.active { border-color:var(--accent); font-weight:750; }
  .reason-prompt, .vote-title, .save-state { font-size:13px; color:var(--muted); margin-top:12px; }
  .vote-btn:focus-visible, .reason-chip:focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
  .remove-saved { align-self: start; white-space: nowrap; }
  .empty-archive {
    padding: 48px 24px; text-align: center; border: 1px dashed var(--border);
    border-radius: 12px; color: var(--muted); background: var(--panel);
  }
  @media (max-width: 680px) {
    .saved-header { align-items: start; flex-direction: column; }
    .search-card, .saved-card { grid-template-columns: 1fr; }
  }
{% endblock %}
{% block body %}
  {% if feedback_warning %}<p role="alert">Feedback is paused: {{ feedback_warning }}</p>{% endif %}
  <header class="saved-header">
    <div>
      <div class="eyebrow">Your personal library</div>
      <h1>Saved reading</h1>
      <p class="subhead">Keep useful papers, calls, and news within reach.</p>
    </div>
    <div class="saved-actions">
      <a class="btn primary" href="/">Today’s digest</a>
      <a class="btn" href="/run">Brew again</a>
    </div>
  </header>

  <form class="search-card" action="/saved" method="get" role="search">
    <input name="q" type="search" value="{{ query }}" placeholder="Search title, source, abstract, or summary" aria-label="Search saved reading">
    <button class="btn primary" type="submit">Search</button>
  </form>

  <p class="archive-meta" id="archive-count">{{ total }} saved item{{ '' if total == 1 else 's' }}{% if query %} matching “{{ query }}”{% endif %}</p>
  {% if items %}
  <div class="saved-list" id="saved-list">
    {% for item in items %}
    <article class="saved-card" data-item-id="{{ item.id }}" data-current-grade="{{ item.current_grade if item.current_grade is not none else '' }}">
      <div>
        <a class="saved-title" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
        <div class="saved-meta">
          {{ item.section }} · {{ item.source }}{% if item.published %} · Published {{ item.published }}{% endif %}{% if item.saved %} · Saved {{ item.saved }}{% endif %}
        </div>
        {% if item.summary %}<div class="saved-summary">{{ item.summary }}</div>{% endif %}
        {% include "_article_figure.html.j2" %}
        {{ feedback_controls(item) }}
        <div class="save-state" aria-live="polite"></div>
      </div>
      <button class="btn remove-saved" type="button">Remove</button>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-archive">
    {% if query %}No saved items match “{{ query }}”.{% else %}Nothing saved yet. Use “Save for later” on any digest item.{% endif %}
  </div>
  {% endif %}
  {% if pages > 1 %}<nav class="saved-actions" aria-label="Saved reading pages">
    {% if previous_page %}<a class="btn" href="{{ previous_page }}">Previous page</a>{% endif %}
    <span>Page {{ page }} of {{ pages }}</span>
    {% if next_page %}<a class="btn" href="{{ next_page }}">Next page</a>{% endif %}
  </nav>{% endif %}
{% endblock %}
{% block scripts %}
<script>
(function () {
  const CSRF_TOKEN = {{ csrf_token|tojson }};

  window.addEventListener('dd-storage-committed', () => {
    document.querySelectorAll('.save-state.pending').forEach(status => {
      status.classList.remove('pending'); status.textContent='Saved in this browser';
    });
  });

  document.querySelectorAll(".saved-card").forEach(card => {
    const status = card.querySelector(".save-state");
    const clear = card.querySelector(".clear-rating");
    const reasonBlock = card.querySelector(".reason-block");
    function busy(value) {
      card.querySelectorAll(".vote-btn, .reason-chip, .clear-rating").forEach(b => b.disabled = value);
      if (value) status.classList.remove('pending');
    }
    function feedbackStatus(message, pending=false) {
      status.textContent=message; status.classList.toggle('pending',pending);
    }
    function active(grade) {
      card.dataset.currentGrade = grade === null ? "" : String(grade);
      card.querySelectorAll(".vote-btn").forEach(b => {
        const selected = b.dataset.grade === card.dataset.currentGrade;
        b.classList.toggle("active", selected);
        b.setAttribute("aria-pressed", String(selected));
      });
      const negative = ["10", "40"].includes(card.dataset.currentGrade);
      reasonBlock.hidden = !negative;
      clear.hidden = grade === null;
    }
    async function write(url, method) {
      const response = await fetch(url, {method, headers:{"X-CSRF-Token":CSRF_TOKEN}});
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.detail || "Feedback was not saved. Try again.");
      payload.storagePending = response.headers.get("x-dailydigest-storage") === "pending";
      return payload;
    }
    const rate = createRatingQueue({
      initial:card.dataset.currentGrade || null, select:active,
      send:grade => write(`/vote/${card.dataset.itemId}${grade === null ? '' : '/' + grade}`, grade === null ? 'DELETE' : 'POST'),
      committed:(_payload, grade) => {
        if (!['10','40'].includes(String(grade))) card.querySelectorAll('.reason-chip').forEach(button => {
          button.classList.remove('active'); button.setAttribute('aria-pressed', 'false');
        });
      },
      busy:value => {busy(value); card.querySelectorAll('.vote-btn').forEach(b => {b.disabled=false;}); if (value) status.textContent='Recording response…';},
      success:(payload, grade) => {
        feedbackStatus(grade === null
          ? (payload.storagePending ? 'Rating cleared · saving browser copy…' : 'Rating cleared; this item stays saved.')
          : (payload.storagePending ? 'Rating recorded · saving browser copy…' : 'Rating saved. Reasons are optional.'),payload.storagePending);
        if (grade === null) card.querySelector('.vote-btn').focus();
      },
      failure:error => {feedbackStatus('Rating was not saved. '+error.message);},
    });
    card.querySelectorAll('.vote-btn').forEach(button => button.addEventListener('click', () => {void rate(button.dataset.grade);}));
    clear.addEventListener('click', () => {void rate(null);});
    card.querySelectorAll(".reason-chip").forEach(button => button.addEventListener("click", async () => {
      if (!["10", "40"].includes(card.dataset.currentGrade)) return;
      const removing = button.classList.contains("active");
      busy(true);
      try {
        const payload=await write(`/vote/${card.dataset.itemId}/reason/${button.dataset.reason}`, removing ? "DELETE" : "POST");
        button.classList.toggle("active", !removing);
        button.setAttribute("aria-pressed", String(!removing));
        feedbackStatus((removing ? 'Reason removed.' : 'Reason saved.')+(payload.storagePending ? ' Saving browser copy…' : ''),payload.storagePending);
      } catch(error) { feedbackStatus(error.message); }
      finally { busy(false); }
    }));
  });
  document.querySelectorAll(".remove-saved").forEach((button) => {
    button.addEventListener("click", async () => {
      const card = button.closest(".saved-card");
      const itemId = card.dataset.itemId;
      button.disabled = true;
      try {
        const response = await fetch(`/bookmark/${itemId}`, {
          method: "DELETE",
          headers: { "X-CSRF-Token": CSRF_TOKEN },
        });
        if (!response.ok) throw new Error("HTTP " + response.status);
        window.location.reload();
      } catch (error) {
        button.disabled = false;
        button.textContent = "Try again";
      }
    });
  });
})();
</script>
{% endblock %}
