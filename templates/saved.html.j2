{% extends "_base.html.j2" %}
{% from "_feedback_controls.html.j2" import feedback_controls %}
{% block title %}Saved reading · DailyDigest{% endblock %}
{% block extra_styles %}{% include "_saved_layout.css.j2" %}{% endblock %}
{% block body %}
  {% if feedback_warning %}<p role="alert">Feedback is paused: {{ feedback_warning }}</p>{% endif %}
  <header class="saved-header">
    <div>
      <h1>Saved reading</h1>
    </div>
    <div class="saved-actions">
      <a class="btn" href="/">Today’s digest</a>
      <a class="btn" href="/setup">Settings</a>
    </div>
  </header>

  {% if tracked %}
  {# Funding, calls and events marked Interested, soonest date first. #}
  <section class="tracked-deadlines" id="tracked" aria-labelledby="tracked-title">
    <h2 id="tracked-title">Tracked deadlines</h2>
    <p class="archive-meta">Items you marked Interested. Dates and eligibility come from the listing; confirm them on the official page.</p>
    <ul class="tracked-list">
      {% for row in tracked %}
      <li class="tracked-row" data-item-id="{{ row.id }}" data-tracked="true">
        <div class="tracked-when">{% if row.date_iso %}<span class="coming-word">{{ row.date_word }}</span> <time datetime="{{ row.date_iso }}">{{ row.date_label }}</time><span class="deadline-countdown" data-deadline="{{ row.date_iso }}"></span>{% else %}{{ row.date_label }}{% endif %}</div>
        <div class="tracked-body">
          <a class="tracked-title" href="{{ row.url }}" target="_blank" rel="noopener">{{ row.title }}</a>
          <div class="saved-meta">{{ row.kind }} · <span class="venue">{{ row.source }}</span>{% if row.kind == 'Event' and row.event_dates_label %} · {{ row.event_dates_label }}{% endif %}{% if row.kind == 'Event' and row.location %} · {{ row.location }}{% endif %}{% if row.kind != 'Event' and row.amount %} · {{ row.amount }}{% endif %}</div>
          <div class="saved-meta">Eligibility: {% if row.eligibility == 'Potentially eligible' %}Potentially eligible{% else %}check the official {{ 'page' if row.kind == 'Event' else 'call' }}{% endif %}{% if row.eligibility_note %} · {{ row.eligibility_note }}{% endif %} · <a href="{{ row.calendar_url }}">Add to calendar</a></div>
        </div>
        <button class="btn untrack-btn" type="button" aria-pressed="true" aria-label="Stop tracking {{ row.title }}">Stop tracking</button>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <form class="search-card" action="/saved" method="get" role="search">
    <input name="q" type="search" value="{{ query }}" placeholder="Search title, source, abstract, or summary" aria-label="Search saved reading">
    <button class="btn primary" type="submit">Search</button>
  </form>

  <p class="archive-meta" id="archive-count" data-total="{{ total }}" data-query="{{ query }}">{{ total }} saved item{{ '' if total == 1 else 's' }}{% if query %} matching “{{ query }}”{% endif %}</p>
  {% if items %}
  <div class="saved-list" id="saved-list">
    {% for item in items %}
    <article class="saved-card" data-item-id="{{ item.id }}" data-current-grade="{{ item.current_grade if item.current_grade is not none else '' }}" data-saved-state="saved" data-saved-item-ids="{{ item.saved_item_ids | default([item.id]) | join(',') }}">
      <div class="saved-content">
        <a class="saved-title" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
        <div class="saved-meta">
          {{- item.section }} · <span class="venue">{{ item.source }}</span>{% if item.publication_label %} · {{ item.publication_label }}{% endif %}{% if item.published_label %} · Published {% if item.published_iso %}<time datetime="{{ item.published_iso }}">{{ item.published_label }}</time>{% else %}{{ item.published_label }}{% endif %}{% endif %}{% if item.saved %} · Saved {{ item.saved }}{% endif -%}
        </div>
        {% include "_version_links.html.j2" %}
        {% set has_finding = item.summary_fields and item.summary_fields.get('Key finding') %}
        {% if has_finding %}
        <div class="summary-primary"><div class="summary-label">{{ item.finding_label | default('Key finding') }}</div><div class="summary-text">{{ item.summary_fields.get('Key finding') }}</div></div>
        {% if item.summary_fields.get('Why read') %}<div class="reading-context-field" data-summary-label="Why read"><div class="summary-label">Why read</div><div class="summary-text">{{ item.summary_fields.get('Why read') }}</div></div>{% endif %}
        {% else %}{% if item.summary %}<div class="saved-summary">{{ item.summary }}</div>{% endif %}{% endif %}
        {% include "_article_figure.html.j2" %}
        {% if item.related_commentaries %}
        <ul class="related-commentaries" aria-label="Commentary on {{ item.title }}">
          {% for commentary in item.related_commentaries %}
          <li><span class="publication-label">{{ commentary.publication_label }}</span> · <a href="{{ commentary.url }}" target="_blank" rel="noopener noreferrer">{{ commentary.title }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if has_finding and item.summary_fields.get('Caveat') %}
        <details class="item-details">
          <summary>Details</summary>
          <div class="item-details-body"><div class="summary-field" data-summary-label="Caveat"><div class="summary-label">Caveat</div><div class="summary-text">{{ item.summary_fields.get('Caveat') }}</div></div></div>
        </details>
        {% endif %}
        <div class="saved-feedback">{{ feedback_controls(item) }}<button class="copy-summary btn" type="button">Copy summary</button><span class="copy-status" role="status"></span></div>
        <div class="save-state" aria-live="polite"></div>
      </div>
      <button class="btn remove-saved" type="button" aria-label="Remove {{ item.title }} from saved reading">Remove</button>
      <div class="saved-removal" hidden><span>Removed from saved reading: <strong>{{ item.title }}</strong></span><button class="btn undo-saved" type="button">Undo</button><span class="removal-state" role="status"></span></div>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-archive">
    {% if query %}No saved items match “{{ query }}”.{% else %}Nothing saved yet. Use “Save for later” on any digest item.{% endif %}
  </div>
  {% endif %}
  <details class="saved-rating-help"><summary>About ratings</summary><p>Ratings guide future recommendations. Less relevant and Not relevant lower their priority; reasons distinguish topic fit, difficulty and access.</p></details>
  {% if pages > 1 %}<nav class="saved-actions" aria-label="Saved reading pages">
    {% if previous_page %}<a class="btn" href="{{ previous_page }}">Previous page</a>{% endif %}
    <span>Page {{ page }} of {{ pages }}</span>
    {% if next_page %}<a class="btn" href="{{ next_page }}">Next page</a>{% endif %}
  </nav>{% endif %}
{% endblock %}
{% block scripts %}
<script>
(function () {
  const CSRF_TOKEN = {{ csrf_token|tojson }};
{% include "_countdown.js.j2" %}
  document.querySelectorAll('.tracked-row .deadline-countdown[data-deadline]').forEach(node=>{
    const days=daysUntil(node.dataset.deadline);
    if(!Number.isFinite(days))return;
    node.textContent=countdownText(days);
    node.closest('.tracked-row').toggleAttribute('data-deadline-soon',countdownSoon(days));
    node.closest('.tracked-row').toggleAttribute('data-deadline-passed',days<0);
  });
  // Stop tracking keeps the row, so a slip is one click to undo.
  document.querySelectorAll('.tracked-row').forEach(row=>{
    const button=row.querySelector('.untrack-btn');
    button.addEventListener('click',async()=>{
      const tracked=row.dataset.tracked==='true';
      button.disabled=true;
      try{
        const response=await fetch(`/interested/${row.dataset.itemId}`,{method:tracked?'DELETE':'POST',headers:{'X-CSRF-Token':CSRF_TOKEN}});
        if(!response.ok)throw new Error(String(response.status));
        row.dataset.tracked=tracked?'false':'true';
        button.textContent=tracked?'Track again':'Stop tracking';
        button.setAttribute('aria-pressed',tracked?'false':'true');
      }catch(error){button.textContent='Not saved · try again';}
      finally{button.disabled=false;}
    });
  });
  const bookmarkCards = new Map();
  function updateSavedCount() {
    const count = document.getElementById('archive-count');
    if (!count) return;
    const removed = Array.from(bookmarkCards.values()).filter(state => !state.saved).length;
    const total = Math.max(0, Number(count.dataset.total) - removed);
    const query = count.dataset.query;
    count.textContent = `${total} saved item${total === 1 ? '' : 's'}${query ? ` matching “${query}”` : ''}`;
  }
  function finishBookmark(state, saved) {
    // A checkpoint may finish a pending action while its retry is in flight.
    // Invalidating that response prevents a stale failure from changing the UI.
    state.serial += 1;
    state.saved = saved; state.pending = null;
    state.card.dataset.savedState = saved ? 'saved' : 'removed';
    delete state.remove.dataset.pendingRemoval; delete state.undo.dataset.pendingRestore;
    state.content.hidden = !saved; state.remove.hidden = !saved; state.removal.hidden = saved;
    state.remove.disabled = state.undo.disabled = false;
    state.remove.textContent = 'Remove'; state.undo.textContent = 'Undo';
    state.status.classList.remove('pending'); state.removalStatus.classList.remove('pending');
    state.status.textContent = saved ? 'Restored to saved reading' : '';
    state.removalStatus.textContent = '';
    updateSavedCount();
    (saved ? state.remove : state.undo).focus();
  }
  window.addEventListener('dd-storage-committed', () => {
    document.querySelectorAll('.save-state.pending').forEach(status => {
      status.classList.remove('pending'); status.textContent='Saved in this browser';
    });
    bookmarkCards.forEach(state => { if (state.pending !== null) finishBookmark(state, state.pending); });
  });

  document.querySelectorAll(".saved-card").forEach(card => {
    const status = card.querySelector(".save-state");
    const clear = card.querySelector(".clear-rating");
    const reasonBlock = card.querySelector(".reason-block");
    function busy(value) {
      card.querySelectorAll(".vote-btn, .reason-chip, .clear-rating").forEach(b => b.disabled = value);
      if (value) status.classList.remove('pending');
    }
    function feedbackStatus(message, pending=false) {
      status.textContent=message; status.classList.toggle('pending',pending);
    }
    function active(grade) {
      card.dataset.currentGrade = grade === null ? "" : String(grade);
      card.querySelectorAll(".vote-btn").forEach(b => {
        const selected = b.dataset.grade === card.dataset.currentGrade;
        b.classList.toggle("active", selected);
        b.setAttribute("aria-pressed", String(selected));
      });
      const negative = ["10", "40"].includes(card.dataset.currentGrade);
      reasonBlock.hidden = !negative;
      clear.hidden = grade === null;
    }
    async function write(url, method) {
      const response = await fetch(url, {method, headers:{"X-CSRF-Token":CSRF_TOKEN}});
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.detail || "Feedback was not saved. Try again.");
      payload.storagePending = response.headers.get("x-dailydigest-storage") === "pending";
      return payload;
    }
    const rate = createRatingQueue({
      initial:card.dataset.currentGrade || null, select:active,
      send:grade => write(`/vote/${card.dataset.itemId}${grade === null ? '' : '/' + grade}`, grade === null ? 'DELETE' : 'POST'),
      committed:(_payload, grade) => {
        if (!['10','40'].includes(String(grade))) card.querySelectorAll('.reason-chip').forEach(button => {
          button.classList.remove('active'); button.setAttribute('aria-pressed', 'false');
        });
      },
      busy:value => {busy(value); card.querySelectorAll('.vote-btn').forEach(b => {b.disabled=false;}); if (value) status.textContent='Recording response…';},
      success:(payload, grade) => {
        feedbackStatus(grade === null
          ? (payload.storagePending ? 'Rating cleared · saving browser copy…' : 'Rating cleared; this item stays saved.')
          : (payload.storagePending ? 'Rating recorded · saving browser copy…' : 'Rating saved. Reasons are optional.'),payload.storagePending);
        if (grade === null) card.querySelector('.vote-btn').focus();
      },
      failure:error => {feedbackStatus('Rating was not saved. '+error.message);},
    });
    card.querySelectorAll('.vote-btn').forEach(button => button.addEventListener('click', () => {void rate(button.dataset.grade);}));
    clear.addEventListener('click', () => {void rate(null);});
    card.querySelectorAll(".reason-chip").forEach(button => button.addEventListener("click", async () => {
      if (!["10", "40"].includes(card.dataset.currentGrade)) return;
      const removing = button.classList.contains("active");
      busy(true);
      try {
        const payload=await write(`/vote/${card.dataset.itemId}/reason/${button.dataset.reason}`, removing ? "DELETE" : "POST");
        button.classList.toggle("active", !removing);
        button.setAttribute("aria-pressed", String(!removing));
        feedbackStatus(payload.storagePending
          ? (removing ? 'Reason removed' : 'Reason recorded')+' · saving browser copy…'
          : (removing ? 'Reason removed.' : 'Reason saved.'),payload.storagePending);
      } catch(error) { feedbackStatus(error.message); }
      finally { busy(false); }
    }));
  });
  document.querySelectorAll(".remove-saved").forEach((button) => {
    const card = button.closest('.saved-card');
    const state = {card, remove:button, undo:card.querySelector('.undo-saved'),
      content:card.querySelector('.saved-content'), removal:card.querySelector('.saved-removal'),
      status:card.querySelector('.save-state'), removalStatus:card.querySelector('.removal-state'),
      saved:true, pending:null, serial:0};
    bookmarkCards.set(card.dataset.itemId,state);
    async function changeBookmark(saved) {
      const serial = ++state.serial;
      const action = saved ? state.undo : state.remove;
      const status = saved ? state.removalStatus : state.status;
      action.disabled = true;
      status.textContent = saved ? 'Restoring…' : 'Removing…';
      try {
        // One card is one work: Remove clears, and Undo restores, every saved version.
        const versions = (card.dataset.savedItemIds || '').split(',')
          .filter(value => /^\d+$/.test(value) && value !== card.dataset.itemId);
        const response = await fetch(`/bookmark/${card.dataset.itemId}${versions.length ? '?versions=' + versions.join(',') : ''}`, {
          method:saved ? 'POST' : 'DELETE', headers:{'X-CSRF-Token':CSRF_TOKEN},
        });
        if (serial !== state.serial) return;
        if (!response.ok) throw new Error('HTTP '+response.status);
        if (response.headers.get('x-dailydigest-storage') === 'pending') {
          state.pending = saved;
          if (saved) state.undo.dataset.pendingRestore = 'true';
          else state.remove.dataset.pendingRemoval = 'true';
          status.classList.add('pending');
          status.textContent = (saved ? 'Restore recorded' : 'Removal recorded')+' · saving browser copy…';
          action.textContent = saved ? 'Retry restore' : 'Retry removal';
        } else finishBookmark(state,saved);
      } catch (_error) {
        if (serial !== state.serial) return;
        if (state.pending !== null) {
          status.classList.add('pending');
          status.textContent = 'Retry failed; '+(saved ? 'restore' : 'removal')+' is still waiting for browser storage.';
        } else {
          status.classList.remove('pending');
          status.textContent = saved ? 'Could not restore this item. Try again.' : 'Could not remove this item. Try again.';
        }
        action.textContent = saved ? 'Retry restore' : 'Try again';
      } finally {
        if (serial === state.serial) action.disabled = false;
      }
    }
    state.remove.addEventListener('click', () => changeBookmark(false));
    state.undo.addEventListener('click', () => changeBookmark(true));
  });
})();
</script>
{% endblock %}
