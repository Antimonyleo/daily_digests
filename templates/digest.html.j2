<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DailyDigest {{ digest_id }}</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#222;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f5f5f7;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:8px;border:1px solid #e5e5ea;">
          <tr>
            <td style="padding:24px 24px 8px 24px;border-bottom:1px solid #efeff4;">
              <div style="font-size:12px;color:#888;letter-spacing:0.08em;text-transform:uppercase;">DailyDigest</div>
              <div style="font-size:22px;font-weight:600;margin-top:4px;">{{ digest_id }}</div>
            </td>
          </tr>

          {% for section in sections %}
          <tr>
            <td style="padding:20px 24px 4px 24px;">
              <h2 style="font-size:16px;margin:0 0 12px 0;color:#111;border-bottom:1px solid #efeff4;padding-bottom:6px;">
                <span style="margin-right:6px;">{{ section.emoji }}</span>{{ section.title }}
              </h2>
            </td>
          </tr>
          {% for item in section.entries %}
          <tr>
            <td style="padding:8px 24px 14px 24px;">
              <div style="font-size:14px;line-height:1.45;">
                <span style="display:inline-block;font-weight:700;color:#0a66c2;margin-right:6px;font-family:Menlo,Consolas,monospace;font-size:12px;background:#eef4fb;padding:1px 6px;border-radius:4px;">{{ item.label }}</span>
                {% if item.type_label %}
                <span style="display:inline-block;font-weight:700;color:#6b5b1f;margin-right:6px;font-size:10px;text-transform:uppercase;letter-spacing:0.04em;background:#f5efd6;padding:1px 6px;border-radius:4px;">{{ item.type_label }}</span>
                {% endif %}
                <a href="{{ item.url }}" style="color:#0a66c2;text-decoration:none;font-weight:600;">{{ item.title }}</a>
              </div>
              <div style="font-size:11px;color:#888;margin-top:3px;">
                {{ item.source }}{% if item.published %} &middot; {{ item.published }}{% endif %}
              </div>
              {% if item.reason %}
              <div style="font-size:11px;color:#999;margin-top:3px;font-style:italic;">
                {{ item.reason }}
              </div>
              {% endif %}
              {% if item.summary %}
              <div style="font-size:13px;line-height:1.5;margin-top:6px;color:#333;">
                {{ item.summary }}
              </div>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
          {% endfor %}

          <tr>
            <td style="padding:20px 24px 24px 24px;border-top:1px solid #efeff4;font-size:12px;color:#888;line-height:1.5;">
              Reply with <code style="background:#f0f0f3;padding:1px 4px;border-radius:3px;">+R3 R7 -I5</code> style preferences (or use <code style="background:#f0f0f3;padding:1px 4px;border-radius:3px;">dd vote ...</code>) to improve future digests.
            </td>
          </tr>
          {% if health_summary %}
          <tr>
            <td style="padding:14px 24px 20px 24px;border-top:1px solid #efeff4;font-size:11px;color:#888;line-height:1.4;">
              <div style="text-transform:uppercase;letter-spacing:0.06em;font-size:10px;color:#aaa;margin-bottom:6px;">Source health (last 7 days)</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:11px;color:#666;border-collapse:collapse;">
                <tr style="color:#aaa;">
                  <td style="padding:2px 8px 2px 0;text-align:left;">Source</td>
                  <td style="padding:2px 8px;text-align:right;">Items</td>
                  <td style="padding:2px 0 2px 8px;text-align:right;">Failures</td>
                </tr>
                {% for row in health_summary %}
                <tr>
                  <td style="padding:2px 8px 2px 0;">{{ row.source }}</td>
                  <td style="padding:2px 8px;text-align:right;">{{ row.items_7d }}</td>
                  <td style="padding:2px 0 2px 8px;text-align:right;{% if row.failures_7d %}color:#b04040;{% endif %}">{{ row.failures_7d }}</td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>
          {% endif %}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
