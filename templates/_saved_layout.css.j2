  .wrap { max-width: 1040px; padding: 24px 16px 80px; }
  .saved-header { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:22px; }
  h1 { margin:0; font-size:30px; line-height:1.15; letter-spacing:-.02em; font-weight:650; }
  .saved-actions { display:flex; gap:8px; flex-wrap:wrap; }
  .saved-header .saved-actions .btn { border:0; background:transparent; color:var(--text); }
  .search-card { display:flex; gap:8px; margin-bottom:12px; }
  .search-card input { flex:1; min-width:0; min-height:44px; padding:9px 12px; border:1px solid var(--control-border); border-radius:7px; background:var(--card); color:var(--text); font:inherit; font-size:16px; }
  .archive-meta { color:var(--muted); font-size:14px; margin:0 0 14px; }
  .saved-list { border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--card); }
  .saved-card { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:16px; padding:24px; border-bottom:1px solid var(--border); }
  .saved-card:last-child { border-bottom:0; }
  .saved-content { min-width:0; }
  .saved-title { color:var(--text); font-size:21px; font-weight:550; line-height:1.35; letter-spacing:-.01em; text-decoration:none; overflow-wrap:anywhere; }
  .saved-title:hover { color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
  .saved-meta { color:var(--muted); font-size:14px; line-height:1.5; margin-top:8px; overflow-wrap:anywhere; }
  .summary-primary { margin:16px 0 12px; }
  .summary-primary .summary-label { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; font-size:12px; color:var(--muted); margin-bottom:4px; }
  .summary-primary .summary-text, .saved-summary { color:var(--text); font-size:16px; line-height:1.5; max-width:70ch; }
  /* A study caveat sits in Details, as on the digest card. */
  .saved-card .item-details { margin-top:2px; }
  .saved-card .item-details > summary { cursor:pointer; width:fit-content; min-height:40px; padding:8px 0; color:var(--accent-strong); font-size:14px; font-weight:550; }
  .saved-card .item-details .summary-field { display:grid; grid-template-columns:86px minmax(0,1fr); gap:10px; max-width:74ch; }
  .saved-card .item-details .summary-label { color:var(--muted); font-size:13px; font-weight:550; }
  .saved-card .item-details .summary-text { color:var(--copy-secondary); font-size:15px; line-height:1.45; }
  .saved-summary { margin-top:14px; }
  .reading-context-field { display:grid; grid-template-columns:86px minmax(0,1fr); gap:10px; margin:7px 0; max-width:74ch; }
  .reading-context-field .summary-label { font-size:13px; font-weight:550; color:var(--muted); }
  .reading-context-field .summary-text { font-size:15px; line-height:1.45; color:var(--copy-secondary); }
  .related-commentaries { margin:10px 0; padding:0 0 0 12px; border-left:1px solid var(--border); list-style:none; font-size:14px; line-height:1.45; }
  .related-commentaries li + li { margin-top:6px; }
  .related-commentaries .publication-label { color:var(--muted); }
  .related-commentaries a { overflow-wrap:anywhere; text-underline-offset:3px; }
  .saved-feedback { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; margin-top:16px; }
  .saved-feedback > .vote-title, .saved-feedback > .rating-help { display:none; }
  .vote-row, .reason-chip-row { display:flex; flex-wrap:wrap; gap:0; }
  .vote-btn, .reason-chip { min-height:44px; border:1px solid var(--control-border); padding:8px 10px; background:var(--card); color:var(--text); font:inherit; font-size:14px; cursor:pointer; }
  .vote-btn { margin-left:-1px; border-radius:0; }
  .vote-btn:first-child { margin-left:0; border-radius:6px 0 0 6px; }
  .vote-btn:last-child { border-radius:0 6px 6px 0; }
  .vote-btn.active, .reason-chip.active { background:var(--accent-soft); border-color:var(--accent); color:var(--accent-strong); font-weight:650; }
  .reason-block { flex-basis:100%; }
  .reason-chip-row { gap:6px; }
  .reason-chip { border-radius:6px; }
  .reason-prompt, .save-state, .copy-status, .removal-state { color:var(--muted); font-size:13px; line-height:1.45; }
  .reason-prompt { margin:8px 0; }
  .feedback-actions { display:flex; gap:8px; margin:0; }
  .copy-summary.btn { padding-inline:4px; border:0; color:var(--accent-strong); background:transparent; font-size:14px; }
  .copy-fallback { flex-basis:100%; width:100%; min-height:120px; padding:8px 10px; border:1px solid var(--control-border); border-radius:6px; background:var(--card); color:var(--text); font:inherit; font-size:14px; }
  .save-state { margin-top:10px; }
  .save-state:empty { display:none; }
  .remove-saved { align-self:start; background:transparent; border:0; color:var(--muted); }
  .saved-removal { grid-column:1/-1; display:flex; flex-wrap:wrap; align-items:center; gap:10px 14px; min-width:0; font-size:14px; }
  .saved-removal strong { font-weight:550; overflow-wrap:anywhere; }
  .saved-removal .removal-state { flex-basis:100%; }
  .saved-card[data-saved-state="removed"] { background:var(--panel); }
  .empty-archive { padding:32px 20px; border:1px solid var(--border); border-radius:12px; color:var(--muted); background:var(--card); }
  .saved-rating-help { margin:18px 0; color:var(--muted); font-size:14px; }
  .saved-rating-help summary { cursor:pointer; }
  .saved-rating-help p { max-width:70ch; }
  @media(max-width:680px) {
    .wrap { padding:18px 12px 72px; }
    .saved-header { align-items:flex-start; flex-wrap:wrap; }
    h1 { font-size:27px; }
    .saved-actions { margin-left:auto; }
    .saved-card { display:block; position:relative; padding:20px 16px; }
    .saved-title { display:block; padding-right:52px; font-size:20px; line-height:1.35; }
    .reading-context-field, .saved-card .item-details .summary-field { grid-template-columns:1fr; gap:2px; }
    .vote-btn { padding-inline:6px; font-size:13px; }
    .remove-saved { position:absolute; top:20px; right:12px; padding-inline:6px; font-size:13px; }
  }
  @media(max-width:360px) {
    .saved-feedback > .vote-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); width:100%; }
    .vote-btn { margin:0; border-radius:0 !important; }
  }

  .saved-feedback .vote-row { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); width:min(100%,650px); }
  .saved-feedback .vote-btn { position:relative; padding-inline:22px 8px; }
  .saved-feedback .vote-btn.active::before { content:'✓'; position:absolute; left:7px; top:50%; transform:translateY(-50%); }
  @media(max-width:480px) { .saved-feedback .vote-row { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  .version-links { margin:4px 0 0; padding:0; list-style:none; color:var(--muted); font-size:14px; line-height:1.5; }
  .version-links li { overflow-wrap:anywhere; }
  .version-links cite { font-style:italic; }
  .version-links a { color:var(--accent-strong); text-underline-offset:3px; }
  .version-links .version-status { color:var(--down); font-weight:600; }
  .version-rating-note { margin:0 0 4px; color:var(--muted); font-size:13px; line-height:1.45; }
