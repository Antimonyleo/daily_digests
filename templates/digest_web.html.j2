{% extends "_base.html.j2" %}
{% block title %}DailyDigest {{ digest_id }}{% endblock %}
{% block extra_styles %}
  .wrap { max-width: 1040px; padding: 22px 14px 78px; }
  .reading-progress {
    position: fixed; inset: 0 0 auto; z-index: 70; height: 4px;
    background: var(--border-soft); pointer-events: none;
  }
  .reading-progress.empty { display: none; }
  .reading-progress-fill {
    width: 100%; height: 100%; transform: scaleX(0); transform-origin: left;
    background: linear-gradient(90deg, var(--accent), var(--gold));
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 38%, transparent);
  }
  .reading-progress-leaf {
    position: absolute; top: 4px; left: 0; width: 8px; height: 5px;
    border-radius: 8px 2px 8px 2px; background: var(--gold);
    opacity: 0; transform: translateX(-50%) rotate(-24deg);
  }
  .reading-progress.active .reading-progress-leaf { opacity: 1; }
  .topbar {
    display: grid; grid-template-columns: 1fr auto; gap: 20px;
    align-items: center; margin-bottom: 14px;
  }
  .eyebrow {
    color: var(--accent); font-size: 12px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px;
  }
	  h1 {
	    font-size: clamp(28px, 4vw, 44px); line-height: 1.05;
	    margin: 0; letter-spacing: 0; overflow-wrap: anywhere;
	  }
  .subhead {
    margin: 10px 0 0; color: var(--muted); max-width: 620px;
    font-size: 15px; line-height: 1.55;
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 8px; }
  .compact-brew-form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0; }
  .compact-brew {
    display: flex; align-items: center; gap: 7px; min-height: 38px; padding: 5px 6px 5px 10px;
    border: 1px solid var(--border); border-radius: 8px; background: var(--card);
    color: var(--muted); font-size: 11px; font-weight: 760;
  }
  .compact-brew select {
    min-height: 27px; border: 0; border-radius: 6px; background: var(--panel);
    color: var(--text); font-size: 12px; font-weight: 720; cursor: pointer;
  }
  .tea-break {
    display: grid; grid-template-columns: 72px minmax(0, 1fr); align-items: center;
    gap: 12px; margin: 0 0 12px; padding: 10px 12px;
    border: 1px solid var(--border); border-radius: 14px;
    background: linear-gradient(115deg, var(--accent-soft), var(--panel) 44%, var(--gold-soft));
    color: var(--copy-secondary); font-size: 13px; line-height: 1.45;
    box-shadow: 0 10px 28px rgba(21, 34, 27, 0.05);
  }
  .pip-stage {
    position: relative; width: 68px; height: 68px; justify-self: center;
  }
  .tea-pet {
    --pet-look-x: 0px; --pet-look-y: 0px; --pet-tilt: 0deg;
    position: absolute; inset: auto 0 0; width: 64px; height: 62px; touch-action: none;
    cursor: grab; outline: none;
  }
  .tea-pet:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 12px; }
  .pet-steam {
    position: absolute; top: 0; width: 7px; height: 17px;
    border-left: 2px solid var(--accent); border-radius: 50%; opacity: 0;
  }
  .pet-steam.one { left: 23px; }
  .pet-steam.two { left: 37px; animation-delay: 0.28s; }
  .pet-cup {
    position: absolute; left: 8px; bottom: 7px; width: 44px; height: 33px;
    border: 2px solid var(--accent-strong); border-radius: 5px 5px 14px 14px;
    background: var(--card); box-shadow: inset 0 -7px 0 var(--accent-soft);
    transform: rotate(var(--pet-tilt));
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .pet-cup::after {
    content: ""; position: absolute; right: -13px; top: 6px; width: 13px; height: 15px;
    border: 2px solid var(--accent-strong); border-left: 0; border-radius: 0 9px 9px 0;
  }
  .pet-eye {
    position: absolute; top: 10px; width: 3px; height: 5px;
    border-radius: 50%; background: var(--accent-strong);
    transform: translate(var(--pet-look-x), var(--pet-look-y));
    transition: transform 0.12s ease;
  }
  .pet-eye.left { left: 13px; }
  .pet-eye.right { right: 13px; }
  .pet-mouth {
    position: absolute; left: 20px; top: 19px; width: 7px; height: 4px;
    border: 1.5px solid var(--accent-strong); border-top: 0; border-radius: 0 0 7px 7px;
  }
  .pip-drag-copy { display: none; }
  .tea-break.is-dragging .tea-break-copy { display: none; }
  .tea-break.is-dragging .pip-drag-copy { display: block; }
  .tea-break.is-dragging .tea-pet { cursor: grabbing; }
  .tea-break.is-dragging .pet-cup {
    transform: translateY(-10px) rotate(-7deg);
    box-shadow: inset 0 -7px 0 var(--accent-soft), 0 12px 18px rgba(21, 34, 27, 0.18);
  }
  .tea-break.is-dragging .pet-eye { width: 4px; height: 6px; top: 7px; }
  .tea-break.is-dragging .pet-mouth {
    left: 20px; top: 18px; width: 6px; height: 6px;
    border: 1.5px solid var(--accent-strong); border-radius: 50%;
  }
  .tea-break[data-note-kind="fact"] .pet-mouth { height: 2px; border-width: 0 0 1.5px; border-radius: 0; }
  .pet-saucer {
    position: absolute; left: 5px; bottom: 2px; width: 56px; height: 8px;
    border: 2px solid var(--accent-strong); border-top: 0; border-radius: 0 0 50% 50%;
  }
  .tea-dialog {
    position: relative; min-width: 0; padding: 8px 11px 9px;
    border: 1px solid var(--border); border-radius: 10px; background: var(--card);
    background: color-mix(in srgb, var(--card) 91%, transparent);
  }
  .tea-dialog::before {
    content: ""; position: absolute; left: -7px; top: 20px; width: 12px; height: 12px;
    border-left: 1px solid var(--border); border-bottom: 1px solid var(--border);
    background: var(--card); transform: rotate(45deg);
  }
  .tea-leaf-count {
    position: absolute; right: -3px; bottom: -4px; z-index: 5;
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 29px; min-height: 18px; padding: 0 4px;
    border: 1px solid var(--border); border-radius: 999px; background: var(--card);
    color: var(--muted); font-size: 9px; font-weight: 800; white-space: nowrap;
  }
  .tea-break-copy { display: block; min-width: 0; }
  .tea-leaf-drop {
    position: absolute; left: 27px; top: -8px; z-index: 6;
    width: 34px; height: 34px; padding: 0; border: 0; border-radius: 50%;
    background: transparent; color: var(--accent); cursor: pointer;
  }
  .tea-leaf-shape {
    position: absolute; left: 9px; top: 10px; width: 15px; height: 10px;
    border-radius: 14px 3px 14px 3px;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    box-shadow: 0 2px 5px rgba(21, 76, 56, 0.18);
    transform: rotate(-30deg); transform-origin: 70% 70%;
    transition: transform 0.24s ease, opacity 0.24s ease;
  }
  .tea-leaf-shape::after {
    content: ""; position: absolute; right: -4px; bottom: -1px;
    width: 7px; height: 1.5px; border-radius: 2px; background: var(--accent-strong);
    transform: rotate(28deg); transform-origin: left center;
  }
  .tea-leaf-drop:hover .tea-leaf-shape { transform: translateY(-2px) rotate(-20deg) scale(1.12); }
  .tea-leaf-drop:focus-visible { outline: 2px solid var(--accent); outline-offset: 0; }
  .tea-leaf-drop:disabled { cursor: default; }
  .tea-leaf-drop:disabled .tea-leaf-shape { opacity: 0; transform: translateY(24px) scale(0.6); }
  .pip-move {
    display: none; border: 0; padding: 2px 5px; border-radius: 999px; background: transparent;
    color: var(--muted); cursor: pointer; font-size: 10px; font-weight: 760;
  }
  .pip-move:hover { color: var(--accent-strong); background: var(--accent-soft); }
  .pip-move:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  @keyframes pet-steam-rise {
    0% { opacity: 0; transform: translateY(5px) scaleX(0.8); }
    35% { opacity: 0.7; }
    100% { opacity: 0; transform: translateY(-7px) translateX(2px) scaleX(1.1); }
  }
  @keyframes pet-hop {
    0%, 100% { transform: translateY(0) rotate(0); }
    45% { transform: translateY(-4px) rotate(-2deg); }
  }
  @keyframes note-pop {
    0% { box-shadow: 0 0 0 rgba(37, 111, 82, 0); }
    50% { box-shadow: 0 0 0 3px var(--accent-soft); }
    100% { box-shadow: 0 0 0 rgba(37, 111, 82, 0); }
  }
  @keyframes leaf-drop {
    0% { opacity: 1; transform: translate(0, 0) rotate(-30deg) scale(1); }
    65% { opacity: 1; transform: translate(-8px, 25px) rotate(24deg) scale(0.86); }
    100% { opacity: 0; transform: translate(-9px, 34px) rotate(52deg) scale(0.58); }
  }
  /* The replacement leaf unfurls instead of popping into place, after a short
     beat with an empty stem — otherwise the drop reads as a stutter, not a fall. */
  @keyframes leaf-regrow {
    0% { opacity: 0; transform: translate(2px, -5px) rotate(-72deg) scale(0.35); }
    55% { opacity: 1; transform: translate(0, 1px) rotate(-18deg) scale(1.08); }
    100% { opacity: 1; transform: translate(0, 0) rotate(-30deg) scale(1); }
  }
  @keyframes pet-land {
    0% { transform: translateY(-7px) scale(1.04); }
    55% { transform: translateY(2px) scale(0.98); }
    100% { transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .pet-steam { animation: pet-steam-rise 1.9s ease-out 2 both; }
    .tea-break.is-changing .pet-cup { animation: pet-hop 0.46s ease-out 1; }
    .tea-break.is-changing .tea-dialog { animation: note-pop 0.46s ease-out 1; }
    /* `forwards` holds the leaf gone through the pause; `backwards` starts the
       regrow from its own first frame so there is no flash of a full leaf. */
    .tea-break.is-changing .tea-leaf-shape { animation: leaf-drop 0.62s ease-in 1 forwards; }
    .tea-break.is-regrowing .tea-leaf-shape { animation: leaf-regrow 0.46s cubic-bezier(0.22, 1, 0.36, 1) 1 backwards; }
    .tea-break.is-dropping .tea-pet { animation: pet-land 0.42s ease-out 1; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tea-pet:hover .pet-cup {
      transform: translateY(-2px) rotate(var(--pet-tilt));
      box-shadow: inset 0 -7px 0 var(--accent-soft), 0 4px 8px rgba(21, 34, 27, 0.12);
    }
    .tea-pet:hover .pet-steam { animation: pet-steam-rise 1.15s ease-out 1 both; }
  }
  .brew-choice {
    display: grid; grid-template-columns: minmax(150px, 0.65fr) minmax(0, 2fr) auto;
    align-items: center; gap: 14px; margin: 0 0 16px; padding: 14px 16px;
    border: 1px solid var(--border); border-radius: 12px; background: var(--card);
    box-shadow: 0 8px 24px rgba(21, 34, 27, 0.04);
  }
  .brew-choice-title { font-size: 14px; font-weight: 810; }
  .brew-choice-hint { color: var(--muted); font-size: 11px; margin-top: 3px; }
  .density-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; }
  .density-option { position: relative; }
  .density-option input { position: absolute; opacity: 0; pointer-events: none; }
  .density-card {
    display: grid; gap: 2px; min-height: 54px; padding: 8px 10px;
    border: 1px solid var(--border); border-radius: 9px; background: var(--panel);
    cursor: pointer;
  }
  .density-card strong { font-size: 12px; }
  .density-card span { color: var(--muted); font-size: 10px; line-height: 1.3; }
  .density-option input:checked + .density-card {
    border-color: var(--accent); background: var(--accent-soft);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .density-option input:focus-visible + .density-card { outline: 2px solid var(--accent); outline-offset: 2px; }
  .name-prompt {
    display: grid; grid-template-columns: 1fr auto; gap: 10px;
    padding: 14px; margin-bottom: 16px; border: 1px solid var(--border);
    border-radius: 8px; background: var(--accent-soft);
  }
  .name-prompt label { display: block; font-size: 12px; font-weight: 800; color: var(--accent-strong); margin-bottom: 5px; }
  .name-prompt input {
    width: 100%; min-height: 38px; padding: 8px 10px;
    border: 1px solid var(--border); border-radius: 8px; background: var(--card);
  }
  .today-cup {
    display: grid; grid-template-columns: minmax(150px, 0.7fr) minmax(0, 2fr);
    gap: 18px; align-items: center; margin: 0 0 12px; padding: 14px 18px;
    border: 1px solid var(--border); border-radius: 12px;
    background: linear-gradient(135deg, #f7fbf8, var(--accent-soft));
  }
  .cup-kicker {
    color: var(--accent-strong); font-size: 11px; font-weight: 820;
    letter-spacing: 0.09em; text-transform: uppercase;
  }
  .cup-time { margin-top: 4px; font-size: 27px; font-weight: 840; line-height: 1.1; }
  .cup-label { color: var(--muted); font-size: 12px; margin-top: 4px; }
  .cup-details { display: grid; gap: 9px; }
  .cup-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .cup-row-label { color: var(--muted); font-size: 11px; font-weight: 800; min-width: 58px; text-transform: uppercase; letter-spacing: 0.05em; }
  .cup-chip {
    display: inline-flex; align-items: center; min-height: 25px; padding: 4px 8px;
    border: 1px solid var(--border); border-radius: 999px; background: rgba(255,255,255,0.75);
    color: var(--copy-secondary); font-size: 11px; font-weight: 720;
  }
  .catch-up {
    border-top: 1px solid var(--border); padding-top: 8px;
  }
  .catch-up summary { cursor: pointer; color: var(--accent-strong); font-size: 12px; font-weight: 780; }
  .catch-up-body { margin-top: 8px; white-space: pre-wrap; color: var(--copy-secondary); font-size: 13px; line-height: 1.55; }
  .source-mix, .audit-panel { border: 1px solid var(--border); border-radius: 8px; padding: 14px; }
  .panel-title {
    margin: 0 0 10px; font-size: 13px; color: var(--text);
    font-weight: 820; letter-spacing: 0.02em;
  }
  .mix-row {
    display: grid; grid-template-columns: minmax(110px, 190px) 1fr auto;
    align-items: center; gap: 8px; margin: 7px 0; font-size: 12px;
  }
  .mix-track {
    height: 8px; background: var(--surface-muted); border-radius: 999px; overflow: hidden;
  }
  .mix-fill { height: 100%; background: #5b8f73; border-radius: 999px; }
  .audit-summary { color: var(--muted); font-size: 13px; line-height: 1.45; margin: 0 0 8px; }
  .audit-panel summary {
    cursor: pointer; display: flex; align-items: center; justify-content: space-between;
    gap: 10px; font-size: 13px; color: var(--text); font-weight: 820;
    letter-spacing: 0.02em; list-style: none;
  }
  .audit-panel summary::-webkit-details-marker { display: none; }
  .audit-panel summary::after { content: "+"; color: var(--muted); font-size: 16px; }
  .audit-panel[open] summary::after { content: "-"; }
  .audit-body { margin-top: 10px; }
  .audit-list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .audit-list li { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: start; font-size: 12px; }
  .audit-list a { color: var(--text); text-decoration: none; font-weight: 720; overflow-wrap: anywhere; }
  .audit-list a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .audit-score { color: var(--muted); white-space: nowrap; }
  .audit-metrics { display: flex; flex-wrap: wrap; gap: 7px; margin: 0 0 10px; }
  .audit-metric {
    display: inline-flex; gap: 5px; align-items: baseline; padding: 6px 8px;
    border: 1px solid var(--border); border-radius: 999px; background: var(--panel);
    color: var(--muted); font-size: 12px;
  }
  .audit-metric strong { color: var(--text); font-size: 13px; }
  .digest-card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; box-shadow: var(--shadow); overflow: hidden; }
  .digest-toolbar {
    padding: 12px 16px; background: var(--panel); border-bottom: 1px solid var(--border);
  }
	  .digest-date { font-weight: 750; overflow-wrap: anywhere; }
	  .feedback-note { color: var(--muted); font-size: 13px; line-height: 1.45; max-width: 620px; }
  .ranking-panel {
    display: grid; gap: 8px; padding: 14px;
    border: 1px solid var(--border); border-radius: 8px; background: var(--panel);
  }
  .ranking-kicker {
    color: var(--muted); font-size: 11px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ranking-counts { display: flex; flex-wrap: wrap; gap: 6px; }
  .count-pill {
    display: inline-flex; align-items: center; gap: 4px;
    min-height: 26px; padding: 3px 8px; border-radius: 999px;
    background: var(--surface-muted); color: var(--text); font-size: 12px; font-weight: 750;
  }
  .count-pill.good { background: #e4f4eb; color: var(--up); }
  .count-pill.bad { background: #fdecea; color: var(--down); }
  .ranking-message { color: var(--muted); font-size: 12px; line-height: 1.4; }
  .ranking-panel .btn { justify-self: start; }
  .ranking-panel .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .reader-tools {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border);
    background: var(--card);
  }
  .reader-tools-side { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 10px; }
  .more-filters { position: relative; }
  .more-filters summary {
    cursor: pointer; list-style: none; min-height: 30px; padding: 5px 10px;
    border: 1px solid var(--border); border-radius: 999px; background: var(--panel);
    color: var(--text); font-size: 12px; font-weight: 720;
  }
  .more-filters summary::-webkit-details-marker { display: none; }
  .more-filters[open] summary { border-color: #9fc2ae; color: var(--accent-strong); }
  .more-filters .tool-group { margin-top: 7px; justify-content: flex-end; }
  .tool-group { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .filter-chip {
    border: 1px solid var(--border); border-radius: 999px; background: var(--panel);
    color: var(--text); min-height: 30px; padding: 5px 10px; font-size: 12px;
    font-weight: 720; cursor: pointer;
  }
  .filter-chip:hover { background: #f0f5f1; border-color: #bfd0c5; }
  .filter-chip.active {
    background: var(--accent-soft); border-color: #9fc2ae; color: var(--accent-strong);
  }
  .filter-count { color: var(--muted); font-size: 12px; }
  .section-toggle {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 18px; border-top: 1px solid var(--border-soft);
    background: var(--card); cursor: pointer; list-style: none;
  }
  .section-toggle::-webkit-details-marker { display: none; }
  .section-toggle:hover { background: var(--surface-hover); }
  .section-heading { display: flex; align-items: center; gap: 7px; font-size: 17px; font-weight: 780; }
  .section-toggle-side { display: flex; align-items: center; gap: 9px; }
  .section-chevron { color: var(--muted); font-size: 16px; transition: transform 0.16s ease; }
  .section-block[open] .section-chevron { transform: rotate(180deg); }
  .section-count {
    font-size: 12px; color: var(--muted); font-weight: 650;
    background: var(--surface-muted); border-radius: 999px; padding: 4px 9px;
  }
  .item {
    padding: 16px 20px; border-top: 1px solid var(--border-soft);
  }
  .item-main { width: 100%; }
  .item[data-priority="spotlight"] { border-left: 4px solid var(--gold); }
  .item[data-priority="read"] { border-left: 4px solid var(--accent); }
  .item[data-priority="skim"] { border-left: 4px solid var(--border); }
  .item:first-of-type { border-top: none; }
  .item-head {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    align-items: start; gap: 12px;
  }
  .item-heading { min-width: 0; }
  .item-heading .type-label { margin-bottom: 7px; }
  .item-copy { min-width: 0; }
  .bookmark-btn {
    display: inline-flex; align-items: center; gap: 5px; min-height: 26px;
    margin-left: 0; padding: 3px 8px; border: 1px solid var(--border);
    border-radius: 999px; background: var(--card); color: var(--muted);
    font-size: 11px; font-weight: 760; white-space: nowrap; cursor: pointer;
  }
  .bookmark-btn:hover { color: var(--accent-strong); border-color: #9fc2ae; }
  .bookmark-btn.active { color: #7a4b00; border-color: #dcb86b; background: var(--gold-soft); }
  .bookmark-btn:disabled { opacity: 0.65; cursor: progress; }
  .item-head-actions { display: flex; align-items: start; gap: 6px; }
  .known-btn.active { color: var(--muted); border-color: var(--border); background: var(--panel); }
  .known-btn.active .known-label { text-decoration: line-through; }
  .type-label {
    display: inline-flex; align-items: center; min-height: 22px; padding: 3px 8px;
    border-radius: 999px; font-size: 11px; font-weight: 820;
    color: #6b5b1f; background: #f5efd6; border: 1px solid #e6dab0;
    text-transform: uppercase; letter-spacing: 0.03em;
  }
  .reason-line { max-width: 96ch; color: var(--muted); font-size: 12px; line-height: 1.4; margin: 5px 0 0; overflow-wrap: anywhere; }
  .item a.title-link {
    display: block; color: var(--text); text-decoration: none; font-weight: 720; font-size: 16px;
    line-height: 1.36; overflow-wrap: anywhere; word-break: normal;
  }
  .item a.title-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
	  .item .meta { font-size: 12px; color: var(--muted); margin: 6px 0 0; overflow-wrap: anywhere; }
	  .item .summary { max-width: 96ch; font-size: 14px; line-height: 1.62; margin: 10px 0 0; color: var(--copy-secondary); overflow-wrap: anywhere; }
    .opportunity-facts { margin-top: 9px; padding: 9px 11px; border-radius: 7px; background: var(--panel); color: var(--copy-secondary); font-size: 12px; line-height: 1.55; }
    .opportunity-note { color: var(--muted); }
  .summary-primary {
    display: grid; grid-template-columns: 92px 1fr; gap: 8px; margin: 10px 0 0; padding: 10px;
    border: 1px solid var(--border); border-radius: 8px; background: var(--panel);
  }
  .summary-field { display: grid; grid-template-columns: 92px 1fr; gap: 8px; }
  .summary-label { color: var(--accent-strong); font-size: 11px; font-weight: 840; text-transform: uppercase; letter-spacing: 0.04em; }
  .summary-text { max-width: 96ch; color: var(--copy-secondary); font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }
  .reason-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
  .reason-badge {
    display: inline-flex; align-items: center; min-height: 22px; padding: 3px 7px;
    border: 1px solid var(--border); border-radius: 999px; background: var(--panel);
    color: var(--copy-secondary); font-size: 11px; font-weight: 700;
  }
  .item-details {
    margin-top: 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--panel); overflow: hidden;
  }
  .item-details summary {
    cursor: pointer; padding: 8px 10px; font-size: 12px; font-weight: 820;
    color: var(--accent-strong);
  }
  .item-details-body { display: grid; gap: 8px; padding: 0 10px 10px; }
  .why-copy { max-width: 96ch; color: var(--copy-secondary); font-size: 12px; line-height: 1.45; }
  .signal-line { color: var(--muted); font-size: 11px; line-height: 1.45; }
  .save-state { margin-top: 8px; color: var(--muted); font-size: 12px; }
  .save-state:empty { display: none; }
  .save-state.saved { color: var(--up); }
  .save-state.error { color: var(--down); }
  .vote-panel {
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 10px 14px;
    margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border-soft);
  }
  .vote-title {
    font-size: 11px; color: var(--muted); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .vote-row { display: grid; grid-template-columns: repeat(4, minmax(82px, 1fr)); gap: 6px; }
  .reason-block { grid-column: 2; }
  .reason-prompt { margin-top: 9px; color: var(--muted); font-size: 11px; font-weight: 760; }
  .reason-chip-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
  .reason-chip {
    border: 1px solid var(--border); border-radius: 999px; background: var(--panel);
    color: var(--muted); min-height: 25px; padding: 3px 8px; font-size: 11px;
    cursor: pointer;
  }
  .reason-chip.active { color: var(--accent-strong); border-color: #9fc2ae; background: var(--accent-soft); }
  .reason-chip:disabled { opacity: 0.65; cursor: progress; }
  .vote-btn {
    min-height: 33px; padding: 6px 10px; border: 1px solid var(--border);
    border-radius: 7px; cursor: pointer; color: var(--muted);
    background: var(--panel); font-size: 12px; font-weight: 750; text-align: center;
  }
  .vote-label { display: block; font-weight: 780; line-height: 1.1; }
  .vote-help { display: none; }
  .vote-btn:hover { background: #f0f5f1; border-color: #bfd0c5; color: var(--text); }
  .vote-btn.active { position: relative; z-index: 1; }
  .vote-btn.active.must { background: var(--gold-soft); border-color: var(--gold); color: #7a4b00; }
  .vote-btn.active.good { background: #e4f4eb; border-color: var(--up); color: var(--up); }
  .vote-btn.active.neutral { background: var(--surface-muted); border-color: var(--neutral); color: var(--neutral); }
  .vote-btn.active.bad { background: #fdecea; border-color: var(--down); color: var(--down); }
  .vote-btn:disabled { opacity: 0.65; cursor: progress; }
  .item.flash { background: var(--flash); transition: background 0.4s; }
  .overflow-shelf {
    margin: 14px 0 4px; border: 1px dashed var(--border); border-radius: 12px;
    background: var(--panel); padding: 4px 14px;
  }
  .overflow-shelf summary {
    display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
    padding: 9px 0; cursor: pointer; font-weight: 760; color: var(--text);
  }
  .overflow-hint { color: var(--muted); font-size: 12px; font-weight: 500; }
  .overflow-note { color: var(--muted); font-size: 13px; line-height: 1.5; margin: 4px 0 10px; }
  .overflow-list { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 7px; }
  .overflow-row a { color: var(--text); font-size: 14px; font-weight: 640; text-decoration: none; }
  .overflow-row a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .overflow-meta { display: block; color: var(--muted); font-size: 12px; margin-top: 1px; }
  .overflow-votes { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
  .overflow-vote {
    border: 1px solid var(--border); border-radius: 999px; background: var(--card);
    color: var(--muted); padding: 2px 9px; font-size: 11px; font-weight: 720; cursor: pointer;
  }
  .overflow-vote:hover { color: var(--accent-strong); border-color: #9fc2ae; }
  .overflow-vote.active { color: var(--accent-strong); border-color: #9fc2ae; background: var(--accent-soft); }
  .overflow-vote:disabled { cursor: progress; opacity: 0.6; }
  .overflow-vote-state { color: var(--muted); font-size: 11px; }
  #overflow-save-btn { margin-bottom: 10px; }
  #overflow-save-btn:disabled { opacity: 0.7; cursor: default; }
  .no-filter-results {
    display: none; padding: 30px 22px; color: var(--muted); text-align: center;
    border-top: 1px solid var(--border-soft); font-size: 14px;
  }
  .empty { padding: 44px 22px; text-align: center; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .toast {
    position: fixed; right: 18px; bottom: 62px; z-index: 20;
    background: #16231c; color: #fff; border-radius: 8px; padding: 11px 13px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.18); font-size: 13px;
    transform: translateY(18px); opacity: 0; pointer-events: none;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  .about-brew {
    margin-top: 16px; border: 1px solid var(--border); border-radius: 10px;
    background: var(--card); overflow: hidden;
  }
  .about-brew > summary {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 14px 16px; cursor: pointer; list-style: none; font-size: 13px; font-weight: 800;
  }
  .about-brew > summary::-webkit-details-marker { display: none; }
  .about-brew > summary::after { content: "+"; color: var(--muted); font-size: 17px; }
  .about-brew[open] > summary::after { content: "−"; }
  .about-summary { margin-left: auto; color: var(--muted); font-size: 11px; font-weight: 650; }
  .about-body { display: grid; gap: 12px; padding: 0 14px 14px; }
  html[data-display="compact"] .topbar { margin-bottom: 8px; }
  html[data-display="compact"] .subhead { display: none; }
  html[data-display="compact"] .today-cup {
    grid-template-columns: minmax(190px, auto) minmax(0, 1fr); gap: 10px;
    padding: 8px 12px; margin-bottom: 8px;
  }
  html[data-display="compact"] .cup-kicker { display: none; }
  html[data-display="compact"] .cup-time { margin: 0; font-size: 17px; }
  html[data-display="compact"] .cup-label { margin-top: 1px; font-size: 11px; }
  html[data-display="compact"] .cup-details { gap: 4px; }
  html[data-display="compact"] .cup-row { gap: 4px; }
  html[data-display="compact"] .cup-chip { min-height: 21px; padding: 2px 6px; }
  html[data-display="compact"] .tea-break {
    grid-template-columns: 54px minmax(0, 1fr); gap: 8px; padding: 6px 8px; margin-bottom: 8px;
  }
  html[data-display="compact"] .pip-stage { width: 52px; height: 54px; }
  html[data-display="compact"] .tea-pet { transform: scale(0.82); transform-origin: bottom left; }
  html[data-display="compact"] .tea-dialog { padding: 6px 9px 7px; }
  html[data-display="compact"] .digest-toolbar { padding: 7px 12px; }
  html[data-display="compact"] .feedback-note { display: none; }
  html[data-display="compact"] .reader-tools { gap: 6px; padding: 6px 12px; }
  html[data-display="compact"] .filter-chip,
  html[data-display="compact"] .more-filters summary { min-height: 26px; padding: 3px 8px; }
  html[data-display="compact"] .section-toggle { padding: 8px 14px; }
  html[data-display="compact"] .section-heading { font-size: 15px; }
  html[data-display="compact"] .section-count { padding: 2px 7px; }
  html[data-display="compact"] .item { padding: 9px 14px; }
  html[data-display="compact"] .item-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 3px 8px; }
  html[data-display="compact"] .item-heading .type-label { margin: 0; }
  html[data-display="compact"] .item a.title-link { flex: 1 1 420px; font-size: 16px; line-height: 1.3; }
  html[data-display="compact"] .bookmark-label,
  html[data-display="compact"] .known-label { display: none; }
  html[data-display="compact"] .bookmark-btn { min-height: 24px; padding: 2px 6px; }
  html[data-display="compact"] .item .meta { margin-top: 3px; }
  html[data-display="compact"] .reason-line { display: none; }
  html[data-display="compact"] .item .summary,
  html[data-display="compact"] .summary-primary { margin-top: 5px; }
  html[data-display="compact"] .summary-primary { grid-template-columns: 72px 1fr; gap: 6px; padding: 7px 9px; }
  html[data-display="compact"] .summary-primary .summary-label { font-size: 10px; white-space: nowrap; }
  html[data-display="compact"] .item-details { margin-top: 5px; }
  html[data-display="compact"] .item-details summary { padding: 5px 8px; }
  html[data-display="compact"] .vote-panel {
    grid-template-columns: minmax(0, 1fr); gap: 5px; margin-top: 6px; padding-top: 6px;
  }
  html[data-display="compact"] .vote-title { display: none; }
  html[data-display="compact"] .vote-btn { min-height: 29px; padding: 4px 7px; font-size: 11px; }
  html[data-display="compact"] .reason-block { grid-column: 1; }
  @media (min-width: 1440px) {
    .tea-break,
    html[data-display="compact"] .tea-break {
      position: fixed; left: max(12px, calc(50% - 714px)); bottom: 18px; z-index: 35;
      width: 196px; margin: 0; padding: 0; grid-template-columns: 1fr; gap: 8px;
      border: 0; background: transparent; box-shadow: none;
    }
    .tea-dialog,
    html[data-display="compact"] .tea-dialog {
      order: 1; padding: 9px 10px 10px;
      box-shadow: 0 10px 28px rgba(21, 34, 27, 0.10);
    }
    .tea-dialog::before {
      left: calc(50% - 6px); top: auto; bottom: -7px;
      border-left: 0; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
    }
    .pip-stage,
    html[data-display="compact"] .pip-stage {
      order: 2; justify-self: center; width: 106px; height: 96px;
    }
    .tea-pet,
    html[data-display="compact"] .tea-pet {
      width: 94px; height: 88px; left: 6px;
      transform: none; transform-origin: center;
    }
    .tea-pet .pet-cup { left: 16px; bottom: 10px; width: 60px; height: 45px; border-width: 2.5px; }
    .tea-pet .pet-cup::after { right: -17px; top: 8px; width: 17px; height: 21px; border-width: 2.5px; border-left: 0; }
    .tea-pet .pet-eye { top: 14px; width: 4px; height: 6px; }
    .tea-pet .pet-eye.left { left: 17px; }
    .tea-pet .pet-eye.right { right: 17px; }
    .tea-pet .pet-mouth { left: 27px; top: 27px; width: 9px; height: 6px; }
    .tea-pet .pet-saucer { left: 10px; bottom: 3px; width: 75px; height: 10px; border-width: 2.5px; border-top: 0; }
    .tea-pet .pet-steam { top: 0; height: 22px; }
    .tea-pet .pet-steam.one { left: 34px; }
    .tea-pet .pet-steam.two { left: 52px; }
    .tea-leaf-drop { left: 39px; top: -5px; }
    .tea-leaf-count { right: 0; bottom: 0; }
    .pip-move { display: inline-flex; position: absolute; left: -29px; bottom: 8px; }
    .tea-break-copy { font-size: 12px; line-height: 1.45; }
  }
  html[data-theme="dark"] .today-cup {
    background: linear-gradient(135deg, var(--panel), var(--accent-soft));
    border-color: var(--border);
  }
  html[data-theme="dark"] .cup-chip { background: var(--card); border-color: var(--border); }
  html[data-theme="dark"] .bookmark-btn.active,
  html[data-theme="dark"] .vote-btn.active.must { color: var(--gold); }
  html[data-theme="dark"] .type-label,
  html[data-theme="dark"] .compact-brew select { color: var(--copy-secondary); background: var(--surface-muted); border-color: var(--border); }
  html[data-theme="dark"] .count-pill.good,
  html[data-theme="dark"] .vote-btn.active.good { background: var(--accent-soft); color: var(--up); }
  html[data-theme="dark"] .count-pill.bad,
  html[data-theme="dark"] .vote-btn.active.bad { background: var(--flash); color: var(--down); }
  html[data-theme="dark"] .filter-chip:hover,
  html[data-theme="dark"] .vote-btn:hover { background: var(--surface-hover); border-color: var(--accent); }
  @media (max-width: 760px) {
    .wrap { padding: 20px 12px 72px; }
    .topbar { grid-template-columns: 1fr; align-items: start; }
    .actions { justify-content: flex-start; }
    .mix-row { grid-template-columns: 1fr auto; }
    .mix-track { grid-column: 1 / -1; }
    .reader-tools { align-items: flex-start; flex-direction: column; }
    .reader-tools-side { justify-content: flex-start; }
    .summary-primary, .summary-field { grid-template-columns: 1fr; gap: 3px; }
    .audit-list li { grid-template-columns: 1fr; }
    .vote-panel { grid-template-columns: 1fr; }
    .vote-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reason-block { grid-column: 1; }
    .name-prompt { grid-template-columns: 1fr; }
    .today-cup { grid-template-columns: 1fr; }
    .brew-choice { grid-template-columns: 1fr; }
    .density-options { grid-template-columns: 1fr; }
    .tea-break { grid-template-columns: 60px minmax(0, 1fr); align-items: center; gap: 8px; padding: 8px; }
    .pip-stage { width: 58px; height: 62px; }
    .tea-pet { transform: scale(0.9); transform-origin: bottom left; }
    .item { padding: 16px; }
    .item-head { gap: 8px; }
    html[data-display="compact"] .today-cup { grid-template-columns: 1fr; }
    html[data-display="compact"] .item { padding: 9px 12px; }
  }
{% endblock %}
{% block body %}
  <div class="reading-progress{% if empty %} empty{% endif %}" id="reading-progress" role="progressbar" aria-label="Digest reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0% of digest read">
    <div class="reading-progress-fill" id="reading-progress-fill"></div>
    <span class="reading-progress-leaf" id="reading-progress-leaf" aria-hidden="true"></span>
  </div>
  <header class="topbar">
    <div>
      <div class="eyebrow">DailyDigest</div>
      <h1 id="page-salutation" data-profile-name="{{ profile_name | default('', true) }}">{{ salutation }}{% if profile_name %}, {{ profile_name }}{% endif %}</h1>
      <p class="subhead">Fresh research and the signals you chose, ranked against your profile.</p>
    </div>
    <div class="actions">
      {% if not empty %}
      <form class="compact-brew-form" action="/run" method="get">
        <input type="hidden" name="autostart" value="1">
        <label class="compact-brew" for="reading-mode-select">
          <span>Today’s serving</span>
          <select id="reading-mode-select" name="reading_mode" aria-label="Choose serving size">
            <option value="full">Energetic</option>
            <option value="usual" selected>Usual</option>
            <option value="minimal">Tired</option>
          </select>
        </label>
        <button class="btn primary" type="submit">Brew again</button>
      </form>
      {% endif %}
      <a class="btn" href="/saved">Saved reading</a>
      <button class="btn" onclick="window.location.href='/setup'" type="button">Settings</button>
    </div>
  </header>

  {% if empty %}
  <form class="brew-choice" action="/run" method="get" aria-labelledby="brew-choice-title">
    <input type="hidden" name="autostart" value="1">
    <div>
      <div class="brew-choice-title" id="brew-choice-title">How are we feeling today?</div>
      <div class="brew-choice-hint">Choose today’s serving size. Source collection stays the same.<br>Summaries: {{ summarizer_label }}</div>
    </div>
    <div class="density-options" role="radiogroup" aria-label="Serving size">
      <label class="density-option">
        <input name="reading_mode" type="radio" value="full">
        <span class="density-card"><strong>Energetic</strong><span>All qualified entries</span></span>
      </label>
      <label class="density-option">
        <input name="reading_mode" type="radio" value="usual" checked>
        <span class="density-card"><strong>Usual</strong><span>Up to 15 entries</span></span>
      </label>
      <label class="density-option">
        <input name="reading_mode" type="radio" value="minimal">
        <span class="density-card"><strong>Tired</strong><span>5 research + 1 per other section</span></span>
      </label>
    </div>
    <button class="btn primary" type="submit">Brew today’s digest</button>
  </form>
  {% endif %}

  {% if not profile_name %}
	  <form class="name-prompt" method="post" action="/profile/name">
	    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
	    <div>
      <label for="name">First name</label>
      <input id="name" name="name" type="text" autocomplete="given-name" placeholder="What should DailyDigest call you?">
    </div>
    <button class="btn primary" type="submit">Save</button>
  </form>
  {% endif %}

  {% if not empty %}
  <section class="today-cup" aria-label="Today’s cup">
    <div>
      <div class="cup-kicker">Today’s cup</div>
      <div class="cup-time">≈ {{ overview.reading_minutes }} minute digest</div>
      <div class="cup-label">{{ overview.selected }} carefully selected entries</div>
    </div>
    <div class="cup-details">
      {% if overview.topic_mix %}
      <div class="cup-row">
        <span class="cup-row-label">Themes</span>
        {% for topic in overview.topic_mix %}<span class="cup-chip">{{ topic.title }} · {{ topic.count }}</span>{% endfor %}
      </div>
      {% endif %}
      {% if catch_up_synthesis %}
      <details class="catch-up">
        <summary>Catch up on what you missed{% if catch_up_days %} over ~{{ catch_up_days }} days{% endif %}</summary>
        <div class="catch-up-body">{{ catch_up_synthesis }}</div>
      </details>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <section class="tea-break" id="tea-break" data-note-kind="{{ 'joke' if daily_note.startswith('Lab joke') else 'fact' }}" aria-label="Pip’s tea break">
    <div class="pip-stage">
      <button class="tea-leaf-drop" id="tea-another" type="button" aria-label="Drop a tea leaf into Pip’s cup for another science fact or joke" title="Drop a tea leaf into Pip’s cup">
        <span class="tea-leaf-shape" aria-hidden="true"></span>
      </button>
      <div class="tea-pet" id="tea-pet" role="button" tabindex="0" aria-label="Move Pip. Drag with a pointer, use arrow keys, or press Home to reset." aria-describedby="pip-move-help">
        <span class="pet-steam one"></span><span class="pet-steam two"></span>
        <span class="pet-cup"><span class="pet-eye left"></span><span class="pet-eye right"></span><span class="pet-mouth"></span></span>
        <span class="pet-saucer"></span>
      </div>
      <span class="tea-leaf-count" aria-label="Tea leaves given to Pip"><span id="tea-leaf-count">0</span>/10</span>
      <button class="pip-move" id="pip-move" type="button" aria-label="Move Pip to another preset position">Move</button>
    </div>
    <span class="sr-only" id="pip-move-help">Press Enter to cycle through preset positions. Arrow keys move Pip. Home returns Pip to the lower-left dock.</span>
    <div class="tea-dialog">
      <span class="tea-break-copy" id="tea-note-text" aria-live="polite">{{ daily_note }}</span>
      <span class="pip-drag-copy" aria-hidden="true">Easy—my tea is still hot!</span>
    </div>
  </section>

  <main class="digest-card">
    <div class="digest-toolbar">
      <div>
        <div class="digest-date">{{ digest_id }}</div>
	        <div class="feedback-note">Rate recommendations as you read; Relevant and Not for me improve future digests.</div>
      </div>
    </div>

    {% if not empty %}
    <div class="reader-tools" aria-label="Digest filters">
      <div class="tool-group" role="group" aria-label="Filter recommendations">
        <button class="filter-chip active" data-filter="all" type="button" aria-pressed="true">All</button>
        <button class="filter-chip" data-filter="priority" data-filter-group="status" data-filter-value="priority" type="button" aria-pressed="false">Priority</button>
        <button class="filter-chip" data-filter="unreviewed" data-filter-group="status" data-filter-value="unreviewed" type="button" aria-pressed="false">Unread</button>
      </div>
      <div class="reader-tools-side">
        <details class="more-filters">
          <summary>More filters</summary>
          <div class="tool-group" role="group" aria-label="Filter by source type">
            <button class="filter-chip" data-filter="published" data-filter-group="source" data-filter-value="published" type="button" aria-pressed="false">Published journals</button>
            <button class="filter-chip" data-filter="preprints" data-filter-group="source" data-filter-value="preprints" type="button" aria-pressed="false">Preprints</button>
            <button class="filter-chip" data-filter="ai-cs" data-filter-group="source" data-filter-value="ai-cs" type="button" aria-pressed="false">AI / CS</button>
          </div>
        </details>
        <div class="filter-count" id="filter-count">{{ overview.selected }} shown</div>
      </div>
    </div>
    {% endif %}

	    {% if empty %}
	    <div class="empty">
	      {% if brewed %}
	      A digest was brewed for today, but no matching items were found.<br>
	      Adjust section sizes or profile terms in Settings, then brew again.
	      {% else %}
	      No digest has been brewed for today yet.<br>
	      Use the brew button to fetch fresh sources and watch progress live.
	      {% endif %}
	    </div>
    {% else %}
      {% for section in sections %}
      <details class="section-block" data-section="{{ section.key }}"{% if loop.first %} open{% endif %}>
      <summary class="section-toggle">
        <span class="section-heading"><span aria-hidden="true">{{ section.emoji }}</span>{{ section.title }}</span>
        <span class="section-toggle-side"><span class="section-count">{{ section.entries|length }}</span><span class="section-chevron" aria-hidden="true">⌄</span></span>
      </summary>
      {% for item in section.entries %}
      {% set priority_score = item.confidence_score | default(item.score_raw) %}
      {% set priority = 'spotlight' if priority_score >= 0.85 else ('read' if priority_score >= 0.65 else 'skim') %}
      <div class="item" data-item-id="{{ item.id }}" data-section="{{ section.key }}" data-priority="{{ priority }}" data-source-bucket="{{ item.ranking.source_bucket }}" data-reviewed="{{ 'true' if item.current_grade is not none else 'false' }}" data-current-grade="{{ item.current_grade if item.current_grade is not none else '' }}" data-bookmarked="{{ 'true' if item.bookmarked else 'false' }}" data-known="{{ 'true' if item.known else 'false' }}">
        <div class="item-main">
          <div class="item-head">
            <div class="item-heading">
              {% if item.type_label %}
              <span class="type-label">{{ item.type_label }}</span>
              {% endif %}
              <a class="title-link" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
            </div>
            <div class="item-head-actions">
              <button class="bookmark-btn{% if item.bookmarked %} active{% endif %}" type="button" aria-pressed="{{ 'true' if item.bookmarked else 'false' }}" aria-label="{{ 'Remove from saved items' if item.bookmarked else 'Save for later' }}">
                <span class="bookmark-icon" aria-hidden="true">{{ '★' if item.bookmarked else '☆' }}</span>
                <span class="bookmark-label">{{ 'Saved' if item.bookmarked else 'Save' }}</span>
              </button>
              {% if section.key in ("opportunities", "events") %}
              {# Funding calls stay open for weeks and are re-shown whenever their
                 official details change, so only an explicit "I know this" can
                 retire one. Nothing automatic ever sets this flag. #}
              <button class="bookmark-btn known-btn{% if item.known %} active{% endif %}" type="button" aria-pressed="{{ 'true' if item.known else 'false' }}" aria-label="{{ 'Show this again in future digests' if item.known else 'Mark as known so it stops appearing' }}">
                <span class="known-icon" aria-hidden="true">{{ '✓' if item.known else '⊘' }}</span>
                <span class="known-label">{{ 'Known' if item.known else 'Mark known' }}</span>
              </button>
              {% endif %}
            </div>
          </div>
          <div class="item-copy">
          <div class="meta">
            {{ item.source }}{% if item.published %} &middot; {{ item.published }}{% endif %}
          </div>
          {% if item.opportunity %}
          <div class="opportunity-facts">
            {% if section.key == "events" %}
            <strong>Date:</strong> {{ item.opportunity.event_dates or "Not stated" }}
            &middot; <strong>Location:</strong> {{ item.opportunity.location }}
            {% if item.opportunity.format %}&middot; {{ item.opportunity.format }}{% endif %}<br>
            {% else %}
            <strong>Amount:</strong> {{ item.opportunity.amount }}<br>
            {% endif %}
            <strong>Deadline:</strong> {{ item.opportunity.deadline }}
            &middot; {{ item.opportunity.status }}
            &middot; {{ item.opportunity.eligibility }}<br>
            <span class="opportunity-note">{{ item.opportunity.official }} &middot; {{ item.opportunity.eligibility_reason }}</span>
            &middot; <a href="{{ item.opportunity.calendar_url }}">Add to calendar</a>
          </div>
          {% endif %}
          {% if item.reason_line %}
          <div class="reason-line">{{ item.reason_line }}</div>
          {% endif %}
          {% if item.summary_fields.get('Key finding') %}
          <div class="summary-primary" aria-label="Key finding for {{ item.label }}">
            <div class="summary-label">Key finding</div>
            <div class="summary-text">{{ item.summary_fields.get('Key finding') }}</div>
          </div>
          {% elif item.summary %}
          <div class="summary">{{ item.summary }}</div>
          {% endif %}
          <details class="item-details">
            <summary>Details</summary>
            <div class="item-details-body">
              {% if item.summary_fields %}
                {% for label, text in item.summary_fields.items() %}
                  {% if label != 'Key finding' %}
                  <div class="summary-field">
                    <div class="summary-label">{{ label }}</div>
                    <div class="summary-text">{{ text }}</div>
                  </div>
                  {% endif %}
                {% endfor %}
              {% endif %}
              <div class="why-copy"><strong>Why this recommendation?</strong>
                {% if item.ranking.why_shown %}
                {{ item.ranking.why_shown | join('; ') }}.
                {% else %}
                Selected because it looks relevant to your profile and carries useful editorial signals for today’s read.
                {% endif %}
                {% if item.ranking.selection_reason %}
                {{ item.ranking.selection_reason | capitalize }}.
                {% endif %}
              </div>
              {% if item.ranking.tags %}<div class="signal-line">{{ item.ranking.tags | join(' · ') }}</div>{% endif %}
            </div>
          </details>
          <div class="save-state{% if item.current_grade is not none %} saved{% endif %}" aria-live="polite">
            {% if item.current_grade == 100 %}
            Must read saved.
            {% elif item.current_grade == 70 %}
            Relevant saved.
            {% elif item.current_grade == 40 %}
            Hmmm saved.
            {% elif item.current_grade == 10 %}
            Not for me saved.
            {% endif %}
          </div>
          </div>
        </div>
        <div class="vote-panel">
          <div class="vote-title">Your read</div>
          <div class="vote-row" role="group" aria-label="Evaluate {{ item.label }}">
            <button class="vote-btn must{% if item.current_grade == 100 %} active{% endif %}"
                    data-grade="100" type="button" aria-pressed="{{ 'true' if item.current_grade == 100 else 'false' }}">
              <span class="vote-label">Must read</span>
            </button>
            <button class="vote-btn good{% if item.current_grade == 70 %} active{% endif %}"
                    data-grade="70" type="button" aria-pressed="{{ 'true' if item.current_grade == 70 else 'false' }}">
              <span class="vote-label">Relevant</span>
            </button>
            <button class="vote-btn neutral{% if item.current_grade == 40 %} active{% endif %}"
                    data-grade="40" type="button" aria-pressed="{{ 'true' if item.current_grade == 40 else 'false' }}">
              <span class="vote-label">Hmmm</span>
            </button>
            <button class="vote-btn bad{% if item.current_grade == 10 %} active{% endif %}"
                    data-grade="10" type="button" aria-pressed="{{ 'true' if item.current_grade == 10 else 'false' }}">
              <span class="vote-label">Not for me</span>
            </button>
          </div>
          <div class="reason-block"{% if not (item.current_grade in [40, 10]) %} hidden{% endif %}>
          <div class="reason-prompt">Why? (optional)</div>
          <div class="reason-chip-row" role="group" aria-label="Feedback reason for {{ item.label }}">
            <button class="reason-chip{% if 'off_topic' in item.current_reasons %} active{% endif %}" data-reason="off_topic" type="button" aria-pressed="{{ 'true' if 'off_topic' in item.current_reasons else 'false' }}">Off topic</button>
            <button class="reason-chip{% if 'low_impact' in item.current_reasons %} active{% endif %}" data-reason="low_impact" type="button" aria-pressed="{{ 'true' if 'low_impact' in item.current_reasons else 'false' }}">Low impact</button>
            <button class="reason-chip{% if 'promotional' in item.current_reasons %} active{% endif %}" data-reason="promotional" type="button" aria-pressed="{{ 'true' if 'promotional' in item.current_reasons else 'false' }}">Too promotional</button>
            <button class="reason-chip{% if 'access_friction' in item.current_reasons %} active{% endif %}" data-reason="access_friction" type="button" aria-pressed="{{ 'true' if 'access_friction' in item.current_reasons else 'false' }}">Hard to access</button>
            <button class="reason-chip{% if 'duplicate' in item.current_reasons %} active{% endif %}" data-reason="duplicate" type="button" aria-pressed="{{ 'true' if 'duplicate' in item.current_reasons else 'false' }}">Duplicate</button>
            <button class="reason-chip{% if 'not_urgent' in item.current_reasons %} active{% endif %}" data-reason="not_urgent" type="button" aria-pressed="{{ 'true' if 'not_urgent' in item.current_reasons else 'false' }}">Not urgent</button>
          </div>
          </div>
        </div>
      </div>
      {% endfor %}
      </details>
      {% endfor %}
      <div class="no-filter-results" id="no-filter-results">No items match this view.</div>
    {% endif %}

    {% if overflow_audit %}
    <details class="overflow-shelf" id="overflow-shelf">
      <summary>
        <span>{{ overflow_audit|length }} more qualified pick{{ '' if overflow_audit|length == 1 else 's' }} didn’t fit today’s reading mode</span>
        <span class="overflow-hint">check them out, or run them again tomorrow</span>
      </summary>
      <div class="overflow-body">
        <p class="overflow-note">
          These cleared every relevance gate and lost their seat only to today’s
          serving size. Saving pins them for one more ranking pass against
          tomorrow’s fresh papers.
        </p>
        <ul class="overflow-list">
          {% for entry in overflow_audit %}
          <li class="overflow-row" data-item-id="{{ entry.item_id }}">
            <a href="{{ entry.url }}" target="_blank" rel="noopener">{{ entry.title }}</a>
            <span class="overflow-meta">{{ entry.source }}{% if entry.section %} · {{ entry.section }}{% endif %} · relevance {{ '%.2f'|format(entry.topic_score | default(0.0) | float) }}</span>
            {# Rating a near-miss is the scarcest training signal there is: these
               sit exactly on the cutoff the ranker keeps getting wrong. A negative
               grade retires the item (store.exclude_reviewed_items). A positive one
               keeps it ELIGIBLE but cannot bring it back on its own — its
               publication date has usually left the candidate window — so the
               handler also pins it, exactly as "Save all for tomorrow" would. #}
            <span class="overflow-votes" role="group" aria-label="Rate {{ entry.title }}">
              <button class="overflow-vote" data-grade="100" type="button">Must read</button>
              <button class="overflow-vote" data-grade="70" type="button">Relevant</button>
              <button class="overflow-vote" data-grade="40" type="button">Hmmm</button>
              <button class="overflow-vote" data-grade="10" type="button">Not for me</button>
              <span class="overflow-vote-state" aria-live="polite"></span>
            </span>
          </li>
          {% endfor %}
        </ul>
        <button class="btn primary" id="overflow-save-btn" type="button"{% if overflow_saved %} disabled{% endif %}>
          {{ 'Saved for tomorrow ✓' if overflow_saved else 'Save all for tomorrow' }}
        </button>
      </div>
    </details>
    {% endif %}

    <div class="footer">
      Local UI &middot; votes write to <code>data/digest.db</code>.
    </div>
  </main>

  {% if not empty or overview.source_mix or top_journal_audit or candidate_funnel %}
  <details class="about-brew">
    <summary>
      <span>About this brew</span>
      <span class="about-summary">{{ summarizer_label }} · personalization and diagnostics</span>
    </summary>
    <div class="about-body">
    <section class="ranking-panel" aria-live="polite">
      <div class="ranking-kicker">Personalization</div>
      <div class="ranking-counts">
        <span class="count-pill good">Relevant <span id="vote-good">{{ ranking_status.vote_counts.good }}</span></span>
        <span class="count-pill bad">Not for me <span id="vote-bad">{{ ranking_status.vote_counts.bad }}</span></span>
        <span class="count-pill">Helpful ratings <span id="vote-signed">{{ ranking_status.vote_counts.signed }}</span>/<span id="vote-threshold">{{ ranking_status.min_votes_for_lr }}</span></span>
      </div>
      <div class="ranking-message" id="ranking-message">
        {% if ranking_status.ranking_status == "preference_active" %}
        Personal ranking is active — every rating sharpens the next brew automatically.
        {% else %}
        {{ ranking_status.remaining_votes_for_lr }} more ratings unlock personal ranking.
        {% endif %}
      </div>
      <button class="btn primary" id="train-ranker-btn" type="button"{% if not ranking_status.can_train %} disabled{% endif %}>Refresh calibration</button>
    </section>
    {% if overview.source_mix %}
    <div class="source-mix">
      <h2 class="panel-title">Today’s source mix</h2>
      {% for source, count in overview.source_mix %}
      <div class="mix-row">
        <span>{{ source }}</span>
        <div class="mix-track"><div class="mix-fill" style="width: {{ (count * 100 / overview.selected) | round(0, 'floor') if overview.selected else 0 }}%;"></div></div>
        <span>{{ count }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if top_journal_audit %}
    <details class="audit-panel diagnostic-drawer">
      <summary>Not shown today</summary>
      <div class="audit-body">
        <p class="audit-summary">{{ overview.top_journals_shown }} published-journal picks shown. {{ top_journal_audit|length }} high-quality candidates were considered but did not make today’s shown list.</p>
        <ul class="audit-list">
          {% for audit in top_journal_audit[:5] %}
          <li>
            <a href="{{ audit.url | default('#') }}" target="_blank" rel="noopener">{{ audit.title }}</a>
            <span class="audit-score">{{ audit.source }} · {{ audit.score }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
    </details>
    {% endif %}

    {% if candidate_funnel %}
    <details class="audit-panel diagnostic-drawer">
      <summary>Brew diagnostics</summary>
      <div class="audit-body">
        <p class="audit-summary">Candidate flow from recent source items through reviewed-item filtering, quality gates, and cross-source dedupe.</p>
        <div class="audit-metrics">
          <span class="audit-metric"><strong>{{ candidate_funnel.recent_items | default(0) }}</strong> recent</span>
          <span class="audit-metric"><strong>{{ candidate_funnel.after_reviewed_filter | default(0) }}</strong> after reviewed filter</span>
          <span class="audit-metric"><strong>{{ candidate_funnel.after_previously_shown_filter | default(candidate_funnel.after_recently_dismissed_filter) | default(0) }}</strong> after previously-shown filter</span>
          <span class="audit-metric"><strong>{{ candidate_funnel.after_quality_gate | default(0) }}</strong> after quality gate</span>
          <span class="audit-metric"><strong>{{ candidate_funnel.after_cross_source_dedupe | default(0) }}</strong> after dedupe</span>
        </div>
        {% if candidate_funnel.quality_drop_reason_counts %}
        <ul class="audit-list">
          {% for row in candidate_funnel.quality_drop_reason_counts %}
          <li><span>{{ row.reason }}</span><span class="audit-score">{{ row.count }}</span></li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </details>
    {% endif %}
    </div>
  </details>
  {% endif %}

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
{% endblock %}
{% block scripts %}
<script>
(function () {
	  const GRADE_CLASS = { "100": "must", "70": "good", "40": "neutral", "10": "bad" };
	  const GRADE_LABEL = { "100": "Must read", "70": "Relevant", "40": "Hmmm", "10": "Not for me" };
	  const NEGATIVE_GRADES = new Set(["40", "10"]);
	  const CSRF_TOKEN = {{ csrf_token|tojson }};
  const TEA_NOTES = {{ daily_notes|tojson }};
  const toastEl = document.getElementById("toast");
  const trainBtn = document.getElementById("train-ranker-btn");
  let toastTimer = null;

  const displayButton = document.getElementById("display-toggle");
  if (displayButton) displayButton.hidden = false;

  const salutation = document.getElementById("page-salutation");
  if (salutation) {
    const hour = new Date().getHours();
    const greeting = hour < 5 ? "You’re up early" : hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
    const name = salutation.dataset.profileName || "";
    salutation.textContent = greeting + (name ? `, ${name}` : "");
  }

  const teaText = document.getElementById("tea-note-text");
  const teaButton = document.getElementById("tea-another");
  const teaBreak = document.getElementById("tea-break");
  const teaPet = document.getElementById("tea-pet");
  const pipMoveButton = document.getElementById("pip-move");
  const teaLeafCount = document.getElementById("tea-leaf-count");
  const teaLeafStorageKey = "dailydigest-tea-leaves:" + {{ digest_id|tojson }};
  const pipPositionStorageKey = "dailydigest-pip-position";
  const teaBreakOver = "Tea break over—time to read? I’ll keep your cup warm.";
  let teaLeaves = 0;
  try {
    const savedTeaLeaves = Number.parseInt(localStorage.getItem(teaLeafStorageKey) || "0", 10);
    teaLeaves = Number.isFinite(savedTeaLeaves) ? Math.max(0, Math.min(10, savedTeaLeaves)) : 0;
  } catch (_) {}
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const pipDock = window.matchMedia("(min-width: 1440px)");
  let pipDrag = null;
  let pipPresetIndex = 0;

  function syncTeaBreakState() {
    if (teaLeafCount) teaLeafCount.textContent = String(teaLeaves);
    if (!teaButton || !teaText || teaLeaves < 10) return;
    teaText.textContent = teaBreakOver;
    teaButton.setAttribute("aria-label", "Tea break complete after ten tea leaves");
    teaButton.setAttribute("title", "Tea break complete");
    teaButton.disabled = true;
    if (teaBreak) teaBreak.dataset.noteKind = "fact";
  }

  function clampPipPosition(x, y) {
    if (!teaBreak) return { x: 0, y: 0 };
    const width = teaBreak.offsetWidth;
    const height = teaBreak.offsetHeight;
    return {
      x: Math.max(8, Math.min(window.innerWidth - width - 8, x)),
      y: Math.max(8, Math.min(window.innerHeight - height - 8, y)),
    };
  }

  function setPipPosition(x, y, persist = true) {
    if (!teaBreak || !pipDock.matches) return;
    const point = clampPipPosition(x, y);
    teaBreak.style.left = `${Math.round(point.x)}px`;
    teaBreak.style.top = `${Math.round(point.y)}px`;
    teaBreak.style.bottom = "auto";
    if (persist) {
      try { localStorage.setItem(pipPositionStorageKey, JSON.stringify(point)); } catch (_) {}
    }
  }

  function resetPipPosition(clearSaved = true) {
    if (!teaBreak) return;
    teaBreak.style.removeProperty("left");
    teaBreak.style.removeProperty("top");
    teaBreak.style.removeProperty("bottom");
    if (clearSaved) {
      try { localStorage.removeItem(pipPositionStorageKey); } catch (_) {}
    }
  }

  function restorePipPosition() {
    if (!teaBreak || !pipDock.matches) {
      resetPipPosition(false);
      if (teaPet) teaPet.tabIndex = -1;
      return;
    }
    if (teaPet) teaPet.tabIndex = 0;
    try {
      const saved = JSON.parse(localStorage.getItem(pipPositionStorageKey) || "null");
      if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y)) {
        setPipPosition(saved.x, saved.y, false);
      }
    } catch (_) {}
  }

  function cyclePipPosition() {
    if (!teaBreak || !pipDock.matches) return;
    const rect = teaBreak.getBoundingClientRect();
    const sideGap = Math.max(12, window.innerWidth / 2 - 714);
    const presets = [
      { x: sideGap, y: window.innerHeight - rect.height - 18 },
      { x: sideGap, y: 72 },
      { x: window.innerWidth - sideGap - rect.width, y: 72 },
    ];
    pipPresetIndex = (pipPresetIndex + 1) % presets.length;
    setPipPosition(presets[pipPresetIndex].x, presets[pipPresetIndex].y);
  }

  function landPip() {
    if (!teaBreak) return;
    teaBreak.classList.remove("is-dragging");
    teaBreak.classList.remove("is-dropping");
    void teaBreak.offsetWidth;
    teaBreak.classList.add("is-dropping");
    window.setTimeout(() => teaBreak.classList.remove("is-dropping"), 460);
  }

  syncTeaBreakState();
  restorePipPosition();
  if (pipDock.addEventListener) pipDock.addEventListener("change", restorePipPosition);
  window.addEventListener("resize", restorePipPosition);

  if (pipMoveButton) pipMoveButton.addEventListener("click", cyclePipPosition);
  if (teaPet) {
    teaPet.addEventListener("pointerdown", (event) => {
      if (!pipDock.matches || event.button !== 0) return;
      const rect = teaBreak.getBoundingClientRect();
      pipDrag = {
        pointerId: event.pointerId,
        offsetX: event.clientX - rect.left,
        offsetY: event.clientY - rect.top,
      };
      teaPet.setPointerCapture(event.pointerId);
      teaBreak.classList.add("is-dragging");
      event.preventDefault();
    });
    teaPet.addEventListener("pointermove", (event) => {
      if (pipDrag && event.pointerId === pipDrag.pointerId) {
        setPipPosition(event.clientX - pipDrag.offsetX, event.clientY - pipDrag.offsetY, false);
        return;
      }
      if (!finePointer.matches || reducedMotion.matches) return;
      const box = teaPet.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((event.clientX - box.left) / box.width) * 2 - 1));
      const y = Math.max(-1, Math.min(1, ((event.clientY - box.top) / box.height) * 2 - 1));
      teaPet.style.setProperty("--pet-look-x", `${(x * 1.6).toFixed(2)}px`);
      teaPet.style.setProperty("--pet-look-y", `${(y * 1.2).toFixed(2)}px`);
      teaPet.style.setProperty("--pet-tilt", `${(x * 2.2).toFixed(2)}deg`);
    });
    teaPet.addEventListener("pointerleave", () => {
      if (pipDrag) return;
      teaPet.style.removeProperty("--pet-look-x");
      teaPet.style.removeProperty("--pet-look-y");
      teaPet.style.removeProperty("--pet-tilt");
    });
    const finishPipDrag = (event) => {
      if (!pipDrag || event.pointerId !== pipDrag.pointerId) return;
      const rect = teaBreak.getBoundingClientRect();
      setPipPosition(rect.left, rect.top);
      if (teaPet.hasPointerCapture(event.pointerId)) teaPet.releasePointerCapture(event.pointerId);
      pipDrag = null;
      landPip();
    };
    teaPet.addEventListener("pointerup", finishPipDrag);
    teaPet.addEventListener("pointercancel", finishPipDrag);
    teaPet.addEventListener("keydown", (event) => {
      if (!pipDock.matches) return;
      const rect = teaBreak.getBoundingClientRect();
      const movements = {
        ArrowLeft: [-18, 0], ArrowRight: [18, 0],
        ArrowUp: [0, -18], ArrowDown: [0, 18],
      };
      if (movements[event.key]) {
        event.preventDefault();
        setPipPosition(rect.left + movements[event.key][0], rect.top + movements[event.key][1]);
        landPip();
      } else if (event.key === "Home") {
        event.preventDefault();
        resetPipPosition();
        landPip();
      } else if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        cyclePipPosition();
        landPip();
      }
    });
  }
  let teaIndex = teaText ? TEA_NOTES.indexOf(teaText.textContent) : -1;
  // Leaf timings, in step with the leaf-drop / leaf-regrow keyframes. The pause
  // is the whole point: the old leaf must be gone for a beat before the next
  // one unfurls, or the fall reads as a flicker.
  const LEAF_FALL_MS = 620;
  const LEAF_PAUSE_MS = 220;
  const LEAF_REGROW_MS = 460;
  let leafTimer = null;
  let leafBusy = false;
  function runLeafCycle() {
    if (!teaBreak) return;
    // Nothing animates under reduced motion, so there is nothing to wait for.
    if (reducedMotion.matches) return;
    window.clearTimeout(leafTimer);
    leafBusy = true;
    teaBreak.classList.remove("is-changing", "is-regrowing");
    void teaBreak.offsetWidth;
    teaBreak.classList.add("is-changing");
    leafTimer = window.setTimeout(() => {
      // Swap both classes in one task so the leaf never renders at full opacity
      // between the fall and the regrow.
      teaBreak.classList.remove("is-changing");
      if (teaLeaves < 10) teaBreak.classList.add("is-regrowing");
      leafTimer = window.setTimeout(() => {
        teaBreak.classList.remove("is-regrowing");
        leafBusy = false;
      }, LEAF_REGROW_MS);
    }, LEAF_FALL_MS + LEAF_PAUSE_MS);
  }
  if (teaText && teaButton && TEA_NOTES.length > 1) {
    teaButton.addEventListener("click", () => {
      // Ignore clicks mid-fall: restarting the drop from an invisible leaf pops.
      if (teaLeaves >= 10 || leafBusy) return;
      teaLeaves = Math.min(10, teaLeaves + 1);
      if (teaLeafCount) teaLeafCount.textContent = String(teaLeaves);
      try { localStorage.setItem(teaLeafStorageKey, String(teaLeaves)); } catch (_) {}
      if (teaLeaves >= 10) {
        syncTeaBreakState();
      } else {
        teaIndex = (teaIndex + 1) % TEA_NOTES.length;
        teaText.textContent = TEA_NOTES[teaIndex];
      }
      if (teaBreak) {
        teaBreak.dataset.noteKind = teaText.textContent.startsWith("Lab joke") ? "joke" : "fact";
        runLeafCycle();
      }
    });
  }

  const progressBar = document.getElementById("reading-progress");
  const progressFill = document.getElementById("reading-progress-fill");
  const progressLeaf = document.getElementById("reading-progress-leaf");
  const digestCard = document.querySelector(".digest-card");
  let progressFrame = null;
  function updateReadingProgress() {
    progressFrame = null;
    if (!progressBar || !progressFill || !digestCard || progressBar.classList.contains("empty")) return;
    const rect = digestCard.getBoundingClientRect();
    const documentTop = rect.top + window.scrollY;
    const documentBottom = documentTop + rect.height;
    const start = Math.max(0, documentTop - window.innerHeight * 0.25);
    const finish = Math.max(start + 1, documentBottom - window.innerHeight * 0.75);
    const fraction = Math.max(0, Math.min(1, (window.scrollY - start) / (finish - start)));
    const percent = Math.round(fraction * 100);
    progressFill.style.transform = `scaleX(${fraction})`;
    if (progressLeaf) progressLeaf.style.left = `${percent}%`;
    progressBar.classList.toggle("active", percent > 0);
    progressBar.setAttribute("aria-valuenow", String(percent));
    progressBar.setAttribute("aria-valuetext", `${percent}% of digest read`);
  }
  function scheduleReadingProgress() {
    if (progressFrame !== null) return;
    progressFrame = window.requestAnimationFrame(updateReadingProgress);
  }
  window.addEventListener("scroll", scheduleReadingProgress, { passive: true });
  window.addEventListener("resize", scheduleReadingProgress);
  scheduleReadingProgress();

  function setActive(itemEl, grade) {
    itemEl.dataset.currentGrade = String(grade);
    itemEl.querySelectorAll(".vote-btn").forEach((b) => {
      const g = b.dataset.grade;
      b.classList.toggle("active", g === String(grade));
      b.setAttribute("aria-pressed", g === String(grade) ? "true" : "false");
      ["must", "good", "neutral", "bad"].forEach((c) => b.classList.remove(c));
      b.classList.add(GRADE_CLASS[g]);
    });
    if (!NEGATIVE_GRADES.has(String(grade))) {
      itemEl.querySelectorAll(".reason-chip.active").forEach((chip) => {
        chip.classList.remove("active");
        chip.setAttribute("aria-pressed", "false");
      });
    }
    const reasonBlock = itemEl.querySelector(".reason-block");
    if (reasonBlock) reasonBlock.hidden = !NEGATIVE_GRADES.has(String(grade));
    syncReasonChips(itemEl);
    itemEl.dataset.reviewed = "true";
  }

  function reasonFeedbackEnabled(itemEl) {
    return NEGATIVE_GRADES.has(itemEl.dataset.currentGrade);
  }

  function syncReasonChips(itemEl) {
    const enabled = reasonFeedbackEnabled(itemEl);
    itemEl.querySelectorAll(".reason-chip").forEach((chip) => {
      chip.disabled = !enabled && !chip.classList.contains("active");
    });
  }

  function setSaving(itemEl, saving) {
    itemEl.querySelectorAll(".vote-btn").forEach((b) => { b.disabled = saving; });
  }

  function setStatus(itemEl, text, state) {
    const status = itemEl.querySelector(".save-state");
    if (!status) return;
    status.classList.remove("saved", "error");
    if (state) status.classList.add(state);
    status.textContent = text;
  }

  function showToast(text) {
    if (!toastEl) return;
    toastEl.textContent = text;
    toastEl.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove("show"), 2200);
  }

  function flash(itemEl) {
    itemEl.classList.add("flash");
    setTimeout(() => itemEl.classList.remove("flash"), 600);
  }

  function updateRankingStatus(status) {
    if (!status || !status.vote_counts) return;
    const counts = status.vote_counts;
    const goodEl = document.getElementById("vote-good");
    const badEl = document.getElementById("vote-bad");
    const signedEl = document.getElementById("vote-signed");
    const thresholdEl = document.getElementById("vote-threshold");
    const msgEl = document.getElementById("ranking-message");
    if (goodEl) goodEl.textContent = counts.good;
    if (badEl) badEl.textContent = counts.bad;
    if (signedEl) signedEl.textContent = counts.signed;
    if (thresholdEl) thresholdEl.textContent = status.min_votes_for_lr;
    if (trainBtn) trainBtn.disabled = !status.can_train;
    if (!msgEl) return;
    if (status.ranking_status === "preference_active") {
      msgEl.textContent = "Personal ranking is active — every rating sharpens the next brew automatically.";
    } else {
      msgEl.textContent = `${status.remaining_votes_for_lr} more ratings unlock personal ranking.`;
    }
  }

  async function pollTrainingStatus() {
    for (let i = 0; i < 40; i += 1) {
      try {
        const r = await fetch("/ranking/status");
        if (!r.ok) throw new Error("HTTP " + r.status);
        const payload = await r.json();
        updateRankingStatus(payload.status);
        if (!payload.training_job || !payload.training_job.running) {
          if (trainBtn) {
            trainBtn.textContent = "Refresh calibration";
            trainBtn.disabled = !payload.status.can_train;
          }
          const result = payload.training_job ? payload.training_job.last_result : null;
          if (result && result.ok) showToast("Personal ranking updated");
          return;
        }
      } catch (e) {
        return;
      }
      await new Promise((resolve) => setTimeout(resolve, 1500));
    }
  }

  function activeFilterState() {
    const activeSourceTypes = new Set();
    let priorityOnly = false;
    let unreadOnly = false;

    document.querySelectorAll(".filter-chip.active[data-filter-group]").forEach((btn) => {
      const group = btn.dataset.filterGroup;
      const value = btn.dataset.filterValue || "";
      if (group === "source" && value) activeSourceTypes.add(value);
      if (group === "status" && value === "priority") priorityOnly = true;
      if (group === "status" && value === "unreviewed") unreadOnly = true;
    });
    return { activeSourceTypes, priorityOnly, unreadOnly };
  }

  function matchesSourceType(bucket, activeSourceTypes) {
    if (activeSourceTypes.size === 0) return true;
    const checks = {
      published: bucket === "published_journal" || bucket === "published_database",
      preprints: bucket === "arxiv_cs" || bucket === "arxiv_other" || bucket === "bio_med_preprint" || bucket === "preprint_other",
      "ai-cs": bucket === "arxiv_cs",
    };
    return Array.from(activeSourceTypes).some((sourceType) => Boolean(checks[sourceType]));
  }

  function syncAllChip(state) {
    const allBtn = document.querySelector('.filter-chip[data-filter="all"]');
    if (!allBtn) return;
    const hasFilters = state.priorityOnly || state.unreadOnly || state.activeSourceTypes.size > 0;
    allBtn.classList.toggle("active", !hasFilters);
    allBtn.setAttribute("aria-pressed", hasFilters ? "false" : "true");
  }

  function applyReaderFilters() {
    const state = activeFilterState();
    const items = Array.from(document.querySelectorAll(".item"));
    let shown = 0;
    items.forEach((itemEl) => {
      const bucket = itemEl.dataset.sourceBucket || "";
      const priorityMatch = !state.priorityOnly || itemEl.dataset.priority === "spotlight" || itemEl.dataset.priority === "read";
      const unreadMatch = !state.unreadOnly || itemEl.dataset.reviewed !== "true";
      const visible = priorityMatch && unreadMatch && matchesSourceType(bucket, state.activeSourceTypes);
      itemEl.hidden = !visible;
      if (visible) shown += 1;
    });
    syncAllChip(state);

    document.querySelectorAll(".section-block").forEach((sectionEl) => {
      const hasVisibleItem = Array.from(sectionEl.querySelectorAll(".item")).some((itemEl) => !itemEl.hidden);
      sectionEl.hidden = !hasVisibleItem;
      if (hasVisibleItem && (state.priorityOnly || state.unreadOnly || state.activeSourceTypes.size > 0)) {
        sectionEl.open = true;
      }
    });

    const countEl = document.getElementById("filter-count");
    if (countEl) countEl.textContent = `${shown} shown`;
    const emptyEl = document.getElementById("no-filter-results");
    if (emptyEl) emptyEl.style.display = shown === 0 ? "block" : "none";
  }

  document.querySelectorAll(".filter-chip").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.dataset.filter === "all") {
        document.querySelectorAll(".filter-chip[data-filter-group]").forEach((other) => {
          other.classList.remove("active");
          other.setAttribute("aria-pressed", "false");
        });
      } else {
        const active = !btn.classList.contains("active");
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-pressed", active ? "true" : "false");
      }
      applyReaderFilters();
    });
  });

  const overflowSaveBtn = document.getElementById("overflow-save-btn");
  if (overflowSaveBtn) {
    overflowSaveBtn.addEventListener("click", async () => {
      overflowSaveBtn.disabled = true;
      try {
        const response = await fetch("/overflow/save", {
          method: "POST",
          headers: { "X-CSRF-Token": CSRF_TOKEN },
        });
        if (!response.ok) throw new Error("HTTP " + response.status);
        const payload = await response.json();
        overflowSaveBtn.textContent = "Saved for tomorrow \u2713";
        showToast(`${payload.saved} picks will compete again in tomorrow's brew`);
      } catch (error) {
        overflowSaveBtn.disabled = false;
        showToast("Could not save these for tomorrow");
      }
    });
  }

  document.querySelectorAll(".overflow-row").forEach((rowEl) => {
    const stateEl = rowEl.querySelector(".overflow-vote-state");
    rowEl.querySelectorAll(".overflow-vote").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = rowEl.dataset.itemId;
        const grade = btn.dataset.grade;
        const buttons = rowEl.querySelectorAll(".overflow-vote");
        buttons.forEach((b) => { b.disabled = true; });
        try {
          const response = await fetch(`/vote/${id}/${grade}`, {
            method: "POST",
            headers: { "X-CSRF-Token": CSRF_TOKEN },
          });
          if (!response.ok) throw new Error("HTTP " + response.status);
          buttons.forEach((b) => b.classList.toggle("active", b === btn));
          const payload = await response.json();
          if (payload.ranking_status) updateRankingStatus(payload.ranking_status);
          // A positive rating means "I want this" — pin it so it competes in the
          // next brew instead of ageing out of the candidate window.
          let kept = false;
          if (Number(grade) >= 70) {
            const pin = await fetch(`/overflow/save/${id}`, {
              method: "POST",
              headers: { "X-CSRF-Token": CSRF_TOKEN },
            });
            kept = pin.ok;
          }
          if (stateEl) stateEl.textContent = kept ? "Saved · kept for tomorrow" : "Saved";
        } catch (error) {
          if (stateEl) stateEl.textContent = "Could not save";
        } finally {
          buttons.forEach((b) => { b.disabled = false; });
        }
      });
    });
  });

  document.querySelectorAll(".item").forEach((itemEl) => {
    syncReasonChips(itemEl);
    const bookmarkBtn = itemEl.querySelector(".bookmark-btn:not(.known-btn)");
    if (bookmarkBtn) {
      bookmarkBtn.addEventListener("click", async () => {
        const id = itemEl.dataset.itemId;
        const wasSaved = itemEl.dataset.bookmarked === "true";
        bookmarkBtn.disabled = true;
        try {
          const response = await fetch(`/bookmark/${id}`, {
            method: wasSaved ? "DELETE" : "POST",
            headers: { "X-CSRF-Token": CSRF_TOKEN },
          });
          if (!response.ok) throw new Error("HTTP " + response.status);
          const nowSaved = !wasSaved;
          itemEl.dataset.bookmarked = nowSaved ? "true" : "false";
          bookmarkBtn.classList.toggle("active", nowSaved);
          bookmarkBtn.setAttribute("aria-pressed", nowSaved ? "true" : "false");
          const bookmarkIcon = bookmarkBtn.querySelector(".bookmark-icon");
          const bookmarkLabel = bookmarkBtn.querySelector(".bookmark-label");
          if (bookmarkIcon) bookmarkIcon.textContent = nowSaved ? "★" : "☆";
          if (bookmarkLabel) bookmarkLabel.textContent = nowSaved ? "Saved" : "Save";
          bookmarkBtn.setAttribute("aria-label", nowSaved ? "Remove from saved items" : "Save for later");
          showToast(nowSaved ? "Saved for later" : "Removed from saved items");
        } catch (error) {
          showToast("Saved-item change failed");
        } finally {
          bookmarkBtn.disabled = false;
        }
      });
    }
    const knownBtn = itemEl.querySelector(".known-btn");
    if (knownBtn) {
      knownBtn.addEventListener("click", async () => {
        const id = itemEl.dataset.itemId;
        const wasKnown = itemEl.dataset.known === "true";
        knownBtn.disabled = true;
        try {
          const response = await fetch(`/known/${id}`, {
            method: wasKnown ? "DELETE" : "POST",
            headers: { "X-CSRF-Token": CSRF_TOKEN },
          });
          if (!response.ok) throw new Error("HTTP " + response.status);
          const nowKnown = !wasKnown;
          itemEl.dataset.known = nowKnown ? "true" : "false";
          knownBtn.classList.toggle("active", nowKnown);
          knownBtn.setAttribute("aria-pressed", nowKnown ? "true" : "false");
          const knownIcon = knownBtn.querySelector(".known-icon");
          const knownLabel = knownBtn.querySelector(".known-label");
          if (knownIcon) knownIcon.textContent = nowKnown ? "\u2713" : "\u2298";
          if (knownLabel) knownLabel.textContent = nowKnown ? "Known" : "Mark known";
          knownBtn.setAttribute("aria-label", nowKnown ? "Show this again in future digests" : "Mark as known so it stops appearing");
          showToast(nowKnown ? "Marked known - it won't come back" : "Un-marked - it can appear again");
        } catch (error) {
          showToast("Could not update the known flag");
        } finally {
          knownBtn.disabled = false;
        }
      });
    }
    itemEl.querySelectorAll(".vote-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = itemEl.dataset.itemId;
        const grade = btn.dataset.grade;
        setSaving(itemEl, true);
        setStatus(itemEl, "Saving response...", "");
        try {
	          const r = await fetch(`/vote/${id}/${grade}`, {
	            method: "POST",
	            headers: { "X-CSRF-Token": CSRF_TOKEN },
	          });
          if (!r.ok) throw new Error("HTTP " + r.status);
          const payload = await r.json();
          setActive(itemEl, grade);
          applyReaderFilters();
          updateRankingStatus(payload.ranking_status);
          const stamp = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
          setStatus(itemEl, `${GRADE_LABEL[grade]} saved at ${stamp}`, "saved");
          showToast(`${GRADE_LABEL[grade]} response saved`);
        } catch (e) {
          setStatus(itemEl, "Response was not saved. Try again.", "error");
          flash(itemEl);
        } finally {
          setSaving(itemEl, false);
        }
      });
    });
    itemEl.querySelectorAll(".reason-chip").forEach((chip) => {
      chip.addEventListener("click", async () => {
        const id = itemEl.dataset.itemId;
        const reason = chip.dataset.reason;
        const removing = chip.classList.contains("active");
        if (!removing && !reasonFeedbackEnabled(itemEl)) {
          setStatus(itemEl, "Choose Hmmm or Not for me before adding a reason.", "");
          showToast("Choose a read response first");
          return;
        }
        chip.disabled = true;
        setStatus(itemEl, removing ? "Removing reason..." : "Saving reason...", "");
        try {
          const r = await fetch(`/vote/${id}/reason/${reason}`, {
            method: removing ? "DELETE" : "POST",
            headers: { "X-CSRF-Token": CSRF_TOKEN },
          });
          if (!r.ok) throw new Error("HTTP " + r.status);
          chip.classList.toggle("active", !removing);
          chip.setAttribute("aria-pressed", removing ? "false" : "true");
          syncReasonChips(itemEl);
          const stamp = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
          setStatus(itemEl, `${removing ? "Reason removed" : "Reason saved"} at ${stamp}`, "saved");
          showToast(removing ? "Reason removed" : "Reason saved");
        } catch (e) {
          setStatus(itemEl, "Reason change was not saved. Try again.", "error");
          flash(itemEl);
        } finally {
          chip.disabled = false;
          syncReasonChips(itemEl);
        }
      });
    });
  });

  if (trainBtn) {
    trainBtn.addEventListener("click", async () => {
      trainBtn.disabled = true;
      const oldText = trainBtn.textContent;
      trainBtn.textContent = "Updating...";
      let keepDisabled = false;
      try {
        const r = await fetch("/ranking/train", {
          method: "POST",
          headers: { "X-CSRF-Token": CSRF_TOKEN },
        });
        if (!r.ok) throw new Error("HTTP " + r.status);
        const payload = await r.json();
        updateRankingStatus(payload.status);
        keepDisabled = Boolean(payload.running);
        if (payload.running && trainBtn) {
          trainBtn.disabled = true;
          pollTrainingStatus();
        }
        showToast(payload.message || (payload.ok ? "Ranking update started" : "Ranking was not updated"));
      } catch (e) {
        showToast("Ranking update failed");
      } finally {
        trainBtn.textContent = oldText;
        if (!keepDisabled) trainBtn.disabled = false;
      }
    });
  }

})();
</script>
{% endblock %}
