      {% for source, count in overview.source_mix %}
      <div class="mix-row">
        <span>{{ source }}</span>
        <div class="mix-track"><div class="mix-fill" style="width: {{ (count * 100 / overview.selected) | round(0, 'floor') if overview.selected else 0 }}%;"></div></div>
        <span>{{ count }}</span>
