    if(event.target.closest?.('input, textarea, select, [contenteditable], #display-menu, .tea-break'))return;
    if(!['j','k','1','2','3','4','s'].includes(event.key))return;
    const visible=[...document.querySelectorAll('.item')].filter(item=>!item.hidden&&item.offsetParent!==null);
    if(!visible.length)return;
    let current=document.activeElement?.closest?.('.item');
    if(!current||!visible.includes(current))current=visible.find(item=>item.getBoundingClientRect().bottom>80)||visible[0];
    event.preventDefault();
