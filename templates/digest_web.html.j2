  function revealTab(link,behavior=tabMotion()){
    if(!tabStrip||!link||link.hidden||tabStrip.scrollWidth<=tabStrip.clientWidth+2)return;
    const strip=tabStrip.getBoundingClientRect(),tab=link.getBoundingClientRect(),lead=30,trail=40;
    // A tab wider than the visible strip aligns its start, so its label reads first.
    if(tab.left<strip.left+lead||tab.width>strip.width-lead-trail)tabStrip.scrollBy({left:tab.left-strip.left-lead,behavior});
    else if(tab.right>strip.right-trail)tabStrip.scrollBy({left:tab.right-strip.right+trail,behavior});
