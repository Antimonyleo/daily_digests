{% extends "_base.html.j2" %}
{% block title %}DailyDigest {{ digest_id }}{% endblock %}
{% block extra_styles %}
  .topbar {
    display: grid; grid-template-columns: 1fr auto; gap: 20px;
    align-items: end; margin-bottom: 18px;
  }
  .eyebrow {
    color: var(--accent); font-size: 12px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px;
  }
	  h1 {
	    font-size: clamp(28px, 4vw, 44px); line-height: 1.05;
	    margin: 0; letter-spacing: 0; overflow-wrap: anywhere;
	  }
  .subhead {
    margin: 10px 0 0; color: var(--muted); max-width: 620px;
    font-size: 15px; line-height: 1.55;
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  .name-prompt {
    display: grid; grid-template-columns: 1fr auto; gap: 10px;
    padding: 14px; margin-bottom: 16px; border: 1px solid #d6e6db;
    border-radius: 8px; background: var(--accent-soft);
  }
  .name-prompt label { display: block; font-size: 12px; font-weight: 800; color: var(--accent-strong); margin-bottom: 5px; }
  .name-prompt input {
    width: 100%; min-height: 38px; padding: 8px 10px;
    border: 1px solid #b9d2c3; border-radius: 8px; background: #fff;
  }
  .insight-grid {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px;
    margin: 0 0 16px;
  }
  .stat-tile {
    background: #fff; border: 1px solid var(--border); border-radius: 8px;
    padding: 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }
  .stat-label {
    color: var(--muted); font-size: 11px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .stat-value { font-size: 24px; font-weight: 820; margin-top: 4px; }
  .source-mix, .must-read, .audit-panel {
    background: #fff; border: 1px solid var(--border); border-radius: 8px;
    padding: 14px; margin-bottom: 16px;
  }
  .panel-title {
    margin: 0 0 10px; font-size: 13px; color: var(--text);
    font-weight: 820; letter-spacing: 0.02em;
  }
  .mix-row {
    display: grid; grid-template-columns: minmax(110px, 190px) 1fr auto;
    align-items: center; gap: 8px; margin: 7px 0; font-size: 12px;
  }
  .mix-track {
    height: 8px; background: #eef1ed; border-radius: 999px; overflow: hidden;
  }
  .mix-fill { height: 100%; background: #5b8f73; border-radius: 999px; }
  .must-list {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px;
  }
  .must-card {
    border: 1px solid #dfe6df; border-radius: 8px; padding: 10px; background: #fbfcf9;
  }
  .must-card a {
    color: var(--text); text-decoration: none; font-size: 13px; line-height: 1.35;
    font-weight: 780; overflow-wrap: anywhere;
  }
  .must-meta { margin-top: 6px; color: var(--muted); font-size: 11px; }
  .audit-summary { color: var(--muted); font-size: 13px; line-height: 1.45; margin: 0 0 8px; }
  .audit-list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .audit-list li { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: start; font-size: 12px; }
  .audit-list a { color: var(--text); text-decoration: none; font-weight: 720; overflow-wrap: anywhere; }
  .audit-list a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .audit-score { color: var(--muted); white-space: nowrap; }
  .digest-card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; box-shadow: var(--shadow); overflow: hidden; }
  .digest-toolbar {
    display: flex; justify-content: space-between; gap: 16px; align-items: center;
    padding: 16px 18px; background: var(--panel); border-bottom: 1px solid var(--border);
  }
	  .digest-date { font-weight: 750; overflow-wrap: anywhere; }
	  .feedback-note { color: var(--muted); font-size: 13px; line-height: 1.45; max-width: 620px; }
  .ranking-panel {
    display: grid; gap: 8px; min-width: 282px; padding: 12px;
    border: 1px solid var(--border); border-radius: 8px; background: #fff;
  }
  .ranking-kicker {
    color: var(--muted); font-size: 11px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ranking-counts { display: flex; flex-wrap: wrap; gap: 6px; }
  .count-pill {
    display: inline-flex; align-items: center; gap: 4px;
    min-height: 26px; padding: 3px 8px; border-radius: 999px;
    background: #eef1ed; color: var(--text); font-size: 12px; font-weight: 750;
  }
  .count-pill.good { background: #e4f4eb; color: var(--up); }
  .count-pill.bad { background: #fdecea; color: var(--down); }
  .ranking-message { color: var(--muted); font-size: 12px; line-height: 1.4; }
  .ranking-panel .btn { width: 100%; }
  .ranking-panel .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .reader-tools {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--border);
    background: #fff;
  }
  .tool-group { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .tool-label {
    color: var(--muted); font-size: 11px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase; margin-right: 2px;
  }
  .filter-chip {
    border: 1px solid var(--border); border-radius: 999px; background: #fbfcf9;
    color: var(--text); min-height: 30px; padding: 5px 10px; font-size: 12px;
    font-weight: 720; cursor: pointer;
  }
  .filter-chip:hover { background: #f0f5f1; border-color: #bfd0c5; }
  .filter-chip.active {
    background: var(--accent-soft); border-color: #9fc2ae; color: var(--accent-strong);
  }
  .filter-count { color: var(--muted); font-size: 12px; }
  .section-title {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    font-size: 17px; margin: 0; padding: 20px 22px 8px;
    border-top: 1px solid #edf1ec; color: var(--text);
  }
  .section-title:first-of-type { border-top: none; }
  .section-count {
    font-size: 12px; color: var(--muted); font-weight: 650;
    background: #eef1ed; border-radius: 999px; padding: 4px 9px;
  }
  .item {
    display: grid; grid-template-columns: minmax(0, 1fr) 214px; gap: 18px;
    padding: 16px 22px; border-top: 1px solid #eef1ed;
  }
  .item[data-priority="spotlight"] { border-left: 4px solid var(--gold); }
  .item[data-priority="read"] { border-left: 4px solid var(--accent); }
  .item[data-priority="skim"] { border-left: 4px solid #c7d0c9; }
  .item:first-of-type { border-top: none; }
  .item-head { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-bottom: 4px; }
  .item .label-pill {
    display: inline-flex; align-items: center; font-weight: 760; color: var(--muted);
    background: #f3f5f2; border: 1px solid #dfe6df; border-radius: 6px;
    padding: 2px 7px; font-size: 11px;
  }
  .priority-pill, .lane-pill {
    display: inline-flex; align-items: center; min-height: 22px; padding: 3px 8px;
    border-radius: 999px; font-size: 11px; font-weight: 820;
  }
  .priority-pill.spotlight { color: #7a4b00; background: var(--gold-soft); border: 1px solid #edd49c; }
  .priority-pill.read { color: var(--accent-strong); background: var(--accent-soft); border: 1px solid #d7e9dd; }
  .priority-pill.skim { color: #49554e; background: #f1f3f1; border: 1px solid #dfe6df; }
  .lane-pill {
    color: #334238; background: #f6f8f5; border: 1px solid #e2e8e1;
  }
  .item a.title-link {
    color: var(--text); text-decoration: none; font-weight: 720; font-size: 16px;
    line-height: 1.36; overflow-wrap: anywhere; word-break: normal;
  }
  .item a.title-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
	  .item .meta { font-size: 12px; color: var(--muted); margin: 6px 0 0; overflow-wrap: anywhere; }
	  .item .summary { font-size: 14px; line-height: 1.55; margin: 9px 0 0; color: #334238; overflow-wrap: anywhere; }
  .summary-fields {
    display: grid; gap: 7px; margin: 10px 0 0; padding: 10px;
    border: 1px solid #e4ebe5; border-radius: 8px; background: #fbfcf9;
  }
  .summary-field { display: grid; grid-template-columns: 92px 1fr; gap: 8px; }
  .summary-label { color: var(--accent-strong); font-size: 11px; font-weight: 840; text-transform: uppercase; letter-spacing: 0.04em; }
  .summary-text { color: #334238; font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }
  .reason-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
  .reason-badge {
    display: inline-flex; align-items: center; min-height: 22px; padding: 3px 7px;
    border: 1px solid #dce6dd; border-radius: 999px; background: #f4f8f5;
    color: #365343; font-size: 11px; font-weight: 700;
  }
  .why-shown {
    margin-top: 10px; border: 1px solid #e1e8e2; border-radius: 8px;
    background: #fbfcf9; overflow: hidden;
  }
  .why-shown summary {
    cursor: pointer; padding: 8px 10px; font-size: 12px; font-weight: 820;
    color: var(--accent-strong);
  }
  .why-body { padding: 0 10px 10px; }
  .why-copy { color: #405047; font-size: 12px; line-height: 1.45; margin-bottom: 8px; }
  .editorial-signals { display: flex; flex-wrap: wrap; gap: 6px; }
  .signal-chip {
    display: inline-flex; align-items: center; min-height: 24px; padding: 4px 8px;
    border-radius: 999px; border: 1px solid #dde6df; background: #fff;
    color: #334238; font-size: 11px; font-weight: 720;
  }
  .save-state { min-height: 18px; margin-top: 8px; color: var(--muted); font-size: 12px; }
  .save-state.saved { color: var(--up); }
  .save-state.error { color: var(--down); }
  .vote-panel {
    align-self: start; border: 1px solid var(--border); border-radius: 8px;
    background: #fff; padding: 10px; min-width: 0;
  }
  .vote-title {
    font-size: 11px; color: var(--muted); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.08em; margin-bottom: 8px;
  }
  .vote-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .reason-prompt { margin-top: 9px; color: var(--muted); font-size: 11px; font-weight: 760; }
  .reason-chip-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
  .reason-chip {
    border: 1px solid var(--border); border-radius: 999px; background: #fbfcf9;
    color: var(--muted); min-height: 25px; padding: 3px 8px; font-size: 11px;
    cursor: pointer;
  }
  .reason-chip.active { color: var(--accent-strong); border-color: #9fc2ae; background: var(--accent-soft); }
  .reason-chip:disabled { opacity: 0.65; cursor: progress; }
  .vote-btn {
    min-height: 48px; padding: 7px 6px; border: 1px solid var(--border); border-radius: 7px;
    cursor: pointer; color: var(--text); background: #fafbf9; font-size: 12px; font-weight: 750;
  }
  .vote-label { display: block; font-weight: 820; line-height: 1.1; }
  .vote-help { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; font-weight: 650; line-height: 1.15; }
  .vote-btn.active .vote-help { color: inherit; }
  .vote-btn:hover { background: #f0f5f1; border-color: #bfd0c5; }
  .vote-btn.active.good { background: #e4f4eb; border-color: var(--up); color: var(--up); }
  .vote-btn.active.neutral { background: #eef1ed; border-color: var(--neutral); color: var(--neutral); }
  .vote-btn.active.bad { background: #fdecea; border-color: var(--down); color: var(--down); }
  .vote-btn:disabled { opacity: 0.65; cursor: progress; }
  .item.flash { background: var(--flash); transition: background 0.4s; }
  .no-filter-results {
    display: none; padding: 30px 22px; color: var(--muted); text-align: center;
    border-top: 1px solid #eef1ed; font-size: 14px;
  }
  .empty { padding: 44px 22px; text-align: center; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .toast {
    position: fixed; right: 18px; bottom: 18px; z-index: 20;
    background: #16231c; color: #fff; border-radius: 8px; padding: 11px 13px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.18); font-size: 13px;
    transform: translateY(18px); opacity: 0; pointer-events: none;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  @media (max-width: 760px) {
    .topbar { grid-template-columns: 1fr; align-items: start; }
    .actions { justify-content: flex-start; }
    .insight-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .must-list { grid-template-columns: 1fr; }
    .mix-row { grid-template-columns: 1fr auto; }
    .mix-track { grid-column: 1 / -1; }
    .digest-toolbar { align-items: flex-start; flex-direction: column; }
    .ranking-panel { width: 100%; min-width: 0; }
    .reader-tools { align-items: flex-start; flex-direction: column; }
    .item { grid-template-columns: 1fr; gap: 10px; }
    .summary-field { grid-template-columns: 1fr; gap: 3px; }
    .audit-list li { grid-template-columns: 1fr; }
    .vote-panel { width: 100%; }
    .name-prompt { grid-template-columns: 1fr; }
  }
{% endblock %}
{% block body %}
  <header class="topbar">
    <div>
      <div class="eyebrow">DailyDigest</div>
      <h1>Good morning{% if profile_name %}, {{ profile_name }}{% endif %}</h1>
      <p class="subhead">Fresh research, biotech, regulatory, and world signals ranked against your profile.</p>
    </div>
    <div class="actions">
      <button class="btn primary" id="refresh-btn" type="button">Brew my morning cup of tea</button>
      <button class="btn" onclick="window.location.href='/setup'" type="button">Settings</button>
    </div>
  </header>

  {% if not profile_name %}
	  <form class="name-prompt" method="post" action="/profile/name">
	    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
	    <div>
      <label for="name">First name</label>
      <input id="name" name="name" type="text" autocomplete="given-name" placeholder="What should DailyDigest call you?">
    </div>
    <button class="btn primary" type="submit">Save</button>
  </form>
  {% endif %}

  <section class="insight-grid" aria-label="Digest summary">
    <div class="stat-tile">
      <div class="stat-label">Scanned</div>
      <div class="stat-value">{{ overview.scanned or 0 }}</div>
    </div>
    <div class="stat-tile">
      <div class="stat-label">Selected</div>
      <div class="stat-value">{{ overview.selected }}</div>
    </div>
    <div class="stat-tile">
      <div class="stat-label">Sources</div>
      <div class="stat-value">{{ overview.sources or 0 }}</div>
    </div>
    <div class="stat-tile">
      <div class="stat-label">Source issues</div>
      <div class="stat-value">{{ overview.failures or 0 }}</div>
    </div>
  </section>

  {% if overview.must_read %}
  <section class="must-read">
    <h2 class="panel-title">Must read first</h2>
    <div class="must-list">
      {% for item in overview.must_read[:3] %}
      <div class="must-card">
        <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
        <div class="must-meta">{{ item.source }}{% if item.ranking.tags %} &middot; {{ item.ranking.tags[0] }}{% endif %}</div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if overview.source_mix %}
  <section class="source-mix">
    <h2 class="panel-title">Today’s source mix</h2>
    {% for source, count in overview.source_mix %}
    <div class="mix-row">
      <span>{{ source }}</span>
      <div class="mix-track"><div class="mix-fill" style="width: {{ (count * 100 / overview.selected) | round(0, 'floor') if overview.selected else 0 }}%;"></div></div>
      <span>{{ count }}</span>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if top_journal_audit %}
  <section class="audit-panel">
    <h2 class="panel-title">Top-journal audit</h2>
    <p class="audit-summary">{{ overview.top_journals_shown }} published-journal picks shown. {{ top_journal_audit|length }} high-quality candidates were considered but missed the final cutoff.</p>
    <ul class="audit-list">
      {% for audit in top_journal_audit[:5] %}
      <li>
        <a href="{{ audit.url | default('#') }}" target="_blank" rel="noopener">{{ audit.title }}</a>
        <span class="audit-score">{{ audit.source }} · {{ audit.score }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <main class="digest-card">
    <div class="digest-toolbar">
      <div>
        <div class="digest-date">{{ digest_id }}</div>
	        <div class="feedback-note">Responses save instantly. Good and Bad teach future ranking updates; Neutral marks an item as reviewed.</div>
      </div>
      <div class="ranking-panel" aria-live="polite">
        <div class="ranking-kicker">Personalization</div>
        <div class="ranking-counts">
          <span class="count-pill good">Good <span id="vote-good">{{ ranking_status.vote_counts.good }}</span></span>
          <span class="count-pill bad">Bad <span id="vote-bad">{{ ranking_status.vote_counts.bad }}</span></span>
          <span class="count-pill">Helpful ratings <span id="vote-signed">{{ ranking_status.vote_counts.signed }}</span>/<span id="vote-threshold">{{ ranking_status.min_votes_for_lr }}</span></span>
        </div>
        <div class="ranking-message" id="ranking-message">
          {% if ranking_status.ranking_status == "lr_active" %}
          Personal ranking is active.
          {% elif ranking_status.model_trained %}
          Personal ranking is trained; {{ ranking_status.remaining_votes_for_lr }} more Good/Bad responses will refresh it.
          {% elif ranking_status.can_train %}
          Enough feedback is ready. Update your personal ranking.
          {% else %}
          {{ ranking_status.remaining_votes_for_lr }} more Good/Bad responses unlock personal ranking.
          {% endif %}
        </div>
        <button class="btn primary" id="train-ranker-btn" type="button"{% if not ranking_status.can_train %} disabled{% endif %}>Update my ranking</button>
      </div>
    </div>

    {% if not empty %}
    <div class="reader-tools" aria-label="Digest filters">
      <div class="tool-group" role="group" aria-label="Filter items">
        <span class="tool-label">View</span>
        <button class="filter-chip active" data-filter="all" type="button" aria-pressed="true">All</button>
        <button class="filter-chip" data-filter="priority" type="button" aria-pressed="false">Priority</button>
        <button class="filter-chip" data-filter="unreviewed" type="button" aria-pressed="false">Unread</button>
        <button class="filter-chip" data-filter="published" type="button" aria-pressed="false">Published journals</button>
        <button class="filter-chip" data-filter="preprints" type="button" aria-pressed="false">Preprints</button>
        <button class="filter-chip" data-filter="ai-cs" type="button" aria-pressed="false">AI / CS</button>
      </div>
      <div class="tool-group" role="group" aria-label="Filter by lane">
        <span class="tool-label">Lane</span>
        {% for section in sections %}
        <button class="filter-chip" data-filter="section:{{ section.key }}" type="button" aria-pressed="false">{{ section.title }}</button>
        {% endfor %}
      </div>
      <div class="filter-count" id="filter-count">{{ overview.selected }} shown</div>
    </div>
    {% endif %}

	    {% if empty %}
	    <div class="empty">
	      {% if brewed %}
	      A digest was brewed for today, but no matching items were found.<br>
	      Adjust section sizes or profile terms in Settings, then brew again.
	      {% else %}
	      No digest has been brewed for today yet.<br>
	      Use the brew button to fetch fresh sources and watch progress live.
	      {% endif %}
	    </div>
    {% else %}
      {% for section in sections %}
      <section class="section-block" data-section="{{ section.key }}">
      <h2 class="section-title">
        <span><span style="margin-right:6px;">{{ section.emoji }}</span>{{ section.title }}</span>
        <span class="section-count">{{ section.entries|length }}</span>
      </h2>
      {% for item in section.entries %}
      {% set priority = 'spotlight' if item.score_raw >= 0.85 else ('read' if item.score_raw >= 0.65 else 'skim') %}
      {% set priority_label = 'Lead story' if priority == 'spotlight' else ('Worth reading' if priority == 'read' else 'Quick skim') %}
      <div class="item" data-item-id="{{ item.id }}" data-section="{{ section.key }}" data-priority="{{ priority }}" data-source-bucket="{{ item.ranking.source_bucket }}" data-reviewed="{{ 'true' if item.current_vote is not none else 'false' }}">
        <div class="item-main">
          <div class="item-head">
            <span class="label-pill">{{ item.label }}</span>
            <span class="priority-pill {{ priority }}">{{ priority_label }}</span>
            <span class="lane-pill">{{ section.title }}</span>
          </div>
          <div>
            <a class="title-link" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
          </div>
          <div class="meta">
            {{ item.source }}{% if item.published %} &middot; {{ item.published }}{% endif %}
          </div>
          {% if item.ranking.tags %}
          <div class="reason-row">
            {% for tag in item.ranking.tags %}
            <span class="reason-badge">{{ tag }}</span>
            {% endfor %}
          </div>
          {% endif %}
          <details class="why-shown">
            <summary>Why shown?</summary>
            <div class="why-body">
              <div class="why-copy">
                {% if item.ranking.why_shown %}
                {{ item.ranking.why_shown | join('; ') }}.
                {% else %}
                Selected because it looks relevant to your profile and carries useful editorial signals for today’s read.
                {% endif %}
                {% if item.ranking.selection_reason %}
                {{ item.ranking.selection_reason | capitalize }}.
                {% endif %}
              </div>
              <div class="editorial-signals" aria-label="Editorial signals for {{ item.label }}">
                {% if item.ranking.content_type %}
                <span class="signal-chip">{{ item.ranking.content_type | replace('_', ' ') | title }}</span>
                {% endif %}
                {% if item.ranking.tags %}
                  {% for tag in item.ranking.tags %}
                  <span class="signal-chip">{{ tag }}</span>
                  {% endfor %}
                {% else %}
                  <span class="signal-chip">Profile match</span>
                {% endif %}
                {% if item.ranking.components.topic >= 75 %}
                <span class="signal-chip">Strong profile fit</span>
                {% elif item.ranking.components.topic >= 45 %}
                <span class="signal-chip">Moderate profile fit</span>
                {% endif %}
                {% if item.ranking.components.source >= 70 %}
                <span class="signal-chip">Reliable venue</span>
                {% endif %}
                {% if item.ranking.components.novelty >= 55 %}
                <span class="signal-chip">New development</span>
                {% endif %}
                {% if item.ranking.components.penalty >= 35 %}
                <span class="signal-chip">Read with caution</span>
                {% endif %}
              </div>
            </div>
          </details>
          {% if item.summary_fields %}
          <div class="summary-fields" aria-label="Summary for {{ item.label }}">
            {% for label, text in item.summary_fields.items() %}
            <div class="summary-field">
              <div class="summary-label">{{ label }}</div>
              <div class="summary-text">{{ text }}</div>
            </div>
            {% endfor %}
          </div>
          {% elif item.summary %}
          <div class="summary">{{ item.summary }}</div>
          {% endif %}
          <div class="save-state{% if item.current_vote is not none %} saved{% endif %}" aria-live="polite">
            {% if item.current_vote == 1 %}
            Good saved.
            {% elif item.current_vote == 0 %}
            Neutral saved.
            {% elif item.current_vote == -1 %}
            Bad saved.
            {% else %}
            No response saved yet.
            {% endif %}
          </div>
        </div>
        <div class="vote-panel">
          <div class="vote-title">Your read</div>
          <div class="vote-row" role="group" aria-label="Evaluate {{ item.label }}">
            <button class="vote-btn good{% if item.current_vote == 1 %} active{% endif %}"
                    data-value="1" type="button" aria-pressed="{{ 'true' if item.current_vote == 1 else 'false' }}">
              <span class="vote-label">Good</span><span class="vote-help">More like this</span>
            </button>
            <button class="vote-btn neutral{% if item.current_vote == 0 %} active{% endif %}"
                    data-value="0" type="button" aria-pressed="{{ 'true' if item.current_vote == 0 else 'false' }}">
              <span class="vote-label">Neutral</span><span class="vote-help">Seen</span>
            </button>
            <button class="vote-btn bad{% if item.current_vote == -1 %} active{% endif %}"
                    data-value="-1" type="button" aria-pressed="{{ 'true' if item.current_vote == -1 else 'false' }}">
              <span class="vote-label">Bad</span><span class="vote-help">Less like this</span>
            </button>
          </div>
          <div class="reason-prompt">Reason</div>
          <div class="reason-chip-row" role="group" aria-label="Feedback reason for {{ item.label }}">
            <button class="reason-chip{% if 'off_topic' in item.current_reasons %} active{% endif %}" data-reason="off_topic" type="button" aria-pressed="{{ 'true' if 'off_topic' in item.current_reasons else 'false' }}">Off topic</button>
            <button class="reason-chip{% if 'low_impact' in item.current_reasons %} active{% endif %}" data-reason="low_impact" type="button" aria-pressed="{{ 'true' if 'low_impact' in item.current_reasons else 'false' }}">Low impact</button>
            <button class="reason-chip{% if 'promotional' in item.current_reasons %} active{% endif %}" data-reason="promotional" type="button" aria-pressed="{{ 'true' if 'promotional' in item.current_reasons else 'false' }}">Too promotional</button>
            <button class="reason-chip{% if 'access_friction' in item.current_reasons %} active{% endif %}" data-reason="access_friction" type="button" aria-pressed="{{ 'true' if 'access_friction' in item.current_reasons else 'false' }}">Hard to access</button>
            <button class="reason-chip{% if 'duplicate' in item.current_reasons %} active{% endif %}" data-reason="duplicate" type="button" aria-pressed="{{ 'true' if 'duplicate' in item.current_reasons else 'false' }}">Duplicate</button>
            <button class="reason-chip{% if 'not_urgent' in item.current_reasons %} active{% endif %}" data-reason="not_urgent" type="button" aria-pressed="{{ 'true' if 'not_urgent' in item.current_reasons else 'false' }}">Not urgent</button>
          </div>
        </div>
      </div>
      {% endfor %}
      </section>
      {% endfor %}
      <div class="no-filter-results" id="no-filter-results">No items match this view.</div>
    {% endif %}

    <div class="footer">
      Local UI &middot; votes write to <code>data/digest.db</code>.
    </div>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
{% endblock %}
{% block scripts %}
<script>
(function () {
	  const VALUE_CLASS = { "1": "good", "0": "neutral", "-1": "bad" };
	  const VALUE_LABEL = { "1": "Good", "0": "Neutral", "-1": "Bad" };
	  const CSRF_TOKEN = {{ csrf_token|tojson }};
  const toastEl = document.getElementById("toast");
  const trainBtn = document.getElementById("train-ranker-btn");
  let toastTimer = null;

  function setActive(itemEl, value) {
    itemEl.querySelectorAll(".vote-btn").forEach((b) => {
      const v = b.dataset.value;
      b.classList.toggle("active", v === String(value));
      b.setAttribute("aria-pressed", v === String(value) ? "true" : "false");
      ["good", "neutral", "bad"].forEach((c) => b.classList.remove(c));
      b.classList.add(VALUE_CLASS[v]);
    });
    itemEl.dataset.reviewed = "true";
  }

  function setSaving(itemEl, saving) {
    itemEl.querySelectorAll(".vote-btn").forEach((b) => { b.disabled = saving; });
  }

  function setStatus(itemEl, text, state) {
    const status = itemEl.querySelector(".save-state");
    if (!status) return;
    status.classList.remove("saved", "error");
    if (state) status.classList.add(state);
    status.textContent = text;
  }

  function showToast(text) {
    if (!toastEl) return;
    toastEl.textContent = text;
    toastEl.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove("show"), 2200);
  }

  function flash(itemEl) {
    itemEl.classList.add("flash");
    setTimeout(() => itemEl.classList.remove("flash"), 600);
  }

  function updateRankingStatus(status) {
    if (!status || !status.vote_counts) return;
    const counts = status.vote_counts;
    const goodEl = document.getElementById("vote-good");
    const badEl = document.getElementById("vote-bad");
    const signedEl = document.getElementById("vote-signed");
    const thresholdEl = document.getElementById("vote-threshold");
    const msgEl = document.getElementById("ranking-message");
    if (goodEl) goodEl.textContent = counts.good;
    if (badEl) badEl.textContent = counts.bad;
    if (signedEl) signedEl.textContent = counts.signed;
    if (thresholdEl) thresholdEl.textContent = status.min_votes_for_lr;
    if (trainBtn) trainBtn.disabled = !status.can_train;
    if (!msgEl) return;
    if (status.ranking_status === "lr_active") {
      msgEl.textContent = "Personal ranking is active.";
    } else if (status.model_trained) {
      msgEl.textContent = `Personal ranking is trained; ${status.remaining_votes_for_lr} more Good/Bad responses will refresh it.`;
    } else if (status.can_train) {
      msgEl.textContent = "Enough feedback is ready. Update your personal ranking.";
    } else {
      msgEl.textContent = `${status.remaining_votes_for_lr} more Good/Bad responses unlock personal ranking.`;
    }
  }

  async function pollTrainingStatus() {
    for (let i = 0; i < 40; i += 1) {
      try {
        const r = await fetch("/ranking/status");
        if (!r.ok) throw new Error("HTTP " + r.status);
        const payload = await r.json();
        updateRankingStatus(payload.status);
        if (!payload.training_job || !payload.training_job.running) {
          if (trainBtn) {
            trainBtn.textContent = "Update my ranking";
            trainBtn.disabled = !payload.status.can_train;
          }
          const result = payload.training_job ? payload.training_job.last_result : null;
          if (result && result.ok) showToast("Personal ranking updated");
          return;
        }
      } catch (e) {
        return;
      }
      await new Promise((resolve) => setTimeout(resolve, 1500));
    }
  }

  function applyReaderFilter(filter) {
    const items = Array.from(document.querySelectorAll(".item"));
    let shown = 0;
    items.forEach((itemEl) => {
      let visible = true;
      const bucket = itemEl.dataset.sourceBucket || "";
      if (filter === "priority") {
        visible = itemEl.dataset.priority === "spotlight" || itemEl.dataset.priority === "read";
      } else if (filter === "unreviewed") {
        visible = itemEl.dataset.reviewed !== "true";
      } else if (filter === "published") {
        visible = bucket === "published_journal" || bucket === "published_database";
      } else if (filter === "preprints") {
        visible = bucket === "arxiv_cs" || bucket === "arxiv_other" || bucket === "bio_med_preprint";
      } else if (filter === "ai-cs") {
        visible = bucket === "arxiv_cs";
      } else if (filter && filter.startsWith("section:")) {
        visible = itemEl.dataset.section === filter.slice("section:".length);
      }
      itemEl.hidden = !visible;
      if (visible) shown += 1;
    });

    document.querySelectorAll(".section-block").forEach((sectionEl) => {
      const hasVisibleItem = Array.from(sectionEl.querySelectorAll(".item")).some((itemEl) => !itemEl.hidden);
      sectionEl.hidden = !hasVisibleItem;
    });

    const countEl = document.getElementById("filter-count");
    if (countEl) countEl.textContent = `${shown} shown`;
    const emptyEl = document.getElementById("no-filter-results");
    if (emptyEl) emptyEl.style.display = shown === 0 ? "block" : "none";
  }

  document.querySelectorAll(".filter-chip").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-chip").forEach((other) => {
        const active = other === btn;
        other.classList.toggle("active", active);
        other.setAttribute("aria-pressed", active ? "true" : "false");
      });
      applyReaderFilter(btn.dataset.filter || "all");
    });
  });

  document.querySelectorAll(".item").forEach((itemEl) => {
    itemEl.querySelectorAll(".vote-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = itemEl.dataset.itemId;
        const value = btn.dataset.value;
        setSaving(itemEl, true);
        setStatus(itemEl, "Saving response...", "");
        try {
	          const r = await fetch(`/vote/${id}/${value}`, {
	            method: "POST",
	            headers: { "X-CSRF-Token": CSRF_TOKEN },
	          });
          if (!r.ok) throw new Error("HTTP " + r.status);
          const payload = await r.json();
          setActive(itemEl, value);
          applyReaderFilter(document.querySelector(".filter-chip.active")?.dataset.filter || "all");
          updateRankingStatus(payload.ranking_status);
          const stamp = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
          setStatus(itemEl, `${VALUE_LABEL[value]} saved at ${stamp}`, "saved");
          showToast(`${VALUE_LABEL[value]} response saved`);
        } catch (e) {
          setStatus(itemEl, "Response was not saved. Try again.", "error");
          flash(itemEl);
        } finally {
          setSaving(itemEl, false);
        }
      });
    });
    itemEl.querySelectorAll(".reason-chip").forEach((chip) => {
      chip.addEventListener("click", async () => {
        const id = itemEl.dataset.itemId;
        const reason = chip.dataset.reason;
        const removing = chip.classList.contains("active");
        chip.disabled = true;
        setStatus(itemEl, removing ? "Removing reason..." : "Saving reason...", "");
        try {
          const r = await fetch(`/vote/${id}/reason/${reason}`, {
            method: removing ? "DELETE" : "POST",
            headers: { "X-CSRF-Token": CSRF_TOKEN },
          });
          if (!r.ok) throw new Error("HTTP " + r.status);
          chip.classList.toggle("active", !removing);
          chip.setAttribute("aria-pressed", removing ? "false" : "true");
          const stamp = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
          setStatus(itemEl, `${removing ? "Reason removed" : "Reason saved"} at ${stamp}`, "saved");
          showToast(removing ? "Reason removed" : "Reason saved");
        } catch (e) {
          setStatus(itemEl, "Reason change was not saved. Try again.", "error");
          flash(itemEl);
        } finally {
          chip.disabled = false;
        }
      });
    });
  });

  if (trainBtn) {
    trainBtn.addEventListener("click", async () => {
      trainBtn.disabled = true;
      const oldText = trainBtn.textContent;
      trainBtn.textContent = "Updating...";
      let keepDisabled = false;
      try {
        const r = await fetch("/ranking/train", {
          method: "POST",
          headers: { "X-CSRF-Token": CSRF_TOKEN },
        });
        if (!r.ok) throw new Error("HTTP " + r.status);
        const payload = await r.json();
        updateRankingStatus(payload.status);
        keepDisabled = Boolean(payload.running);
        if (payload.running && trainBtn) {
          trainBtn.disabled = true;
          pollTrainingStatus();
        }
        showToast(payload.message || (payload.ok ? "Ranking update started" : "Ranking was not updated"));
      } catch (e) {
        showToast("Ranking update failed");
      } finally {
        trainBtn.textContent = oldText;
        if (!keepDisabled) trainBtn.disabled = false;
      }
    });
  }

  const refreshBtn = document.getElementById("refresh-btn");
  refreshBtn.addEventListener("click", () => {
    window.location.href = "/run";
  });
})();
</script>
{% endblock %}
