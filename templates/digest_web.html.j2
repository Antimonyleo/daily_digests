  {% set reader_notes = namespace(values=[]) %}
  {% for note in daily_notes[:32] %}{% set reader_notes.values = reader_notes.values + [note[:2000]] %}{% endfor %}
  <script type="application/json" id="reading-personalization">{{ {"name": (profile_name|default("", true))[:200], "notes": reader_notes.values}|tojson }}</script>

  <details class="about-brew">
    <summary>
      <span>About this digest</span>
      <span class="about-summary">{{ summarizer_label }} · personalization and diagnostics</span>
    </summary>
    <div class="about-body">
  <aside class="learning-summary source-coverage" aria-label="Your reading feedback">
    <h3 class="about-heading">Your feedback</h3>
    {% if learned_profile_note %}<p class="learned-profile-note">{{ learned_profile_note }}</p>{% endif %}
    <p id="learning-summary-message">{% if ranking_status.blocked | default(false) or has_helpful_ratings %}{{ ranking_status.learning_message | default(ranking_status.message) }}{% else %}Rate a paper to help shape future digests.{% endif %}</p>
    <p id="usefulness-summary"{% if not feedback_summary.rated %} hidden{% endif %}>{% if feedback_summary.rated %}{{ feedback_summary.useful }} useful of {{ feedback_summary.rated }} rated picks in this digest · {{ feedback_summary.unrated }} unrated.{% endif %}</p>
    <a href="/reading/study">Review useful picks per digest</a>
    <details><summary>What the feedback means</summary><p>Keyboard: <kbd>j</kbd> and <kbd>k</kbd> move between items, <kbd>1</kbd>–<kbd>4</kbd> rate the current item from Very relevant to Not relevant, and <kbd>s</kbd> saves it.</p><p>Interested, on funding, calls and events, tracks that item’s deadline: it appears under Coming deadlines on every digest and on the Saved page until you untick it.</p><p>Ratings shape future digests. Less relevant and Not relevant push similar papers down; the reason you pick tells DailyDigest whether it was the topic, the level or access.</p><p>Useful counts Relevant and Very relevant ratings. Rating doesn’t reorder the digest you’re reading, and an unrated paper counts as unknown, not as a miss.</p></details>
  </aside>
  {% if interest_coverage %}
  <section class="source-coverage" aria-label="Your configured interests">
    <details><summary>Your interests · {{ interest_coverage|length }} configured</summary>
      <p>Counts are for this saved digest, which may be older than your latest settings. Percentages set relative emphasis, not a number of slots, so a topic with no pick here may still have matching papers.</p>
      <ul>{% for interest in interest_coverage %}
        <li><strong>{{ interest.title }} · {% if interest.selected is not none %}{{ interest.selected }} selected{% else %}Attribution not recorded{% endif %}</strong>
          {% if interest.candidates is not none %}<span>{{ interest.candidates }} scored matches · {{ interest.eligible }} passed eligibility{% if interest.queries %} · Searches: {{ interest.queries|join(', ') }}{% endif %}</span>{% endif %}
          <span>{{ interest.explanation }}</span>
          {% for search in interest.searches|default([]) %}<span>{{ search.source }}: {{ search.status }}{% if search.status in ['completed', 'limited'] and search.returned_count == 0 %} · 0 papers returned by this search{% endif %}{% if search.query %} · Searched: <code>{{ search.query }}</code>{% endif %}.{% for warning in search.warnings|default([]) %} Provider notice: {{ warning }}.{% endfor %}</span>{% endfor %}
          {% if interest.rejections %}<span>Not selected: {% for stage, count in interest.rejections.items() %}{{ stage|replace('_', ' ') }} {{ count }}{% if not loop.last %}; {% endif %}{% endfor %}.</span>{% endif %}
        </li>{% endfor %}</ul>
    </details>
  </section>
  {% endif %}

  {% if source_coverage is defined %}
  <section id="source-details" class="source-coverage" aria-label="Source coverage and freshness">
    <h3 class="about-heading">Latest source check</h3>
    {% if source_coverage.total %}
      <p>{{ source_coverage.responded }} of {{ source_coverage.total }} sources responded{% if source_coverage.unavailable %} · {{ source_coverage.unavailable }} unavailable{% endif %}{% if source_coverage.limited %} · {{ source_coverage.limited }} returned limited results{% endif %}{% if source_coverage.unknown %} · {{ source_coverage.unknown }} unknown{% endif %}.</p>
      <p class="source-check-time">Checked <time datetime="{{ source_coverage.checked_at }}">{{ source_coverage.checked_label }}</time>{% if source_coverage.public_oldest_label %} · Oldest public feed update: {{ source_coverage.public_oldest_label }}{% endif %}</p>
      {% if source_coverage.checked_stale or source_coverage.public_stale %}<p>The check or public feed data is over 24 hours old. Brew again to check for updates.</p>{% endif %}
      <details><summary>See source details</summary><ul>
        {% for row in source_coverage.rows %}<li><strong>{{ row.name }}</strong><span>{{ row.status }} · {{ row.freshness }}</span></li>{% endfor %}
      </ul></details>
      {% if source_coverage.authors %}
      <details><summary>Researchers to follow</summary>
        <p>Identity checks · {{ source_coverage.checked_label }}. A resolved name does not guarantee complete publication coverage.</p>
        <ul>{% for author in source_coverage.authors %}<li><strong>{{ author.name }}</strong><span>{{ author.status }}</span></li>{% endfor %}</ul>
      </details>
      {% endif %}
      <p class="source-check-time">This is the latest check, including failed attempts. Feed update times are separate from paper publication dates.</p>
    {% else %}
      <p>No source check recorded yet. Brew a digest to check your selected sources.</p>
    {% endif %}
  </section>
  {% endif %}




    <section class="ranking-panel" aria-live="polite">
      <h3 class="ranking-kicker about-heading">Personalization</h3>
      <div class="ranking-counts" id="ranking-counts"{% if not has_helpful_ratings %} hidden{% endif %}>
        <span class="count-pill good">Relevant <span id="vote-good">{{ rating_counts.good | default(0) }}</span></span>
        <span class="count-pill bad">Not relevant <span id="vote-bad">{{ rating_counts.bad | default(0) }}</span></span>
        <span class="count-pill">Helpful ratings <span id="vote-signed">{{ rating_counts.signed | default(0) }}</span><span id="vote-threshold-part"{% if (rating_counts.signed | default(0)) >= (ranking_status.min_votes_for_lr | default(0)) %} hidden{% endif %}> of <span id="vote-threshold">{{ ranking_status.min_votes_for_lr }}</span> needed</span></span>
      </div>
      <div class="ranking-message" id="ranking-message">
        {{ ranking_status.message }}
      </div>
      <button class="btn primary" id="train-ranker-btn" type="button"{% if not ranking_status.can_train %} disabled{% endif %}>Refresh calibration</button>
