    const rate = createRatingQueue({
      initial:itemEl.dataset.currentGrade || null,
      select:grade => setActive(itemEl, grade),
      send:async grade => responsePayload(await fetch(`/vote/${itemEl.dataset.itemId}${grade === null ? '' : '/' + grade}`, {
        method:grade === null ? 'DELETE' : 'POST', headers:{'X-CSRF-Token':CSRF_TOKEN},
      })),
      committed:(_payload, grade) => {
        if (!NEGATIVE_GRADES.has(String(grade))) itemEl.querySelectorAll('.reason-chip.active').forEach(chip => {
          chip.classList.remove('active'); chip.setAttribute('aria-pressed', 'false');
        });
      },
      busy:saving => {
        setSaving(itemEl, saving);
        itemEl.querySelectorAll('.vote-btn').forEach(button => {button.disabled = false;});
        if (saving) setStatus(itemEl, 'Recording response…', '');
      },
      success:(payload, grade) => {
        setFeedbackPending(itemEl, grade !== null); applyReaderFilters(); updateRankingStatus(payload.ranking_status);
        if (grade === null) {
          setStatus(itemEl, payload.storagePending ? 'Rating cleared · saving browser copy…' : 'Rating cleared; saved reading is unchanged.', payload.storagePending ? 'pending' : 'saved');
          itemEl.querySelector('.vote-btn')?.focus();
          return;
        }
        setStatus(itemEl, payload.storagePending ? `${GRADE_LABEL[grade]} recorded · saving browser copy…` : "Rating recorded.", payload.storagePending ? 'pending' : 'saved');
        showToast(`${GRADE_LABEL[grade]} response recorded`);
      },
      failure:error => {setStatus(itemEl, 'Response was not saved. ' + error.message, 'error'); flash(itemEl);},
    });
    itemEl.querySelectorAll('.vote-btn').forEach(button => {
      button.addEventListener('click', () => {void rate(button.dataset.grade);});
    });
    const doneButton = itemEl.querySelector(".feedback-done");
    if (doneButton) doneButton.addEventListener("click", () => {
      setFeedbackPending(itemEl, false);
      applyReaderFilters();
      if (itemEl.hidden) {
        const next = document.querySelector(".item:not([hidden]) .vote-btn") || document.querySelector(".filter-chip");
        if (next) next.focus();
      }
    });
    const clearButton = itemEl.querySelector(".clear-rating");
    if (clearButton) clearButton.addEventListener('click', () => {void rate(null);});
    itemEl.querySelectorAll(".reason-chip").forEach((chip) => {
      chip.addEventListener("click", async () => {
        const id = itemEl.dataset.itemId;
        const reason = chip.dataset.reason;
        const removing = chip.classList.contains("active");
        if (!removing && !reasonFeedbackEnabled(itemEl)) {
          setStatus(itemEl, "Choose Less relevant or Not relevant before adding a reason.", "");
          showToast("Choose a read response first");
          return;
        }
        setSaving(itemEl, true);
        setStatus(itemEl, removing ? "Removing reason..." : "Saving reason...", "");
        try {
          const r = await fetch(`/vote/${id}/reason/${reason}`, {
            method: removing ? "DELETE" : "POST",
            headers: { "X-CSRF-Token": CSRF_TOKEN },
          });
          const payload = await responsePayload(r);
          chip.classList.toggle("active", !removing);
          chip.setAttribute("aria-pressed", removing ? "false" : "true");
          const stamp = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
          const message = payload.storagePending
            ? `${removing ? "Reason removed" : "Reason recorded"} · saving browser copy…`
            : `${removing ? "Reason removed" : "Reason saved"} at ${stamp}`;
          setStatus(itemEl, message, payload.storagePending ? "pending" : "saved");
          showToast(message);
        } catch (e) {
          setStatus(itemEl, "Reason change was not saved. " + e.message, "error");
          flash(itemEl);
        } finally {
          setSaving(itemEl, false);
        }
      });
    });
  });

  if (trainBtn) {
    trainBtn.addEventListener("click", async () => {
      trainBtn.disabled = true;
      const oldText = trainBtn.textContent;
      trainBtn.textContent = "Updating...";
      let keepDisabled = false;
      try {
        const r = await fetch("/ranking/train", {
          method: "POST",
          headers: { "X-CSRF-Token": CSRF_TOKEN },
        });
        if (!r.ok) throw new Error("HTTP " + r.status);
        const payload = await r.json();
        updateRankingStatus(payload.status);
        keepDisabled = Boolean(payload.running);
        if (payload.running && trainBtn) {
          trainBtn.disabled = true;
          pollTrainingStatus();
        }
        showToast(payload.message || (payload.ok ? "Ranking update started" : "Ranking was not updated"));
      } catch (e) {
        showToast("Ranking update failed");
      } finally {
        trainBtn.textContent = oldText;
        if (!keepDisabled) trainBtn.disabled = false;
      }
    });
  }

})();
</script>
{% endblock %}
