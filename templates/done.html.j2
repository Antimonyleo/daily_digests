{% extends "_base.html.j2" %}
{% block title %}Your tea is ready ☕{% endblock %}
{% block extra_styles %}
  .card { padding: 48px 24px; text-align: center; }
  h1 { font-size: 26px; margin: 8px 0 8px 0; }
  .summary {
    color: var(--muted); font-size: 14px; margin: 0 auto 28px;
    max-width: 460px; line-height: 1.6;
  }
  .digest-id { font-family: Menlo, Consolas, monospace; color: var(--accent); }
  a.cta {
    display: inline-block; padding: 14px 24px; font-size: 16px; font-weight: 600;
    background: var(--accent); color: #fff; text-decoration: none; border-radius: 8px;
  }
  a.cta:hover { background: #084d96; }
  .cup-emoji { font-size: 56px; line-height: 1; }
{% endblock %}
{% block body %}
<div class="card">
  <div class="cup-emoji">☕</div>
  <h1>Your morning cup of tea is brewed</h1>
  <p class="summary">
    <span class="digest-id">{{ digest_id }}</span>:
    {{ total_items }} items across Research / Industry / Regulatory / World.
  </p>
  <a class="cta" href="/">Take me there →</a>
  <div style="margin-top:16px;">
    <a href="/run" style="font-size:13px;color:var(--accent);">Run again</a>
    &middot;
    <a href="/setup" style="font-size:13px;color:var(--muted);">Settings</a>
  </div>
</div>
{% endblock %}
