  <section class="tea-break" id="tea-break" data-note-kind="{{ 'joke' if daily_note.startswith('Lab joke') else 'fact' }}" aria-label="Pip">
    <div class="pip-stage">
      <button class="tea-leaf-drop" id="tea-another" type="button" aria-label="Drop a tea leaf into Pip’s cup for another science fact or joke" title="Drop a tea leaf into Pip’s cup">
        <span class="tea-leaf-shape" aria-hidden="true"></span>
      </button>
      <div class="tea-pet" id="tea-pet" role="button" tabindex="0" aria-label="Pip. Select for a fact or joke; drag or use arrow keys to move." aria-expanded="false" aria-controls="pip-dialog" aria-describedby="pip-move-help">
        <span class="pet-steam one"></span><span class="pet-steam two"></span>
        <span class="pet-cup" aria-hidden="true">
          <span class="pet-rim"><span class="pet-ripple"></span></span>
          <span class="pet-eye left"></span><span class="pet-eye right"></span>
          <span class="pet-cheek left"></span><span class="pet-cheek right"></span><span class="pet-mouth"></span>
        </span>
        <span class="pet-saucer"></span>
      </div>
      <span class="tea-leaf-count" aria-label="Tea leaves given to Pip"><span id="tea-leaf-count">0</span>/10</span>
    </div>
    <span class="sr-only" id="pip-move-help">Enter opens a fact or joke. Arrow keys move Pip, Home resets the position, and Escape closes the note.</span>
    <div class="tea-dialog" id="pip-dialog">
      <span class="tea-break-copy" id="tea-note-text" aria-live="polite">{{ daily_note }}</span>
    </div>
  </section>
