<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" id="theme-color" content="#256f52">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/app-icon.svg" type="image/svg+xml">
<script>
  try {
    const savedTheme = localStorage.getItem("dailydigest-theme");
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    document.documentElement.dataset.theme = savedTheme || (prefersDark ? "dark" : "light");
    const savedDisplay = localStorage.getItem("dailydigest-display");
    document.documentElement.dataset.display = savedDisplay === "compact" ? "compact" : "comfortable";
  } catch (_) {}
</script>
<title>{% block title %}DailyDigest{% endblock %}</title>
<style>
  :root {
    --bg: #f6f7f4;
    --card: #ffffff;
    --panel: #fbfcf9;
    --border: #dde3dc;
    --muted: #657169;
    --text: #15221b;
    --accent: #256f52;
    --accent-strong: #174d39;
    --accent-soft: #e8f3ec;
    --gold: #b87918;
    --gold-soft: #fff5dd;
    --up: #1f7a4d;
    --neutral: #63706a;
    --down: #b4493d;
    --flash: #fff1ed;
    --shadow: 0 18px 50px rgba(21, 34, 27, 0.08);
    --bg-top: #eef5f0;
    --surface-muted: #eef1ed;
    --surface-hover: #f8faf7;
    --border-soft: #edf1ec;
    --copy-secondary: #334238;
    --ambient-mint: rgba(71, 150, 108, 0.16);
    --ambient-gold: rgba(223, 176, 85, 0.13);
    --ambient-blue: rgba(92, 145, 179, 0.10);
    --ambient-dot: rgba(37, 111, 82, 0.14);
  }
  html[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0e1511;
    --card: #151f19;
    --panel: #111a15;
    --border: #314038;
    --muted: #9caaa1;
    --text: #edf4ef;
    --accent: #66b58d;
    --accent-strong: #92d2ac;
    --accent-soft: #1b3426;
    --gold: #d5a552;
    --gold-soft: #3a2d16;
    --up: #77c69a;
    --neutral: #a8b2ac;
    --down: #ef8b7f;
    --flash: #3d211f;
    --shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
    --bg-top: #17231c;
    --surface-muted: #202c25;
    --surface-hover: #1a2720;
    --border-soft: #28362e;
    --copy-secondary: #c5d0c9;
    --ambient-mint: rgba(102, 181, 141, 0.11);
    --ambient-gold: rgba(213, 165, 82, 0.08);
    --ambient-blue: rgba(92, 145, 179, 0.07);
    --ambient-dot: rgba(146, 210, 172, 0.11);
  }
  * { box-sizing: border-box; }
  body {
    position: relative; min-height: 100vh; margin: 0; overflow-x: hidden;
    background:
      linear-gradient(180deg, var(--bg-top) 0%, var(--bg) 260px);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  body::before, body::after {
    content: ""; position: fixed; inset: 0; z-index: 0; pointer-events: none;
  }
  body::before {
    background:
      radial-gradient(circle at 8% 7%, var(--ambient-mint), transparent 25%),
      radial-gradient(circle at 92% 12%, var(--ambient-gold), transparent 22%),
      radial-gradient(circle at 78% 72%, var(--ambient-blue), transparent 24%);
  }
  body::after {
    height: 430px;
    background-image: radial-gradient(circle, var(--ambient-dot) 1px, transparent 1.4px);
    background-size: 34px 34px;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 88%);
    mask-image: linear-gradient(to bottom, #000, transparent 88%);
  }
  .wrap { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; padding: 28px 16px 78px; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px; border-bottom: 1px solid var(--border-soft);
  }
  .header .title { font-size: 12px; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
  .header .digest-id { font-size: 20px; font-weight: 600; margin-top: 2px; }
  .footer { padding: 14px 24px; border-top: 1px solid var(--border-soft); font-size: 11px; color: var(--muted); }
  code { background: var(--surface-muted); padding: 1px 4px; border-radius: 3px; font-size: 12px; }
  a { color: var(--accent); }
  button, input, textarea, select { font: inherit; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 38px; padding: 8px 13px;
    border: 1px solid var(--border); border-radius: 8px;
    background: var(--card); color: var(--text); text-decoration: none;
    cursor: pointer; font-weight: 650; font-size: 13px;
  }
  .btn:hover { border-color: var(--accent); background: var(--surface-hover); }
  .btn.primary {
    background: var(--accent); border-color: var(--accent); color: #fff;
  }
  .btn.primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); }
  html[data-theme="dark"] .btn.primary { color: #0e1a13; }
  .app-utilities {
    position: fixed; right: 14px; bottom: 14px; z-index: 40;
    display: flex; flex-direction: column; gap: 6px; align-items: flex-end;
  }
  .app-utility {
    min-height: 34px; padding: 6px 9px; border: 1px solid var(--border);
    border-radius: 999px; background: var(--card); color: var(--muted);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12); cursor: pointer;
    font-size: 12px; font-weight: 740;
  }
  .app-utility:hover { color: var(--text); border-color: var(--accent); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  [hidden] { display: none !important; }
  @keyframes ambient-arrive {
    from { opacity: 0; transform: scale(1.035); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: no-preference) {
    body::before { animation: ambient-arrive 2.8s ease-out 1 both; }
  }
  @media (max-width: 680px) {
    .app-utilities {
      position: static; flex-direction: row; justify-content: center; align-items: center;
      margin: -58px 0 16px; padding: 0 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  {% block extra_styles %}{% endblock %}
</style>
</head>
<body>
<div class="wrap">
  {% block body %}{% endblock %}
</div>
<div class="app-utilities" aria-label="Display and installation controls">
  <button class="app-utility" id="install-app" type="button" aria-describedby="install-app-help" title="Add a desktop shortcut. DailyDigest must still be running on this computer." hidden>Add to desktop</button>
  <span class="sr-only" id="install-app-help">Adds a standalone app shortcut. It does not install or start the DailyDigest server.</span>
  <button class="app-utility" id="display-toggle" type="button" aria-pressed="false" hidden>Compact view</button>
  <button class="app-utility" id="theme-toggle" type="button" aria-pressed="false">Night theme</button>
</div>
<script>
(function () {
  const root = document.documentElement;
  const themeButton = document.getElementById("theme-toggle");
  const displayButton = document.getElementById("display-toggle");
  const themeColor = document.getElementById("theme-color");
  function applyTheme(theme) {
    const dark = theme === "dark";
    root.dataset.theme = dark ? "dark" : "light";
    themeButton.setAttribute("aria-pressed", dark ? "true" : "false");
    if (themeColor) themeColor.content = dark ? "#151f19" : "#256f52";
  }
  applyTheme(root.dataset.theme || "light");
  themeButton.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    try { localStorage.setItem("dailydigest-theme", next); } catch (_) {}
    applyTheme(next);
  });

  function applyDisplay(display) {
    const compact = display === "compact";
    root.dataset.display = compact ? "compact" : "comfortable";
    displayButton.setAttribute("aria-pressed", compact ? "true" : "false");
    displayButton.textContent = compact ? "Comfortable view" : "Compact view";
    displayButton.title = compact ? "Show the full reading layout" : "Fit more recommendations on screen";
  }
  applyDisplay(root.dataset.display || "comfortable");
  displayButton.addEventListener("click", () => {
    const next = root.dataset.display === "compact" ? "comfortable" : "compact";
    try { localStorage.setItem("dailydigest-display", next); } catch (_) {}
    applyDisplay(next);
  });

  let installPrompt = null;
  const installButton = document.getElementById("install-app");
  window.addEventListener("beforeinstallprompt", (event) => {
    event.preventDefault();
    installPrompt = event;
    installButton.hidden = false;
  });
  installButton.addEventListener("click", async () => {
    if (!installPrompt) return;
    installPrompt.prompt();
    await installPrompt.userChoice;
    installPrompt = null;
    installButton.hidden = true;
  });
  window.addEventListener("appinstalled", () => { installButton.hidden = true; });
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker.register("/sw.js").catch(() => {});
    });
  }
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
