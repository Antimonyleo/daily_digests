<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" id="theme-color" content="#256f52">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/app-icon.svg" type="image/svg+xml">
<script>
  try {
    const savedTheme = localStorage.getItem("dailydigest-theme");
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    document.documentElement.dataset.theme = savedTheme || (prefersDark ? "dark" : "light");
    const savedDisplay = localStorage.getItem("dailydigest-display");
    document.documentElement.dataset.display = savedDisplay === "compact" ? "compact" : "comfortable";
    document.documentElement.dataset.pip = localStorage.getItem("dailydigest-pip") === "hidden" ? "hidden" : "visible";
  } catch (_) {}
</script>
<title>{% block title %}DailyDigest{% endblock %}</title>
<style>
{% include "_design_tokens.css.j2" %}
  * { box-sizing: border-box; }
  .article-figure { margin-top: 12px; font-size: 14px; }
  .article-figure summary { cursor: pointer; min-height: 44px; padding: 10px 0; }
  .article-figure figure { margin: 8px 0; }
  .article-figure img { display: block; width: auto; max-width: 100%; height: auto; max-height: 70vh; object-fit: contain; }
  .article-figure img[hidden], .figure-unavailable[hidden] { display: none; }
  .figure-retry { min-height: 44px; padding: 4px 12px; color: var(--accent); background: var(--card); border: 1px solid var(--border); border-radius: 6px; cursor: pointer; }
  .article-figure figcaption, .figure-hint { color: var(--muted); font-size: 12px; }
  @media print { .article-figure { display: none; } }
{% include "_reading_surface.css.j2" %}
  .wrap { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; padding: 28px 16px 78px; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px; border-bottom: 1px solid var(--border-soft);
  }
  .header .title { font-size: 12px; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
  .header .digest-id { font-size: 20px; font-weight: 600; margin-top: 2px; }
  .footer { padding: 14px 24px; border-top: 1px solid var(--border-soft); font-size: 12px; color: var(--muted); }
  code { background: var(--surface-muted); padding: 1px 4px; border-radius: 3px; font-size: 12px; }
  a { color: var(--accent); }
  :where(a, button, input, textarea, select, summary):focus-visible {
    outline: 2px solid var(--accent); outline-offset: 3px;
  }
  .skip-link {
    position: fixed; top: 8px; left: 14px; z-index: 80;
    padding: 10px 14px; border-radius: 8px; background: var(--card);
    transform: translateY(calc(-100% - 16px)); clip-path: inset(50%);
  }
  .skip-link:focus { transform: translateY(0); clip-path: none; }
  button, input, textarea, select { font: inherit; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 38px; padding: 8px 13px;
    border: 1px solid var(--control-border); border-radius: 8px;
    background: var(--card); color: var(--text); text-decoration: none;
    cursor: pointer; font-weight: 600; font-size: 14px;
  }
  .btn:hover { border-color: var(--accent); background: var(--surface-hover); }
  .btn.primary {
    background: var(--accent); border-color: var(--accent); color: #fff;
  }
  .btn.primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); }
  html[data-theme="dark"] .btn.primary { color: #0e1a13; }
  /* Display stays reachable at the viewport's bottom-right on every reading
     path. Safe-area insets keep it off notches and home indicators; the
     --dd-vv-* offsets follow a pinch-zoomed mobile visual viewport. */
  .app-utilities {
    position: fixed; z-index: 60; width: max-content; margin: 0;
    right: calc(max(16px, env(safe-area-inset-right, 0px) + 10px) + var(--dd-vv-right, 0px));
    bottom: calc(max(16px, env(safe-area-inset-bottom, 0px) + 10px) + var(--dd-vv-bottom, 0px));
  }
  .app-utility {
    min-height: 38px; padding: 8px 13px; border: 1px solid var(--border);
    border-radius: 999px; background: var(--card); color: var(--muted);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12); cursor: pointer;
    font-size: 12px; font-weight: 740;
  }
  .app-utility:hover { color: var(--text); border-color: var(--accent); }
  /* Back to top sits just above Display once the reader has scrolled. */
  .back-to-top {
    position: fixed; z-index: 60;
    right: calc(max(16px, env(safe-area-inset-right, 0px) + 10px) + var(--dd-vv-right, 0px));
    bottom: calc(max(16px, env(safe-area-inset-bottom, 0px) + 10px) + var(--dd-vv-bottom, 0px) + 48px);
  }
  /* On a phone, beside Display rather than above it: one row of controls
     covers less of the card being read. Display is about 86px wide. */
  @media (max-width: 760px) {
    .back-to-top {
      right: calc(max(16px, env(safe-area-inset-right, 0px) + 10px) + var(--dd-vv-right, 0px) + 94px);
      bottom: calc(max(16px, env(safe-area-inset-bottom, 0px) + 10px) + var(--dd-vv-bottom, 0px));
    }
  }
  .app-utilities > summary { display: flex; align-items: center; gap: 9px; list-style: none; }
  .app-utilities > summary::-webkit-details-marker { display: none; }
  .app-utilities > summary::after { content: "+"; color: var(--accent); }
  .app-utilities[open] > summary::after { content: "−"; }
  .app-display-options {
    position: absolute; bottom: calc(100% + 8px); right: 0;
    display: flex; flex-direction: column; gap: 4px;
    width: 240px; max-width: calc(100vw - 32px); padding: 8px;
    max-height: calc(100vh - 100px); max-height: calc(100dvh - 100px); overflow-y: auto;
    border: 1px solid var(--border); border-radius: 12px;
    background: var(--card); box-shadow: var(--shadow);
  }
  .app-display-options .app-utility {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    min-height: 40px; border: 0; border-radius: 6px; box-shadow: none;
    background: transparent; color: var(--text); text-align: left;
  }
  .app-display-options .app-utility:hover { background: var(--surface-hover); }
  .app-display-options [aria-pressed]::after {
    content: "Off"; color: var(--muted); font-size: 12px; font-weight: 500;
  }
  .app-display-options [aria-pressed="true"]::after { content: "On"; color: var(--accent); }
  html[data-pip="hidden"] .tea-break { display: none; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  [hidden] { display: none !important; }
  @keyframes ambient-arrive {
    from { opacity: 0; transform: scale(1.035); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: no-preference) {
    body::before { animation: ambient-arrive 2.8s ease-out 1 both; }
  }
  @media (pointer: coarse) {
    .btn, .app-utility, .app-display-options .app-utility { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  @media print {
    body { background: white; color: black; }
    body::before, body::after, .actions, .app-utilities, .vote-row, .reason-block,
    .feedback-actions, .item-head-actions, .tea-break, .reader-toolbar, .brew-choice,
    .compact-brew-form, .toast, .skip-link, .settings-actions, .back-to-top { display: none !important; }
    .wrap { max-width: none; padding: 0; }
    .card, .digest-card, .item { box-shadow: none; break-inside: avoid; }
    details > :not(summary) { display: block !important; }
    a { color: black; }
  }
  {% block extra_styles %}{% endblock %}
  {% if request is defined and request.url.path in ['/setup', '/saved'] %}{% include "_pip.css.j2" %}{% endif %}
  button:not(.active):not([aria-pressed="true"]), input, select, textarea { border-color: var(--control-border); }
  button, summary, input:not([type="checkbox"]):not([type="radio"]), select { min-height: 44px; }

</style>
</head>
<body>
<a class="skip-link" href="#page-content">Skip to content</a>
{% if local_updates_enabled is defined and local_updates_enabled() %}{% include "_update_notice.html.j2" %}{% endif %}
<main class="wrap" id="page-content" tabindex="-1">
  {% block body %}{% endblock %}
</main>
{% if request is defined and request.url.path in ['/setup', '/saved'] %}
{% set shared_pip_notes = pip_notes() %}
{% with daily_note=shared_pip_notes[0] %}{% include "_pip.html.j2" %}{% endwith %}
{% endif %}
<details class="app-utilities" id="display-menu">
  <summary class="app-utility" aria-label="Display" id="display-menu-toggle" aria-controls="display-options">Display</summary>
  <div class="app-display-options" id="display-options" role="group" aria-label="Display preferences">
    <button class="app-utility" id="theme-toggle" type="button" aria-label="Night theme" aria-pressed="false">Night theme</button>
    <button class="app-utility" id="display-toggle" type="button" aria-label="Compact view" aria-pressed="false" hidden>Compact view</button>
    <button class="app-utility" id="pip-toggle" type="button" aria-label="Show Pip" aria-pressed="true" hidden>Show Pip</button>
    <button class="app-utility" id="install-app" type="button" aria-describedby="install-app-help" title="Add a desktop shortcut. DailyDigest must still be running on this computer." hidden>Add to desktop</button>
    <span id="install-app-help" hidden>Adds a standalone app shortcut. It does not install or start the DailyDigest server.</span>
  </div>
</details>
<button class="app-utility back-to-top" id="back-to-top" type="button" aria-label="Back to top" hidden>↑ Top</button>
<script>
{% include "_rating_queue.js.j2" %}
(function () {
  const root = document.documentElement;
  const themeButton = document.getElementById("theme-toggle");
  const displayButton = document.getElementById("display-toggle");
  const themeColor = document.getElementById("theme-color");
  const displayMenu = document.getElementById("display-menu");
  // Keep the fixed control inside a pinch-zoomed visual viewport. Without
  // zoom the offsets stay zero, so an on-screen keyboard does not lift it.
  const visual = window.visualViewport;
  function followVisualViewport() {
    const zoomed = visual && visual.scale > 1.01;
    const right = zoomed ? Math.max(0, window.innerWidth - visual.offsetLeft - visual.width) : 0;
    const bottom = zoomed ? Math.max(0, window.innerHeight - visual.offsetTop - visual.height) : 0;
    root.style.setProperty("--dd-vv-right", `${Math.round(right)}px`);
    root.style.setProperty("--dd-vv-bottom", `${Math.round(bottom)}px`);
  }
  if (visual && root.style) {
    visual.addEventListener("resize", followVisualViewport);
    visual.addEventListener("scroll", followVisualViewport);
    followVisualViewport();
  }
  displayMenu.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !displayMenu.open) return;
    event.preventDefault();
    displayMenu.open = false;
    document.getElementById("display-menu-toggle").focus();
  });
  function dismissDisplayMenu(event) {
    if (!displayMenu.contains(event.target)) displayMenu.open = false;
  }
  document.addEventListener("pointerdown", dismissDisplayMenu);
  document.addEventListener("focusin", dismissDisplayMenu);
  // Shown after about a screen of scrolling; returns focus to the page start.
  const backToTop = document.getElementById("back-to-top");
  function syncBackToTop() { backToTop.hidden = window.scrollY < window.innerHeight; }
  window.addEventListener("scroll", syncBackToTop, { passive: true });
  window.addEventListener("resize", syncBackToTop);
  syncBackToTop();
  backToTop.addEventListener("click", () => {
    const smooth = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.scrollTo({ top: 0, behavior: smooth ? "smooth" : "auto" });
    document.getElementById("page-content").focus({ preventScroll: true });
  });
  function applyTheme(theme) {
    const dark = theme === "dark";
    root.dataset.theme = dark ? "dark" : "light";
    themeButton.setAttribute("aria-pressed", dark ? "true" : "false");
    if (themeColor) themeColor.content = dark ? "#151f19" : "#256f52";
  }
  applyTheme(root.dataset.theme || "light");
  themeButton.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    try { localStorage.setItem("dailydigest-theme", next); } catch (_) {}
    applyTheme(next);
  });

  function applyDisplay(display) {
    const compact = display === "compact";
    root.dataset.display = compact ? "compact" : "comfortable";
    displayButton.setAttribute("aria-pressed", compact ? "true" : "false");
    displayButton.textContent = "Compact view";
    displayButton.title = "Fit more recommendations on screen";
  }
  applyDisplay(root.dataset.display || "comfortable");
  displayButton.addEventListener("click", () => {
    const next = root.dataset.display === "compact" ? "comfortable" : "compact";
    try { localStorage.setItem("dailydigest-display", next); } catch (_) {}
    applyDisplay(next);
  });

  const pipButton = document.getElementById("pip-toggle");
  function applyPip(visibility) {
    const visible = visibility !== "hidden";
    root.dataset.pip = visible ? "visible" : "hidden";
    pipButton.setAttribute("aria-pressed", visible ? "true" : "false");
  }
  pipButton.hidden = !document.querySelector(".tea-break");
  applyPip(root.dataset.pip);
  pipButton.addEventListener("click", () => {
    const next = root.dataset.pip === "hidden" ? "visible" : "hidden";
    try { localStorage.setItem("dailydigest-pip", next); } catch (_) {}
    applyPip(next);
    document.dispatchEvent(new Event("pipvisibilitychange"));
  });

  let installPrompt = null;
  const installButton = document.getElementById("install-app");
  window.addEventListener("beforeinstallprompt", (event) => {
    event.preventDefault();
    installPrompt = event;
    installButton.hidden = false;
  });
  installButton.addEventListener("click", async () => {
    if (!installPrompt) return;
    installPrompt.prompt();
    await installPrompt.userChoice;
    installPrompt = null;
    installButton.hidden = true;
  });
  window.addEventListener("appinstalled", () => { installButton.hidden = true; });
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker.register("/sw.js").catch(() => {});
    });
  }
})();
</script>
<script>
  document.querySelectorAll('.article-figure').forEach(preview => {
    const image = preview.querySelector('img[data-src]');
    if (!image) return;
    const unavailable = preview.querySelector('.figure-unavailable');
    const retry = preview.querySelector('.figure-retry');
    let state = 'idle';
    let restoreFocus = false;
    const load = () => {
      if (!preview.open || state === 'loading') return;
      restoreFocus = document.activeElement === retry;
      state = 'loading';
      unavailable.hidden = true;
      image.hidden = false;
      image.removeAttribute('src');
      image.src = image.dataset.src;
    };
    image.addEventListener('error', () => {
      state = 'error';
      image.hidden = true;
      unavailable.hidden = false;
      if (restoreFocus) retry.focus();
    });
    image.addEventListener('load', () => {
      state = 'loaded';
      image.hidden = false;
      unavailable.hidden = true;
      if (restoreFocus) preview.querySelector('.figure-link').focus();
    });
    retry.addEventListener('click', load);
    preview.addEventListener('toggle', () => { if (state === 'idle') load(); });
  });
</script>
{% block scripts %}{% endblock %}
{% if request is defined and request.url.path in ['/setup', '/saved'] %}
<script>{% include "_pip.js.j2" %}
mountPip(document, {digestId: {{ pip_day()|tojson }}, notes: {{ shared_pip_notes|tojson }}});
</script>
{% endif %}
<script>{% include "_copy_summary.js.j2" %}</script>
<script>{% include "_greeting.js.j2" %}</script>
<script>
// Browser mode owns this check in its outer router. Native pages use navigation protection.
(() => {
  const form = document.querySelector('form[action="/setup"]');
  if (!form || typeof window.ddNavigate === 'function') return;
  const baseline = JSON.stringify([...new FormData(form)]);
  let submitting = false;
  form.addEventListener('submit', () => { submitting = true; });
  window.addEventListener('beforeunload', event => {
    if (!submitting && JSON.stringify([...new FormData(form)]) !== baseline) { event.preventDefault(); event.returnValue = ''; }
  });
})();
</script>
</body>
</html>
