{% extends "_base.html.j2" %}
{% block title %}Set up DailyDigest{% endblock %}
{% block extra_styles %}
  .wrap { max-width: 860px; }
  .card { padding: 28px; }
  .settings-nav { display: flex; justify-content: flex-start; margin-bottom: 18px; }
  h1 { font-size: 30px; line-height: 1.1; margin: 0 0 8px 0; letter-spacing: 0; }
  .lede { color: var(--muted); margin: 0 0 24px 0; font-size: 14px; line-height: 1.5; }
  .step { margin-bottom: 30px; padding-top: 4px; }
  .step h2 { font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase;
             color: var(--muted); margin: 0 0 8px 0; }
  label { display: block; font-size: 13px; font-weight: 600; margin: 12px 0 4px; }
  textarea, input[type="text"], input[type="url"], input[type="password"], input[type="number"], select {
    width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px;
    font-size: 13px; font-family: inherit; background: var(--card); color: var(--text);
  }
  textarea { min-height: 110px; resize: vertical; line-height: 1.5; }
  .hint { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .chip-input {
    border: 1px solid var(--border); border-radius: 6px; padding: 6px;
    background: var(--card); display: flex; flex-wrap: wrap; gap: 4px; align-items: center;
    min-height: 38px;
  }
	  .chip {
	    background: var(--accent-soft); color: var(--accent-strong); border: 0; border-radius: 4px;
	    padding: 3px 8px; font-size: 12px; cursor: pointer; user-select: none;
	    max-width: 100%; overflow-wrap: anywhere; text-align: left;
	  }
	  .chip:hover, .chip:focus { background: #d8e7f5; outline: 2px solid #b9d2c3; outline-offset: 1px; }
  .chip-input input {
    border: none; outline: none; flex: 1; min-width: 100px; font-size: 13px;
    padding: 4px 6px; background: transparent;
  }
  .backends { display: grid; gap: 8px; }
  .backend-opt {
    border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px;
    cursor: pointer; background: var(--card);
  }
  .backend-opt.selected { border-color: var(--accent); background: var(--accent-soft); }
  .backend-opt input[type="radio"] { margin-right: 8px; }
  .backend-opt .desc { font-size: 11px; color: var(--muted); margin-top: 2px;
                       margin-left: 22px; }
  .api-fields { margin-top: 8px; padding: 10px;
                              background: var(--panel); border-radius: 6px;
                              border: 1px dashed var(--border); }
  .api-fields[hidden] { display: none; }
  .field-grid, .size-grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;
  }
  .section-options { display: grid; gap: 10px; margin-top: 12px; }
  .section-option {
    display: grid; grid-template-columns: minmax(0, 1fr) 110px; gap: 16px;
    align-items: center; padding: 12px; border: 1px solid var(--border);
    border-radius: 8px; background: var(--card);
  }
  .section-heading { display: flex; align-items: center; gap: 10px; }
  .section-heading label, .section-heading .section-name { margin: 0; }
  .section-desc { margin: 3px 0 0 48px; color: var(--muted); font-size: 11px; }
  .count-field label { margin-top: 0; }
  .opportunity-profile {
    margin-top: 14px; padding: 16px; border: 1px dashed var(--border);
    border-radius: 8px; background: var(--panel);
  }
  .opportunity-profile[hidden] { display: none; }
  .opportunity-advanced {
    margin-top: 16px; border-top: 1px solid var(--border); padding-top: 12px;
  }
  .opportunity-advanced summary {
    color: var(--accent-strong); cursor: pointer; font-size: 13px; font-weight: 600;
    padding: 4px 0;
  }
  .opportunity-advanced summary:focus-visible {
    outline: 3px solid #b9d2c3; outline-offset: 3px; border-radius: 3px;
  }
  .opportunity-advanced .hint { margin-bottom: 4px; }
  .opportunity-advanced .field-grid { margin-top: 4px; }
  .switch {
    position: relative; width: 42px; height: 24px; flex: 0 0 auto;
  }
  .switch input {
    position: absolute; width: 1px; height: 1px; opacity: 0;
  }
  .switch-track {
    display: block; width: 42px; height: 24px; border-radius: 12px;
    background: #c9ced3; cursor: pointer; transition: background 120ms ease;
  }
  .switch-track::after {
    content: ""; position: absolute; width: 18px; height: 18px;
    left: 3px; top: 3px; border-radius: 50%; background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.24); transition: transform 120ms ease;
  }
  .switch input:checked + .switch-track { background: var(--accent); }
  .switch input:checked + .switch-track::after { transform: translateX(18px); }
  .switch input:focus-visible + .switch-track {
    outline: 3px solid #b9d2c3; outline-offset: 2px;
  }
  .errors { background: var(--flash); color: var(--down); padding: 10px 12px;
            border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
  button.brew {
    width: 100%; padding: 14px 18px; font-size: 16px; font-weight: 600;
    background: var(--accent); color: #fff; border: none; border-radius: 8px;
    cursor: pointer; margin-top: 8px;
  }
  button.brew:hover { background: var(--accent-strong); }
  html[data-theme="dark"] button.brew { color: #0e1a13; }
  html[data-theme="dark"] .chip:hover,
  html[data-theme="dark"] .chip:focus { background: var(--surface-muted); }
  @media (max-width: 720px) {
    .field-grid, .size-grid, .section-option { grid-template-columns: 1fr; }
  }
{% endblock %}
{% block body %}
<div class="card">
  <nav class="settings-nav" aria-label="Settings navigation">
    <a class="btn" href="/">← Back to today’s digest</a>
  </nav>
  <h1>DailyDigest settings</h1>
  <p class="lede">Tune the profile, summarizer, and section sizes used when brewing a new digest.</p>

  {% if errors %}
	  <div class="errors" role="alert" aria-live="assertive" tabindex="-1">
    {% for e in errors %}<div>{{ e }}</div>{% endfor %}
  </div>
  {% endif %}

	  <form method="post" action="/setup">
	    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" id="user-timezone" name="user_tz" value="{{ form.user_tz }}">
    <div class="step">
      <h2>1 &middot; About you</h2>
      <div class="field-grid">
        <div>
          <label for="name">First name</label>
	          <input id="name" name="name" type="text" autocomplete="given-name" placeholder="Ada" value="{{ form.name }}">
        </div>
      </div>
      <label for="bio">Your bio (3–6 sentences)</label>
      <textarea id="bio" name="bio" placeholder="What do you research? What topics matter most to you?">{{ form.bio }}</textarea>
      <div class="hint">Used to build a vector that ranks items against your interests.</div>

      <label for="topics">Research interests and relative weights</label>
      <textarea id="topics" name="topics" required placeholder="RNA nanotechnology | 17&#10;DNA nanotechnology | 15&#10;Gene therapy | 10">{{ form.topics }}</textarea>
      <div class="hint">Add 1–10 specific interests, one per line. Weights are relative (for example 18, 15, 10), not daily quotas.</div>

      <label for="dw-text">Downweight terms (push these down)</label>
      <div class="chip-input" id="dw-input">
        <input type="text" id="dw-text" placeholder="Type and press comma or Enter…">
      </div>
      <input type="hidden" name="downweight" id="dw-hidden" value="{{ form.downweight }}">
      <div class="hint">Soft penalty applied at ranking time.</div>
    </div>

    <div class="step">
      <h2>2 &middot; Summarizer backend</h2>
      <div class="backends">
        <label class="backend-opt" data-value="extractive">
          <input type="radio" name="llm_backend" value="extractive"
                 {% if form.llm_backend == "extractive" %}checked{% endif %}>
          <strong>Extractive</strong> — recommended for the first run.
          <div class="desc">Free. No account, API key, or paid AI subscription.</div>
        </label>

        <label class="backend-opt" data-value="api">
          <input type="radio" name="llm_backend" value="api"
                 {% if form.llm_backend == "api" %}checked{% endif %}>
          <strong>OpenAI-compatible API</strong> — optional richer summaries.
          <div class="desc">OpenAI, OpenRouter, Ollama, vLLM, or another compatible endpoint. Online providers use separate API billing.</div>
        </label>

        <label class="backend-opt" data-value="anthropic">
          <input type="radio" name="llm_backend" value="anthropic"
                 {% if form.llm_backend == "anthropic" %}checked{% endif %}>
          <strong>Anthropic Claude API</strong> — native Messages API.
          <div class="desc">Uses an Anthropic Console API key and API billing; a Claude chat subscription is not an API key.</div>
        </label>

        <label class="backend-opt" data-value="claude_cli">
          <input type="radio" name="llm_backend" value="claude_cli"
                 {% if form.llm_backend == "claude_cli" %}checked{% endif %}>
          <strong>Signed-in Claude Code</strong> — use your local Claude login.
          <div class="desc">Requires the <code>claude</code> command to be installed and signed in. Tools and session persistence are disabled for summaries.</div>
        </label>

        <label class="backend-opt" data-value="codex_cli">
          <input type="radio" name="llm_backend" value="codex_cli"
                 {% if form.llm_backend == "codex_cli" %}checked{% endif %}>
          <strong>Signed-in Codex</strong> — use your local ChatGPT/Codex login.
          <div class="desc">Requires the <code>codex</code> command to be installed and signed in. Runs ephemerally, read-only, with agent tools disabled.</div>
        </label>
      </div>

      <p class="hint">AI-backed summaries send selected article metadata and your short reader profile to the provider you choose. Extractive stays local.</p>

      <div class="api-fields" id="api-fields" hidden>
        <div id="api-auth-fields">
          <label for="llm_base_url">Base URL</label>
          <input type="url" id="llm_base_url" name="llm_base_url"
                 placeholder="https://api.openai.com/v1" value="{{ form.llm_base_url }}">
          <label for="llm_api_key">API key</label>
          <input type="password" id="llm_api_key" name="llm_api_key"
                 placeholder="Provider API key" value="{{ form.llm_api_key }}">
        </div>
        <label for="llm_model">Model</label>
        <input type="text" id="llm_model" name="llm_model"
               placeholder="gpt-4o-mini" value="{{ form.llm_model }}">
        <div class="hint" id="provider-hint"></div>
      </div>
    </div>

    <div class="step">
      <h2>3 &middot; Digest sections</h2>
      <p class="hint">Research is always included. Choose which additional sections you want to read.</p>
      <div class="size-grid">
        <div>
          <label for="top_research">Research</label>
          <input id="top_research" name="top_research" type="number" min="1" max="30" required value="{{ form.top_research }}">
        </div>
      </div>
      <div class="section-options">
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_industry" value="false">
                <input id="include_industry" name="include_industry" type="checkbox"
                       value="true" role="switch" aria-label="Include Industry"
                       {% if form.include_industry == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_industry" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_industry">Industry</label>
            </div>
            <p class="section-desc">Biotechnology companies, deals, products, and sector developments.</p>
          </div>
          <div class="count-field">
            <label for="top_industry">Maximum items</label>
            <input id="top_industry" name="top_industry" type="number" min="0" max="30"
                   value="{{ form.top_industry }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_ai" value="false">
                <input id="include_ai" name="include_ai" type="checkbox"
                       value="true" role="switch" aria-label="Include AI tools and methods"
                       {% if form.include_ai == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_ai" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_ai">AI tools &amp; methods</label>
            </div>
            <p class="section-desc">Useful models, software, benchmarks, and scientific workflows.</p>
          </div>
          <div class="count-field">
            <label for="top_ai">Maximum items</label>
            <input id="top_ai" name="top_ai" type="number" min="0" max="30"
                   value="{{ form.top_ai }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_regulatory" value="false">
                <input id="include_regulatory" name="include_regulatory" type="checkbox"
                       value="true" role="switch" aria-label="Include Clinical and Regulatory"
                       {% if form.include_regulatory == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_regulatory" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_regulatory">Clinical &amp; Regulatory</label>
            </div>
            <p class="section-desc">Clinical trials, approvals, safety updates, and policy changes.</p>
          </div>
          <div class="count-field">
            <label for="top_regulatory">Maximum items</label>
            <input id="top_regulatory" name="top_regulatory" type="number" min="0" max="30"
                   value="{{ form.top_regulatory }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_world" value="false">
                <input id="include_world" name="include_world" type="checkbox"
                       value="true" role="switch" aria-label="Include World news"
                       {% if form.include_world == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_world" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_world">World news</label>
            </div>
            <p class="section-desc">Major events outside the scientific and biotechnology sections.</p>
          </div>
          <div class="count-field">
            <label for="top_world">Maximum items</label>
            <input id="top_world" name="top_world" type="number" min="0" max="30"
                   value="{{ form.top_world }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_opportunities" value="false">
                <input id="include_opportunities" name="include_opportunities" type="checkbox"
                       value="true" role="switch" aria-label="Include Funding and Opportunities"
                       {% if form.include_opportunities == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_opportunities" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_opportunities">Funding &amp; Opportunities</label>
            </div>
            <p class="section-desc">Grants, fellowships, awards, scholarships, and research support.</p>
          </div>
          <div class="count-field">
            <label for="top_opportunities">Maximum items</label>
            <input id="top_opportunities" name="top_opportunities" type="number" min="0" max="30"
                   value="{{ form.top_opportunities }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_events" value="false">
                <input id="include_events" name="include_events" type="checkbox"
                       value="true" role="switch" aria-label="Include Events and Calls"
                       {% if form.include_events == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_events" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_events">Events &amp; Calls</label>
            </div>
            <p class="section-desc">Conferences, workshops, courses, and calls for papers or abstracts.</p>
          </div>
          <div class="count-field">
            <label for="top_events">Maximum items</label>
            <input id="top_events" name="top_events" type="number" min="0" max="30"
                   value="{{ form.top_events }}">
          </div>
        </div>
      </div>
      <div class="opportunity-profile" id="opportunity-profile"
           {% if form.include_opportunities != "true" and form.include_events != "true" %}hidden{% endif %}>
        <h3>About you for opportunity matching</h3>
        <p class="hint">These details are stored only in your local <code>data/</code> folder. Your weighted research interests above are reused for topical matching, so you do not need to describe your research again.</p>
        <div class="field-grid">
          <div>
            <label for="opportunity-career-stage">Career stage</label>
            <input id="opportunity-career-stage" name="opportunity_career_stage" type="text"
                   data-opportunity-required placeholder="Postdoctoral researcher" value="{{ form.opportunity_career_stage }}">
          </div>
          <div>
            <label for="opportunity-institution-type">Institution type</label>
            <input id="opportunity-institution-type" name="opportunity_institution_type" type="text"
                   data-opportunity-required placeholder="Nonprofit university" value="{{ form.opportunity_institution_type }}">
          </div>
          <div>
            <label for="opportunity-country">Current country</label>
            <input id="opportunity-country" name="opportunity_country" type="text"
                   data-opportunity-required autocomplete="country-name" placeholder="United States" value="{{ form.opportunity_country }}">
          </div>
          <div>
            <label for="opportunity-applicant-role">Applicant role</label>
            <input id="opportunity-applicant-role" name="opportunity_applicant_role" type="text"
                   data-opportunity-required placeholder="Fellow or co-investigator" value="{{ form.opportunity_applicant_role }}">
          </div>
        </div>
        <details class="opportunity-advanced">
          <summary>Optional matching preferences</summary>
          <p class="hint">Add only constraints or preferences that apply to you.</p>
          <div class="field-grid">
            <div>
              <label for="opportunity-types">Opportunity types</label>
              <input id="opportunity-types" name="opportunity_types" type="text"
                     placeholder="grant, fellowship, travel support" value="{{ form.opportunity_types }}">
            </div>
            <div>
              <label for="event-types">Event types</label>
              <input id="event-types" name="event_types" type="text"
                     placeholder="conference, workshop, course" value="{{ form.event_types }}">
            </div>
            <div>
              <label for="event-regions">Event regions</label>
              <input id="event-regions" name="event_regions" type="text"
                     placeholder="North America, Europe, online" value="{{ form.event_regions }}">
            </div>
            <div>
              <label for="event-formats">Event formats</label>
              <input id="event-formats" name="event_formats" type="text"
                     placeholder="in person, online, hybrid" value="{{ form.event_formats }}">
            </div>
            <div>
              <label for="minimum-lead-days">Minimum preparation time (days)</label>
              <input id="minimum-lead-days" name="minimum_lead_days" type="number" min="0" max="365"
                     value="{{ form.minimum_lead_days }}">
            </div>
          </div>
        </details>
      </div>
      <div class="hint">Item counts are caps; DailyDigest will show fewer when there are not enough strong candidates.</div>
    </div>

    <button class="brew" type="submit">Save settings and choose today’s digest</button>
  </form>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
  const timezoneInput = document.getElementById("user-timezone");
  try {
    const browserTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    if (timezoneInput && browserTimezone) timezoneInput.value = browserTimezone;
  } catch (_) {}

  function makeChipInput(wrapId, textId, hiddenId) {
    const wrap = document.getElementById(wrapId);
    const text = document.getElementById(textId);
    const hidden = document.getElementById(hiddenId);
    const chips = [];

    function render() {
      wrap.querySelectorAll(".chip").forEach((c) => c.remove());
      chips.forEach((val, idx) => {
	        const c = document.createElement("button");
	        c.className = "chip";
	        c.type = "button";
	        c.textContent = val + " ✕";
	        c.setAttribute("aria-label", `Remove ${val}`);
	        c.addEventListener("click", () => { chips.splice(idx, 1); render(); });
	        wrap.insertBefore(c, text);
      });
      hidden.value = chips.join(",");
    }

    function add(val) {
      const v = (val || "").trim();
      if (v && !chips.includes(v)) chips.push(v);
      text.value = "";
      render();
    }

    text.addEventListener("keydown", (e) => {
      if (e.key === "," || e.key === "Enter") {
        e.preventDefault();
        add(text.value);
      } else if (e.key === "Backspace" && !text.value && chips.length) {
        chips.pop(); render();
      }
    });
    text.addEventListener("blur", () => { if (text.value.trim()) add(text.value); });

    // Seed from initial hidden value (server-rendered).
    const init = (hidden.value || "").split(",").map((s) => s.trim()).filter(Boolean);
    init.forEach((v) => chips.push(v));
    render();
  }

	  makeChipInput("dw-input", "dw-text", "dw-hidden");

	  const errors = document.querySelector(".errors");
	  if (errors) errors.focus();

  // Backend reveal logic.
  const apiFields = document.getElementById("api-fields");
  const apiAuthFields = document.getElementById("api-auth-fields");
  const baseUrlInput = document.getElementById("llm_base_url");
  const modelInput = document.getElementById("llm_model");
  const providerHint = document.getElementById("provider-hint");
  const radios = document.querySelectorAll('input[name="llm_backend"]');
  const providerDefaults = {
    extractive: { base: "https://api.openai.com/v1", model: "gpt-4o-mini" },
    api: { base: "https://api.openai.com/v1", model: "gpt-4o-mini" },
    anthropic: { base: "https://api.anthropic.com/v1", model: "claude-haiku-4-5-20251001" },
    claude_cli: { base: "", model: "haiku" },
    codex_cli: { base: "", model: "" },
  };
  let activeBackend = (document.querySelector('input[name="llm_backend"]:checked') || {}).value || "extractive";

  function refresh() {
    const sel = document.querySelector('input[name="llm_backend"]:checked');
    const v = sel ? sel.value : "extractive";
    const isApi = v === "api" || v === "anthropic";
    const isCli = v === "claude_cli" || v === "codex_cli";
    apiFields.hidden = !(isApi || isCli);
    apiAuthFields.hidden = !isApi;
    if (v === "anthropic") {
      baseUrlInput.placeholder = "https://api.anthropic.com/v1";
      modelInput.placeholder = "claude-haiku-4-5-20251001";
      providerHint.textContent = "Recommended economical model: Claude Haiku 4.5.";
    } else if (v === "claude_cli") {
      modelInput.placeholder = "haiku (optional; blank uses your Claude default)";
      providerHint.textContent = "Run claude once in a terminal to install/sign in before brewing.";
    } else if (v === "codex_cli") {
      modelInput.placeholder = "optional; blank uses your Codex default";
      providerHint.textContent = "Run codex login status in a terminal to confirm sign-in before brewing.";
    } else {
      baseUrlInput.placeholder = "https://api.openai.com/v1";
      modelInput.placeholder = "gpt-4o-mini";
      providerHint.textContent = "Online API accounts are billed separately from chat subscriptions.";
    }
    document.querySelectorAll(".backend-opt").forEach((opt) => {
      opt.classList.toggle("selected", opt.dataset.value === v);
    });
  }
  radios.forEach((radio) => radio.addEventListener("change", () => {
    const previous = providerDefaults[activeBackend] || providerDefaults.extractive;
    const next = providerDefaults[radio.value] || providerDefaults.extractive;
    if (!modelInput.value.trim() || modelInput.value.trim() === previous.model) {
      modelInput.value = next.model;
    }
    if (!baseUrlInput.value.trim() || baseUrlInput.value.trim() === previous.base) {
      baseUrlInput.value = next.base;
    }
    activeBackend = radio.value;
    refresh();
  }));
  refresh();

  // An off section keeps its previous cap but removes the inactive control
  // from keyboard navigation and form submission.
  document.querySelectorAll('input[role="switch"]').forEach((toggle) => {
    const count = document.getElementById(toggle.id.replace("include_", "top_"));
    if (!count) return;
    function refreshSection() {
      count.disabled = !toggle.checked;
      count.min = toggle.checked ? "1" : "0";
      count.setAttribute("aria-disabled", String(!toggle.checked));
    }
    toggle.addEventListener("change", refreshSection);
    refreshSection();
  });

  const opportunityPanel = document.getElementById("opportunity-profile");
  const opportunityToggles = [
    document.getElementById("include_opportunities"),
    document.getElementById("include_events")
  ];
  function refreshOpportunityProfile() {
    const enabled = opportunityToggles.some((toggle) => toggle && toggle.checked);
    opportunityPanel.hidden = !enabled;
    opportunityPanel.querySelectorAll("input, textarea").forEach((field) => {
      field.disabled = !enabled;
    });
    opportunityPanel.querySelectorAll("[data-opportunity-required]").forEach((field) => {
      field.required = enabled;
    });
  }
  opportunityToggles.forEach((toggle) => {
    if (toggle) toggle.addEventListener("change", refreshOpportunityProfile);
  });
  refreshOpportunityProfile();
})();
</script>
{% endblock %}
