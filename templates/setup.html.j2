        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_world" value="false">
                <input id="include_world" name="include_world" type="checkbox"
                       value="true" role="switch" aria-label="Include World news"
                       {% if form.include_world == "true" %}checked{% endif %}>
