  document.querySelector('#priority-options .hint').textContent = 'Priorities guide relative emphasis, not paper counts. Valid edits redistribute the other topics proportionally. Keep a total of 100%.';
  const sections = document.querySelector('.section-options').closest('.step');
  const sectionGroup = settingsRow('digest-sections', 'Digest sections'); sections.before(sectionGroup); sectionGroup.append(sections);
  sections.querySelector('h2').hidden = true;
  const advanced = document.getElementById('advanced-interests'); advanced.classList.add('settings-row');
  advanced.querySelector('summary').replaceChildren(...labelWithValue('Examples & interests', ''));
  advanced.querySelector('summary').title = 'Add useful paper titles and background topics to refine matching.';
  const papers = document.getElementById('paper-examples'); advanced.prepend(papers); papers.open = true; papers.classList.add('embedded-paper-examples');
  const authorGroup = settingsRow('author-settings', 'Researchers to follow');
  const author = document.getElementById('authors_of_interest');
  authorGroup.append(document.querySelector('label[for="authors_of_interest"]'), author);
  const authorHint = document.getElementById('authors-hint'); authorGroup.append(helpFor(authorHint));
  author.placeholder = 'A researcher’s full name\nAnother researcher’s full name';
  const context = document.getElementById('context_keywords'); context.placeholder = 'A nearby field to stay informed about\nA background method or research area';
  const extraHint = advanced.querySelector(':scope > p.hint'); if (extraHint) advanced.append(helpFor(extraHint));
  const summaryGroup = document.getElementById('summary-options'); summaryGroup.classList.add('settings-row');
  const summaryHeading = document.createElement('span'); summaryHeading.textContent = 'Summaries'; summaryCurrent.className = 'settings-value';
  summaryGroup.querySelector(':scope > summary').replaceChildren(summaryHeading, summaryCurrent);
  summaryGroup.querySelector(':scope > summary').title = 'Choose local summaries or an explicitly configured provider.';
  const providerIntro = summaryGroup.querySelector(':scope > p.hint'); if (providerIntro) summaryGroup.append(helpFor(providerIntro));
  const providerChoice = document.createElement('div'); providerChoice.className = 'settings-provider-choice';
  const providerLabel = document.createElement('label'); providerLabel.htmlFor = 'summary-backend'; providerLabel.textContent = 'Method';
  providerSelect = document.createElement('select'); providerSelect.id = 'summary-backend';
  for (const radio of radios) { const option = document.createElement('option'); option.value = radio.value; option.textContent = radio.value === 'extractive' ? 'Local extractive' : radio.closest('label').querySelector('strong').textContent; option.disabled = radio.disabled; providerSelect.append(option); }
  providerDescription = document.createElement('p'); providerDescription.className = 'hint';
  providerChoice.append(providerLabel, providerSelect);
  const backendCards = summaryGroup.querySelector('.backends'); backendCards.before(providerChoice, providerDescription); backendCards.hidden = true;
  providerSelect.addEventListener('change', () => { const radio = [...radios].find(field => field.value === providerSelect.value); radio.checked = true; radio.dispatchEvent(new Event('change', {bubbles: true})); });
  window.addEventListener('dd-companion-capabilities', () => { for (const option of providerSelect.options) option.disabled = [...radios].find(radio => radio.value === option.value)?.disabled || false; });
  refresh();
  const profileGroup = document.getElementById('profile-options'); profileGroup.classList.add('settings-row');
  profileGroup.querySelector('summary').replaceChildren(...labelWithValue('Research context', ''));
  profileGroup.querySelector('summary').title = 'Your current goal, name and topics to see less often.';
  const bio = document.getElementById('bio'); profileGroup.querySelector('summary').after(document.querySelector('label[for="bio"]'), bio, document.getElementById('bio-hint'));
  const actions = document.querySelector('.settings-actions');
  actions.querySelector('button[type="submit"]').textContent = firstUse ? 'Brew' : 'Save changes';
  actions.before(sectionGroup, summaryGroup, authorGroup, advanced, profileGroup);
  const examples = document.querySelector('.example-start');
  if (examples) {
    const choice = document.createElement('details'); choice.id = 'profile-examples'; choice.className = 'settings-help';
    const heading = document.createElement('summary'); heading.textContent = 'Use an example'; choice.append(heading);
    examples.before(choice); choice.append(examples);
    examples.querySelector('label').textContent = 'Field';
    document.getElementById('example-profile-note').hidden = true;
  }
  if (firstUse) { document.querySelector('.lede').textContent = 'Add a research topic to get started.'; topicStep.after(actions); }
  if ({{ 'true' if errors else 'false' }}) for (const group of [sectionGroup, authorGroup, advanced, profileGroup, summaryGroup]) group.open = true;
  function updateSettingsSummaries() {
    const enabled = [...document.querySelectorAll('input[role="switch"]')].filter(toggle => toggle.checked).length + 1;
    sectionGroup.querySelector('.settings-value').textContent = `${enabled} section${enabled === 1 ? '' : 's'}`;
    const authors = author.value.split('\n').filter(value => value.trim());
    authorGroup.querySelector('.settings-value').textContent = authors.length ? `${authors.length} researcher${authors.length === 1 ? '' : 's'}` : '';
    const seeds = document.getElementById('seed_works').value.split('\n').filter(value => value.trim()).length;
    const background = context.value.split('\n').filter(value => value.trim()).length;
    advanced.querySelector(':scope > summary .settings-value').textContent = [seeds ? `${seeds} example${seeds === 1 ? '' : 's'}` : '', background ? `${background} background topic${background === 1 ? '' : 's'}` : ''].filter(Boolean).join(' · ');
    const bio = document.getElementById('bio').value.trim();
    profileGroup.querySelector('.settings-value').textContent = bio.length > 72 ? bio.slice(0, 71) + '…' : bio;
  }
  settingsForm.addEventListener('input', updateSettingsSummaries); settingsForm.addEventListener('change', updateSettingsSummaries); updateSettingsSummaries();
  document.querySelectorAll('#browser-storage-note button').forEach(button => button.classList.add('btn'));
  const firstFields = [...settingsForm.elements].filter(field => field.name && !field.matches('[data-interest-name], [data-interest-weight], [data-interest-aliases], [data-interest-description]')).map(field => ({field, value: field.value, checked: field.checked}));
  const cancelChanges = document.createElement('button'); cancelChanges.type = 'button'; cancelChanges.id = 'cancel-settings'; cancelChanges.className = 'btn'; cancelChanges.textContent = 'Reset changes'; cancelChanges.hidden = firstUse; actions.append(cancelChanges);
  cancelChanges.addEventListener('click', () => {
    for (const {field, value, checked} of firstFields) { field.value = value; if (typeof checked === 'boolean') field.checked = checked; }
    loadRows(); removedTopic = null; undoTopic.hidden = true; resetDownweight();
    activeBackend = document.querySelector('input[name="llm_backend"]:checked').value; refresh(); invalidateConnection();
    document.querySelectorAll('input[role="switch"]').forEach(toggle => toggle.dispatchEvent(new Event('change')));
    refreshOpportunityProfile(); updateSettingsSummaries(); markUnsaved(); saveStatus.textContent = 'Form reset.';
  });
  settingsForm.classList.add('settings-refined');
  baselineFormState = formState(); settingsForm.dataset.dirty = 'false';
  if (!errors) saveStatus.textContent = '';
})();
</script>
{% endblock %}
