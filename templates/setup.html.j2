{% extends "_base.html.j2" %}
{% block title %}Set up DailyDigest{% endblock %}
{% block extra_styles %}
  .wrap { max-width: 860px; }
  .card { padding: clamp(16px, 4vw, 28px); overflow: visible; }
  .settings-nav { display: flex; justify-content: flex-start; margin-bottom: 18px; }
  h1 { font-size: 30px; line-height: 1.1; margin: 0 0 8px 0; letter-spacing: 0; }
  .lede { color: var(--muted); margin: 0 0 24px 0; font-size: 14px; line-height: 1.5; }
  .browser-storage-note { margin: 14px 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .browser-storage-note p { margin: 0; }
  .step { margin-bottom: 30px; padding-top: 4px; }
  .step h2 { font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase;
             color: var(--muted); margin: 0 0 8px 0; }
  label { display: block; font-size: 13px; font-weight: 600; margin: 12px 0 4px; }
  #interests-label { font-size: 13px; font-weight: 600; margin: 12px 0 4px; }
  textarea, input[type="text"], input[type="url"], input[type="password"], input[type="number"], select {
    width: 100%; padding: 8px 10px; border: 1px solid var(--control-border); border-radius: 6px;
    font-size: 13px; font-family: inherit; background: var(--card); color: var(--text);
  }
  textarea { min-height: 110px; resize: vertical; line-height: 1.5; }
  .hint { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .settings-actions { padding: 10px 0; background: var(--card); border-top: 1px solid var(--border); }
  .settings-actions .hint { margin: 4px 0; }
  .interest-row details { margin-top: 6px; }
  .interest-row summary { cursor: pointer; color: var(--muted); font-size: 12px; }
  .interest-row { border: 1px solid var(--control-border); padding: 8px 10px; border-radius: 8px; margin: 6px 0; }
  .interest-heading { display: grid; grid-template-columns: minmax(0, 1fr) 90px auto; gap: 8px; align-items: end; }
  .interest-heading label { min-width: 0; }
  #interest-editor:not(.show-priorities) .priority-control { display: none; }
  #interest-editor:not(.show-priorities) .interest-heading label:nth-child(2) { display: none; }
  #interest-editor:not(.show-priorities) .interest-heading { grid-template-columns: minmax(0, 1fr) auto; }
  .interest-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .interest-row textarea { min-height: 70px; }
  @media(max-width: 480px) {
    .interest-heading, #interest-editor:not(.show-priorities) .interest-heading { grid-template-columns: minmax(0, 1fr) auto; }
    .interest-heading label:first-child { grid-column: 1 / -1; }
    .interest-heading > label:nth-child(2) { max-width: 90px; }
    .interest-heading button { grid-column: 2; justify-self: end; }
  }
  #topics { min-height: 245px; font-size: 15px; }
  textarea::placeholder, input::placeholder { color: var(--muted); opacity: 1; }
  .example-note { color: var(--muted); font-size: 12px; line-height: 1.5; margin: 8px 0; }
  .example-start { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 8px; align-items: center; }
  .example-start label { grid-column: 1 / -1; margin-bottom: 0; }
  .example-start select { min-width: 0; }
  .example-start .btn { white-space: nowrap; padding-inline: 9px; }
  .settings-disclosure {
    border-top: 1px solid var(--border); margin-top: 20px; padding-top: 16px;
  }
  .settings-disclosure > summary {
    cursor: pointer; color: var(--text); font-size: 14px; font-weight: 600;
    line-height: 1.6;
  }
  .settings-disclosure > summary::marker { color: var(--accent); }
  .settings-disclosure > summary:focus-visible {
    outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 3px;
  }
  .disclosure-note { display: block; color: var(--muted); font-size: 12px; font-weight: 400; }
  .settings-disclosure[open] > summary { margin-bottom: 14px; }
  #bio { min-height: 0; }
  #paper-examples { border-top: 0; margin-top: 8px; padding-top: 0; }
  #paper-examples[open] > summary { margin-bottom: 6px; }
  #seed_works { min-height: 0; }
  .section-required .section-desc { margin-left: 0; }
  .always-included { font-size: 12px; color: var(--muted); }
  .chip-input {
    border: 1px solid var(--control-border); border-radius: 6px; padding: 6px;
    background: var(--card); display: flex; flex-wrap: wrap; gap: 4px; align-items: center;
    min-height: 38px;
  }
	  .chip {
	    background: var(--accent-soft); color: var(--accent-strong); border: 0; border-radius: 4px;
	    padding: 3px 8px; font-size: 12px; cursor: pointer; user-select: none;
	    max-width: 100%; overflow-wrap: anywhere; text-align: left;
	  }
	  .chip:hover, .chip:focus { background: var(--accent-soft); outline: 2px solid var(--accent); outline-offset: 1px; }
  .chip-input input {
    border: none; outline: none; flex: 1; min-width: 100px; font-size: 13px;
    padding: 4px 6px; background: transparent;
  }
  .backends { display: grid; gap: 8px; }
  .backend-opt {
    border: 1px solid var(--control-border); border-radius: 6px; padding: 10px 12px;
    cursor: pointer; background: var(--card);
  }
  .backend-opt.selected { border-color: var(--accent); background: var(--accent-soft); }
  .backend-opt input[type="radio"] { margin-right: 8px; }
  .backend-opt .desc { font-size: 12px; color: var(--muted); margin-top: 2px;
                       margin-left: 22px; }
  .api-fields { margin-top: 8px; padding: 10px;
                              background: var(--panel); border-radius: 6px;
                              border: 1px dashed var(--border); }
  .api-fields[hidden] { display: none; }
  .field-grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;
  }
  .section-options { display: grid; gap: 10px; margin-top: 12px; }
  .section-option {
    display: grid; grid-template-columns: minmax(0, 1fr) 110px; gap: 16px;
    align-items: center; padding: 12px; border: 1px solid var(--control-border);
    border-radius: 8px; background: var(--card);
  }
  .section-heading { display: flex; align-items: center; gap: 10px; }
  .section-heading label, .section-heading .section-name { margin: 0; }
  .section-desc { margin: 3px 0 0 48px; color: var(--muted); font-size: 12px; }
  .count-field label { margin-top: 0; }
  .opportunity-profile {
    margin-top: 14px; padding: 16px; border: 1px dashed var(--border);
    border-radius: 8px; background: var(--panel);
  }
  .opportunity-profile[hidden] { display: none; }
  .opportunity-advanced {
    margin-top: 16px; border-top: 1px solid var(--border); padding-top: 12px;
  }
  .opportunity-advanced summary {
    color: var(--accent-strong); cursor: pointer; font-size: 13px; font-weight: 600;
    padding: 4px 0;
  }
  .opportunity-advanced summary:focus-visible {
    outline: 3px solid #b9d2c3; outline-offset: 3px; border-radius: 3px;
  }
  .opportunity-advanced .hint { margin-bottom: 4px; }
  .opportunity-advanced .field-grid { margin-top: 4px; }
  .switch {
    position: relative; width: 42px; height: 24px; flex: 0 0 auto;
  }
  .switch input {
    position: absolute; width: 1px; height: 1px; opacity: 0;
  }
  .switch-track {
    display: block; width: 42px; height: 24px; border-radius: 12px;
    background: #c9ced3; cursor: pointer; transition: background 120ms ease;
  }
  .switch-track::after {
    content: ""; position: absolute; width: 18px; height: 18px;
    left: 3px; top: 3px; border-radius: 50%; background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.24); transition: transform 120ms ease;
  }
  .switch input:checked + .switch-track { background: var(--accent); }
  .switch input:checked + .switch-track::after { transform: translateX(18px); }
  .switch input:focus-visible + .switch-track {
    outline: 3px solid #b9d2c3; outline-offset: 2px;
  }
  .errors { background: var(--flash); color: var(--down); padding: 10px 12px;
            border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
  button.brew {
    width: 100%; padding: 14px 18px; font-size: 16px; font-weight: 600;
    background: var(--accent); color: #fff; border: none; border-radius: 8px;
    cursor: pointer; margin-top: 8px;
  }
  button.brew:hover { background: var(--accent-strong); }
  html[data-theme="dark"] button.brew { color: #0e1a13; }
  html[data-theme="dark"] .chip:hover,
  html[data-theme="dark"] .chip:focus { background: var(--surface-muted); }
  @media (max-width: 720px) {
    .field-grid, .section-option { grid-template-columns: 1fr; }
  }
  .settings-refined .step { margin: 0; padding: 0; }
  .settings-refined .topic-step { position: relative; margin-bottom: 18px; }
  .settings-refined .topic-step h2 { color: var(--text); font-size: 20px; font-weight: 700; letter-spacing: 0; text-transform: none; margin-bottom: 10px; }
  .settings-refined #interests-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .settings-refined .interest-list-head { display: grid; grid-template-columns: minmax(0, 1fr) 84px 48px; gap: 12px; color: var(--muted); font-size: 13px; padding: 4px 0; }
  .settings-refined .interest-row { border: 0; border-bottom: 1px solid var(--border); border-radius: 0; padding: 0; margin: 0; }
  .settings-refined #interest-editor .interest-heading { display: grid; grid-template-columns: minmax(0, 1fr) 84px 48px; align-items: center; gap: 12px; min-height: 52px; }
  .settings-refined #interest-editor .interest-heading label.interest-weight-label { display: block; margin: 0; font-size: 12px; color: var(--muted); font-weight: 500; }
  .settings-refined .interest-weight-wrap { display: flex; align-items: center; border: 1px solid var(--control-border); border-radius: 6px; padding-right: 9px; background: var(--card); }
  .settings-refined .interest-weight-wrap input { min-width: 0; padding: 7px 3px 7px 6px; border: 0; text-align: right; font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; background: transparent; }
  .settings-refined .interest-weight-wrap span { font-size: 14px; color: var(--muted); }
  .settings-refined .interest-title { font-size: 16px; line-height: 1.4; overflow-wrap: anywhere; }
  .settings-refined #interest-editor .interest-heading label.interest-name-field { display: block; }
  .settings-refined .interest-name-field { margin: 0; font-size: 13px; }
  .settings-refined .interest-name-field input { margin-top: 4px; }
  .settings-refined .interest-heading > :is(.interest-edit-button, .interest-remove-button) { grid-column: 3; grid-row: 1; justify-self: end; }
  .settings-refined :is(.interest-edit-button, .interest-remove-button) { padding: 8px 0; min-height: 40px; border: 0; background: transparent; color: var(--accent-strong); font-size: 14px; cursor: pointer; }
  .settings-refined .interest-heading:has(.interest-name-field:not([hidden])) > :is(.interest-weight-label, .interest-remove-button) { align-self: end; margin-bottom: 1px; }
  .settings-refined #interest-editor.single-topic :is(.interest-list-head, .interest-weight-label, #priority-options, .priority-control) { display: none; }
  .settings-refined #interest-editor.single-topic .interest-heading { grid-template-columns: minmax(0, 1fr) 48px; gap: 12px; }
  .settings-refined #interest-editor.single-topic .interest-heading > button { grid-column: 2; }
  .settings-refined .interest-edit-panel { padding: 4px 0 16px; }
  .settings-refined .interest-edit-panel details { margin-top: 0; }
  .settings-refined .interest-edit-panel summary { font-size: 14px; min-height: 36px; padding: 7px 0; }
  .settings-refined .interest-actions { margin-top: 12px; }
  .settings-refined #interest-total { color: var(--muted); font-size: 13px; }
  .settings-refined #priority-options { border: 0; padding: 0; margin: 0 0 0 auto; max-width: 100%; }
  .settings-refined #priority-options > summary { min-height: 38px; padding: 9px 0; }
  .settings-refined #priority-options > summary { font-size: 13px; font-weight: 500; }
  .settings-refined .settings-row { position: relative; border: 0; border-top: 1px solid var(--border); margin: 0; padding: 0; }
  .settings-refined .settings-row > summary { display: grid; grid-template-columns: 190px minmax(0, 1fr) 12px; align-items: center; gap: 12px; padding: 16px 0; margin: 0; min-height: 58px; list-style: none; color: var(--text); font-size: 19px; font-weight: 700; line-height: 1.35; }
  .settings-refined .settings-row > summary::-webkit-details-marker { display: none; }
  .settings-refined .settings-row > summary::after { content: ''; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); justify-self: end; margin-right: 2px; }
  .settings-refined .settings-row[open] > summary::after { transform: rotate(225deg); }
  .settings-refined .settings-row[open] { padding-bottom: 18px; }
  .settings-refined .settings-value { font-size: 14px; font-weight: 400; color: var(--muted); line-height: 1.4; min-width: 0; overflow-wrap: anywhere; }
  .settings-refined .settings-row[open] > summary .settings-value { visibility: hidden; }
  .settings-refined .settings-row .settings-disclosure { margin-top: 12px; }
  .settings-refined .section-options { gap: 0; margin-top: 0; }
  .settings-refined .section-option { border: 0; border-bottom: 1px solid var(--border-soft); border-radius: 0; padding: 12px 0; gap: 16px; grid-template-columns: minmax(0, 1fr) 88px; }
  .settings-refined .section-name { font-size: 16px; }
  .settings-refined .section-desc { margin: 5px 0 0; font-size: 13px; max-width: 66ch; }
  .settings-refined .count-field label { font-size: 13px; }
  .settings-refined .opportunity-profile { padding: 16px 0 0; margin-top: 14px; border: 0; border-top: 1px solid var(--border); border-radius: 0; background: transparent; }
  .settings-refined label { font-size: 14px; }
  .settings-refined textarea, .settings-refined input[type=text], .settings-refined input[type=url], .settings-refined input[type=password], .settings-refined input[type=number], .settings-refined select { font-size: 15px; line-height: 1.45; }
  .settings-refined .hint, .settings-refined .example-note { font-size: 13px; line-height: 1.45; }
  .settings-refined .settings-help { position: relative; color: var(--muted); font-size: 13px; margin: 8px 0 0; }
  .settings-refined .settings-help > summary { cursor: pointer; min-height: 30px; padding: 5px 0; font-size: 13px; font-weight: 500; }
  .settings-refined .settings-topic-help { position: absolute; top: 0; right: 0; margin: 0; z-index: 10; }
  .settings-refined .settings-topic-help > summary { display: grid; place-items: center; width: 30px; height: 30px; min-height: 30px; padding: 5px; list-style: none; }
  .settings-refined .settings-topic-help > summary::-webkit-details-marker { display: none; }
  .settings-refined .settings-topic-help svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.4; }
  .settings-refined .settings-topic-help-body { position: absolute; top: 34px; right: 0; width: min(360px, calc(100vw - 72px)); max-height: 65vh; overflow-y: auto; padding: 12px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--copy-secondary); }
  .settings-refined .settings-topic-help-body .hint { margin: 0 0 8px; }
  .settings-refined .settings-help > p { max-width: 66ch; margin: 4px 0 8px; }
  .settings-refined .settings-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 18px 0 0; margin-top: 0; }
  .settings-refined .settings-actions .hint { flex-basis: 100%; margin: 0; }
  .settings-refined .settings-actions .brew { width: auto; min-width: 150px; min-height: 44px; margin: 0; padding: 10px 18px; font-size: 15px; }
  .settings-refined #topic-undo { font-size: 14px; margin: 8px 0; }
  .settings-refined .embedded-paper-examples { border: 0; padding: 0; margin: 0; }
  .settings-refined .embedded-paper-examples > summary { display: none; }
  .settings-refined .settings-provider-choice { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .settings-refined .settings-provider-choice label { margin: 0; }
  .settings-refined .settings-provider-choice select { flex: 1; max-width: 520px; min-height: 44px; }
  @media (max-width: 600px) {
    .settings-refined .settings-row > summary { grid-template-columns: minmax(0, 1fr) 12px; gap: 4px 10px; font-size: 18px; }
    .settings-refined .settings-row > summary .settings-value { grid-column: 1; }
    .settings-refined .settings-row > summary::after { grid-column: 2; grid-row: 1 / span 2; }
    .settings-refined .interest-list-head { grid-template-columns: minmax(0, 1fr) 74px 38px; gap: 8px; }
    .settings-refined #interest-editor .interest-heading { grid-template-columns: minmax(0, 1fr) 74px 38px; gap: 8px; }
    .settings-refined .interest-heading label:first-child { grid-column: auto; }
    .settings-refined .interest-title { font-size: 15px; }
    .settings-refined .section-option { grid-template-columns: minmax(0, 1fr) 76px; }
    .settings-refined .settings-actions .brew { flex: 1; }
  }
{% endblock %}
{% block body %}
<div class="card">
  {% if not (first_run | default(not form.topics)) %}<nav class="settings-nav" aria-label="Settings navigation">
    <a class="btn" href="/">← Back to today’s digest</a>
  </nav>{% endif %}
  <h1>{{ 'Welcome to DailyDigest' if first_run | default(not form.topics) else 'DailyDigest settings' }}</h1>
  <p class="lede">{% if first_run | default(not form.topics) %}Add a few research interests below. Examples and priorities are optional.{% else %}Update your research interests and reading preferences.{% endif %}</p>

  {% if errors %}
	  <div class="errors" role="alert" aria-live="assertive" tabindex="-1">
    {% for e in errors %}<div>{{ e }}</div>{% endfor %}
  </div>
  {% endif %}

	  <form method="post" action="/setup">
	    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" id="user-timezone" name="user_tz" value="{{ form.user_tz }}" data-detect-timezone="{{ 'true' if first_run else 'false' }}">
    <div class="step">
      <h2>Your research interests</h2>
      <div id="interests-label">What would you like to read about?</div>
      <div id="interest-editor" hidden>
        <div id="interest-rows"></div>
        <details id="priority-options" class="settings-disclosure"{% if errors %} open{% endif %}><summary>Set topic priorities (optional)</summary><p class="hint">Topics start with equal shares. Adjust individual percentages above when useful; the total must be 100%.</p></details>
        <div class="interest-actions"><button type="button" class="btn" id="add-interest">Add interest</button><button type="button" class="btn priority-control" id="even-interests">Distribute evenly</button><button type="button" class="btn priority-control" id="normalize-interests">Normalize to 100%</button><output class="priority-control" id="interest-total" aria-live="polite"></output></div>
        <p class="hint priority-control">Give each topic a percentage. The total must be 100%. Use Distribute evenly or Normalize to 100% to adjust the shares.</p>
      </div>
      <textarea id="topic-details" name="topic_details" hidden disabled>{{ form.topic_details | default('') }}</textarea>
      <input id="topic-weight-mode" name="topic_weight_mode" type="hidden" value="percentage" disabled>
      <textarea id="topics" name="topics" required aria-labelledby="interests-label" aria-describedby="topics-hint example-profile-note" placeholder="DNA nanotechnology&#10;RNA nanotechnology&#10;nucleic acid delivery&#10;mRNA therapeutics&#10;gene therapy&#10;protein engineering&#10;protein structure prediction&#10;colloidal self-assembly&#10;superlattice materials&#10;machine learning for biomolecular design">{{ form.topics }}</textarea>
      <div class="hint" id="topics-hint">Add 1–10 specific research topics. The examples above are suggestions, not your saved profile.<noscript> Use one topic per line with an optional relative weight, such as <code>RNA delivery | 3</code>. Any positive relative weights work.</noscript></div>
      {% if not form.topics %}
      <div class="example-start">
        <label for="example-discipline">Or start with an example (optional)</label>
        <select id="example-discipline">
          <option value="biomolecular">Biomolecular research</option>
          <option value="engineering">Materials &amp; engineering</option>
          <option value="chemistry">Chemistry &amp; catalysis</option>
          <option value="ecology">Ecology &amp; environment</option>
          <option value="astronomy">Physics &amp; astronomy</option>
        </select>
        <button class="btn" id="use-example-profile" type="button">Load example</button>
      </div>
      {% endif %}
      <p class="example-note" id="example-profile-note">{% if not form.topics %}Examples are editable starting points. {% endif %}Nothing is saved until you save your settings.</p>
      <label for="bio">Current research or learning goal (optional)</label>
      <textarea id="bio" name="bio" rows="2" aria-describedby="bio-hint" placeholder="I’m learning how ... works and need clear reviews.&#10;I’m developing ... and looking for methods I can use.">{{ form.bio }}</textarea>
      <div class="hint" id="bio-hint">What would make a paper useful for your current work?</div>
      <details class="settings-disclosure" id="paper-examples"{% if errors %} open{% endif %}>
        <summary>Example papers (optional)</summary>
        <label for="seed_works">Paper titles or short descriptions</label>
        <textarea id="seed_works" name="seed_works" rows="3" aria-describedby="seed-works-hint" placeholder="A paper title you found useful&#10;Another title, or a short description of the work">{{ form.seed_works }}</textarea>
        <p class="hint" id="seed-works-hint">One per line. Include the title with a DOI; identifiers and linked papers are not fetched automatically.</p>
      </details>
      <aside id="browser-storage-note" class="browser-storage-note" aria-label="Your data in this browser" hidden>
        <p>Saved in this browser. Other browsers and profiles have separate data.
        <button type="button" data-browser-action="open-backup">Backup &amp; transfer</button><button type="button" data-browser-action="open-guide">Quick guide</button></p>
      </aside>
      <details class="settings-disclosure" id="search-tips">
        <summary>Search tips</summary>
        <p class="hint">Priorities set relative emphasis. Other names can add established abbreviations or synonyms to searches.</p>
        <p class="hint">After you finish typing, only the topic name is checked with PubMed. Suggestions appear beside the topic; your wording changes only if you accept one. PubMed may not recognize specialist terms from every field.</p>
      </details>

      <details class="settings-disclosure" id="advanced-interests"{% if errors %} open{% endif %}>
        <summary>Advanced interests<span class="disclosure-note">Authors and background topics (optional).</span></summary>
        <p class="hint">One entry per line, up to 20 entries of 300 characters in each field. These refine matching; they do not guarantee a pick.</p>
        <label for="authors_of_interest">Researchers to follow</label>
        <textarea id="authors_of_interest" name="authors_of_interest" rows="3" aria-describedby="authors-hint">{{ form.authors_of_interest }}</textarea>
        <p class="hint" id="authors-hint">Use full names. Unique exact-name matches are searched in OpenAlex; ambiguous names are skipped. Labs match author bylines only. See identity checks under the digest’s source details.</p>
        <label for="context_keywords">Background interests</label>
        <textarea id="context_keywords" name="context_keywords" rows="3" aria-describedby="context-keywords-hint">{{ form.context_keywords }}</textarea>
        <p class="hint" id="context-keywords-hint">Topics to stay informed about with less influence on research relevance than your core interests.</p>
      </details>

      <details class="settings-disclosure" id="profile-options"{% if errors %} open{% endif %}>
        <summary>Name &amp; topics to see less often (optional)</summary>
        <div class="field-grid">
          <div>
            <label for="name">First name</label>
            <input id="name" name="name" type="text" autocomplete="given-name" placeholder="Ada" value="{{ form.name }}">
          </div>
        </div>
        <label for="dw-text">Topics to see less often</label>
        <div class="chip-input" id="dw-input">
