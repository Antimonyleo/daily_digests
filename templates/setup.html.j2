{% extends "_base.html.j2" %}
{% block title %}Set up DailyDigest{% endblock %}
{% block extra_styles %}
  .wrap { max-width: 860px; }
  .card { padding: 28px; overflow: visible; }
  .settings-nav { display: flex; justify-content: flex-start; margin-bottom: 18px; }
  h1 { font-size: 30px; line-height: 1.1; margin: 0 0 8px 0; letter-spacing: 0; }
  .lede { color: var(--muted); margin: 0 0 24px 0; font-size: 14px; line-height: 1.5; }
  .browser-storage-note { margin: 0 0 24px; padding: 14px 16px; border: 1px solid var(--control-border); border-radius: 8px; background: var(--panel); font-size: 13px; line-height: 1.5; }
  .browser-storage-note p { margin: 6px 0 0; }
  .step { margin-bottom: 30px; padding-top: 4px; }
  .step h2 { font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase;
             color: var(--muted); margin: 0 0 8px 0; }
  label { display: block; font-size: 13px; font-weight: 600; margin: 12px 0 4px; }
  textarea, input[type="text"], input[type="url"], input[type="password"], input[type="number"], select {
    width: 100%; padding: 8px 10px; border: 1px solid var(--control-border); border-radius: 6px;
    font-size: 13px; font-family: inherit; background: var(--card); color: var(--text);
  }
  textarea { min-height: 110px; resize: vertical; line-height: 1.5; }
  .hint { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .settings-actions { position: sticky; bottom: 0; z-index: 2; padding: 10px 0; background: var(--card); border-top: 1px solid var(--border); }
  .settings-actions .hint { margin: 4px 0; }
  .interest-row details { margin-top: 6px; }
  .interest-row summary { cursor: pointer; color: var(--muted); font-size: 12px; }
  .interest-row { border: 1px solid var(--control-border); padding: 8px 10px; border-radius: 8px; margin: 6px 0; }
  .interest-heading { display: grid; grid-template-columns: minmax(0, 1fr) 90px auto; gap: 8px; align-items: end; }
  .interest-heading label { min-width: 0; }
  #interest-editor:not(.show-priorities) .priority-control { display: none; }
  #interest-editor:not(.show-priorities) .interest-heading label:nth-child(2) { display: none; }
  #interest-editor:not(.show-priorities) .interest-heading { grid-template-columns: minmax(0, 1fr) auto; }
  .interest-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .interest-row textarea { min-height: 70px; }
  @media(max-width: 480px) { .interest-heading { grid-template-columns: minmax(0, 1fr) 80px; } .interest-heading button { grid-column: 1 / -1; justify-self: start; } }
  #topics { min-height: 245px; font-size: 15px; }
  textarea::placeholder, input::placeholder { color: var(--muted); opacity: 1; }
  .example-note { color: var(--muted); font-size: 12px; line-height: 1.5; margin: 8px 0; }
  .settings-disclosure {
    border-top: 1px solid var(--border); margin-top: 20px; padding-top: 16px;
  }
  .settings-disclosure > summary {
    cursor: pointer; color: var(--text); font-size: 14px; font-weight: 600;
    line-height: 1.6;
  }
  .settings-disclosure > summary::marker { color: var(--accent); }
  .settings-disclosure > summary:focus-visible {
    outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 3px;
  }
  .disclosure-note { display: block; color: var(--muted); font-size: 12px; font-weight: 400; }
  .settings-disclosure[open] > summary { margin-bottom: 14px; }
  .section-required .section-desc { margin-left: 0; }
  .always-included { font-size: 12px; color: var(--muted); }
  .chip-input {
    border: 1px solid var(--control-border); border-radius: 6px; padding: 6px;
    background: var(--card); display: flex; flex-wrap: wrap; gap: 4px; align-items: center;
    min-height: 38px;
  }
	  .chip {
	    background: var(--accent-soft); color: var(--accent-strong); border: 0; border-radius: 4px;
	    padding: 3px 8px; font-size: 12px; cursor: pointer; user-select: none;
	    max-width: 100%; overflow-wrap: anywhere; text-align: left;
	  }
	  .chip:hover, .chip:focus { background: var(--accent-soft); outline: 2px solid var(--accent); outline-offset: 1px; }
  .chip-input input {
    border: none; outline: none; flex: 1; min-width: 100px; font-size: 13px;
    padding: 4px 6px; background: transparent;
  }
  .backends { display: grid; gap: 8px; }
  .backend-opt {
    border: 1px solid var(--control-border); border-radius: 6px; padding: 10px 12px;
    cursor: pointer; background: var(--card);
  }
  .backend-opt.selected { border-color: var(--accent); background: var(--accent-soft); }
  .backend-opt input[type="radio"] { margin-right: 8px; }
  .backend-opt .desc { font-size: 12px; color: var(--muted); margin-top: 2px;
                       margin-left: 22px; }
  .api-fields { margin-top: 8px; padding: 10px;
                              background: var(--panel); border-radius: 6px;
                              border: 1px dashed var(--border); }
  .api-fields[hidden] { display: none; }
  .field-grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;
  }
  .section-options { display: grid; gap: 10px; margin-top: 12px; }
  .section-option {
    display: grid; grid-template-columns: minmax(0, 1fr) 110px; gap: 16px;
    align-items: center; padding: 12px; border: 1px solid var(--control-border);
    border-radius: 8px; background: var(--card);
  }
  .section-heading { display: flex; align-items: center; gap: 10px; }
  .section-heading label, .section-heading .section-name { margin: 0; }
  .section-desc { margin: 3px 0 0 48px; color: var(--muted); font-size: 12px; }
  .count-field label { margin-top: 0; }
  .opportunity-profile {
    margin-top: 14px; padding: 16px; border: 1px dashed var(--border);
    border-radius: 8px; background: var(--panel);
  }
  .opportunity-profile[hidden] { display: none; }
  .opportunity-advanced {
    margin-top: 16px; border-top: 1px solid var(--border); padding-top: 12px;
  }
  .opportunity-advanced summary {
    color: var(--accent-strong); cursor: pointer; font-size: 13px; font-weight: 600;
    padding: 4px 0;
  }
  .opportunity-advanced summary:focus-visible {
    outline: 3px solid #b9d2c3; outline-offset: 3px; border-radius: 3px;
  }
  .opportunity-advanced .hint { margin-bottom: 4px; }
  .opportunity-advanced .field-grid { margin-top: 4px; }
  .switch {
    position: relative; width: 42px; height: 24px; flex: 0 0 auto;
  }
  .switch input {
    position: absolute; width: 1px; height: 1px; opacity: 0;
  }
  .switch-track {
    display: block; width: 42px; height: 24px; border-radius: 12px;
    background: #c9ced3; cursor: pointer; transition: background 120ms ease;
  }
  .switch-track::after {
    content: ""; position: absolute; width: 18px; height: 18px;
    left: 3px; top: 3px; border-radius: 50%; background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.24); transition: transform 120ms ease;
  }
  .switch input:checked + .switch-track { background: var(--accent); }
  .switch input:checked + .switch-track::after { transform: translateX(18px); }
  .switch input:focus-visible + .switch-track {
    outline: 3px solid #b9d2c3; outline-offset: 2px;
  }
  .errors { background: var(--flash); color: var(--down); padding: 10px 12px;
            border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
  button.brew {
    width: 100%; padding: 14px 18px; font-size: 16px; font-weight: 600;
    background: var(--accent); color: #fff; border: none; border-radius: 8px;
    cursor: pointer; margin-top: 8px;
  }
  button.brew:hover { background: var(--accent-strong); }
  html[data-theme="dark"] button.brew { color: #0e1a13; }
  html[data-theme="dark"] .chip:hover,
  html[data-theme="dark"] .chip:focus { background: var(--surface-muted); }
  @media (max-width: 720px) {
    .field-grid, .section-option { grid-template-columns: 1fr; }
  }
{% endblock %}
{% block body %}
<div class="card">
  {% if not (first_run | default(not form.topics)) %}<nav class="settings-nav" aria-label="Settings navigation">
    <a class="btn" href="/">← Back to today’s digest</a>
  </nav>{% endif %}
  <h1>{{ 'DailyDigest settings' if form.topics else 'Welcome to DailyDigest' }}</h1>
  <p class="lede">Start with a few research interests or choose an editable example. Priorities are optional. No account is needed.</p>

  {% if errors %}
	  <div class="errors" role="alert" aria-live="assertive" tabindex="-1">
    {% for e in errors %}<div>{{ e }}</div>{% endfor %}
  </div>
  {% endif %}

	  <form method="post" action="/setup">
	    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" id="user-timezone" name="user_tz" value="{{ form.user_tz }}">
    <div class="step">
      <h2>Your research interests</h2>
      {% if not form.topics %}
      <div class="example-start">
        <label for="example-discipline">Start with an example (optional)</label>
        <select id="example-discipline">
          <option value="biomolecular">Biomolecular research</option>
          <option value="engineering">Materials &amp; engineering</option>
          <option value="chemistry">Chemistry &amp; catalysis</option>
          <option value="ecology">Ecology &amp; environment</option>
          <option value="astronomy">Physics &amp; astronomy</option>
        </select>
        <button class="btn" id="use-example-profile" type="button">Load selected example</button>
      </div>
      {% endif %}
      <p class="example-note" id="example-profile-note">Examples are optional, editable starting points. Nothing is saved until you save your settings. Loading an example is available only while your interests are empty.</p>
      <label for="topics">What would you like to read about?</label>
      <div id="interest-editor" hidden>
        <details id="priority-options" class="settings-disclosure"{% if form.topics %} open{% endif %}><summary>Set topic priorities (optional)</summary><p class="hint">Topics start with equal shares. Adjust individual percentages below when useful; the total must be 100%.</p></details>
        <div id="interest-rows"></div>
        <div class="interest-actions"><button type="button" class="btn" id="add-interest">Add interest</button><button type="button" class="btn priority-control" id="even-interests">Distribute evenly</button><button type="button" class="btn priority-control" id="normalize-interests">Normalize to 100%</button><output class="priority-control" id="interest-total" aria-live="polite"></output></div>
        <p class="hint priority-control">Give each topic a percentage. The total must be 100%. Use Distribute evenly or Normalize to 100% to adjust the shares.</p>
      </div>
      <textarea id="topic-details" name="topic_details" hidden disabled>{{ form.topic_details | default('') }}</textarea>
      <input id="topic-weight-mode" name="topic_weight_mode" type="hidden" value="percentage" disabled>
      <textarea id="topics" name="topics" required aria-describedby="topics-hint example-profile-note" placeholder="DNA nanotechnology&#10;RNA nanotechnology&#10;nucleic acid delivery&#10;mRNA therapeutics&#10;gene therapy&#10;protein engineering&#10;protein structure prediction&#10;colloidal self-assembly&#10;superlattice materials&#10;machine learning for biomolecular design">{{ form.topics }}</textarea>
      <div class="hint" id="topics-hint">Add 1–10 specific research topics. The examples above are suggestions, not your saved profile.<noscript> Use one topic per line with an optional relative weight, such as <code>RNA delivery | 3</code>. Any positive relative weights work.</noscript></div>
      <details class="settings-disclosure" id="search-tips">
        <summary>Search tips and wording checks (optional)</summary>
        <p class="hint">Priorities guide relative emphasis, not guaranteed digest slots. Adding or removing a topic adjusts the shares; old relative weights are converted to percentages when saved. Search details let you add alternative terms or describe useful papers.</p>
        <p class="hint">Suggest wording variants works locally from your supplied acronym or hyphenated wording. Check wording sends only the chosen interest to PubMed for spelling suggestions. Both are optional, and nothing is checked automatically. Accepting a suggestion changes searches and ranking only after saving. Specialist terms may have no suggestion.</p>
      </details>

      <p class="hint">Prefer examples of papers you like? Add their titles or short descriptions under Advanced interests below to refine matching. Topic names above still guide source searches.</p>
      <details class="settings-disclosure" id="advanced-interests"{% if errors %} open{% endif %}>
        <summary>Advanced interests<span class="disclosure-note">Authors, representative works, and background topics (optional).</span></summary>
        <p class="hint">One entry per line, up to 20 entries of 300 characters in each field. These refine matching; they do not guarantee a pick.</p>
        <label for="authors_of_interest">Authors, labs &amp; institutions to follow</label>
        <textarea id="authors_of_interest" name="authors_of_interest" rows="3">{{ form.authors_of_interest }}</textarea>
        <label for="seed_works">Example paper titles or short descriptions</label>
        <textarea id="seed_works" name="seed_works" rows="3" aria-describedby="seed-works-hint">{{ form.seed_works }}</textarea>
        <p class="hint" id="seed-works-hint">Paper titles and short descriptions anchor relevance. Include the title when pasting a DOI; identifiers and linked papers are not fetched automatically. Keep specific topic names above for source searches.</p>
        <label for="context_keywords">Background interests</label>
        <textarea id="context_keywords" name="context_keywords" rows="3" aria-describedby="context-keywords-hint">{{ form.context_keywords }}</textarea>
        <p class="hint" id="context-keywords-hint">Topics to stay informed about with less influence on research relevance than your core interests.</p>
      </details>

      <details class="settings-disclosure" id="profile-options"{% if errors %} open{% endif %}>
        <summary>Personal details &amp; topics to see less often
          <span class="disclosure-note">Optional context to help refine your picks.</span>
        </summary>
        <div class="field-grid">
          <div>
            <label for="name">First name</label>
            <input id="name" name="name" type="text" autocomplete="given-name" placeholder="Ada" value="{{ form.name }}">
          </div>
        </div>
        <label for="bio">A short bio (optional)</label>
        <textarea id="bio" name="bio" aria-describedby="bio-hint" placeholder="I research DNA and RNA nanotechnology, biomolecular delivery, protein engineering and self-assembling materials. Prioritize new engineering methods, transferable design rules and prediction tools. Keep clinical trials and biotech developments as background context.">{{ form.bio }}</textarea>
        <div class="hint" id="bio-hint">Describe your priorities in your own words: new methods, engineered systems, mechanisms, applications, or reviews and synthesis. This context helps match papers and news to your interests.</div>

        <label for="dw-text">Topics to see less often</label>
        <div class="chip-input" id="dw-input">
          <input type="text" id="dw-text" placeholder="e.g. cryptocurrency, stock market predictions" aria-describedby="downweight-hint">
        </div>
        <input type="hidden" name="downweight" id="dw-hidden" value="{{ form.downweight }}">
        <div class="hint" id="downweight-hint">Type a topic and press comma or Enter. Picks mentioning these topics appear less often. Examples are not saved automatically.</div>
      </details>
    </div>
    <div class="step">
      <h2>What’s in your digest</h2>
      <p class="hint">Research is always included. Choose which additional sections you want to read.</p>
      <div class="section-options">
        <div class="section-option section-required">
          <div>
            <div class="section-heading">
              <strong class="section-name">Research</strong>
              <span class="always-included">Always included</span>
            </div>
            <p class="section-desc">Papers and findings matched to your research interests.</p>
          </div>
          <div class="count-field">
            <label for="top_research">Maximum research items</label>
            <input id="top_research" name="top_research" type="number" min="1" max="30" required value="{{ form.top_research }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_industry" value="false">
                <input id="include_industry" name="include_industry" type="checkbox"
                       value="true" role="switch" aria-label="Include Industry"
                       {% if form.include_industry == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_industry" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_industry">Industry</label>
            </div>
            <p class="section-desc">Biotechnology companies, deals, products, and sector developments.</p>
          </div>
          <div class="count-field">
            <label for="top_industry">Maximum industry items</label>
            <input id="top_industry" name="top_industry" type="number" min="0" max="30"
                   value="{{ form.top_industry }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_ai" value="false">
                <input id="include_ai" name="include_ai" type="checkbox"
                       value="true" role="switch" aria-label="Include AI tools and methods"
                       {% if form.include_ai == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_ai" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_ai">AI tools &amp; methods</label>
            </div>
            <p class="section-desc">Useful models, software, benchmarks, and scientific workflows.</p>
          </div>
          <div class="count-field">
            <label for="top_ai">Maximum ai items</label>
            <input id="top_ai" name="top_ai" type="number" min="0" max="30"
                   value="{{ form.top_ai }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_regulatory" value="false">
                <input id="include_regulatory" name="include_regulatory" type="checkbox"
                       value="true" role="switch" aria-label="Include Clinical and Regulatory"
                       {% if form.include_regulatory == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_regulatory" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_regulatory">Clinical &amp; Regulatory</label>
            </div>
            <p class="section-desc">Clinical trials, approvals, safety updates, and policy changes.</p>
          </div>
          <div class="count-field">
            <label for="top_regulatory">Maximum regulatory items</label>
            <input id="top_regulatory" name="top_regulatory" type="number" min="0" max="30"
                   value="{{ form.top_regulatory }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_world" value="false">
                <input id="include_world" name="include_world" type="checkbox"
                       value="true" role="switch" aria-label="Include World news"
                       {% if form.include_world == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_world" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_world">World news</label>
            </div>
            <p class="section-desc">Major events outside the scientific and biotechnology sections.</p>
          </div>
          <div class="count-field">
            <label for="top_world">Maximum world items</label>
            <input id="top_world" name="top_world" type="number" min="0" max="30"
                   value="{{ form.top_world }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_opportunities" value="false">
                <input id="include_opportunities" name="include_opportunities" type="checkbox"
                       value="true" role="switch" aria-label="Include Funding and Opportunities"
                       {% if form.include_opportunities == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_opportunities" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_opportunities">Funding &amp; Opportunities</label>
            </div>
            <p class="section-desc">Grants.gov covers US federal opportunities. Coverage is not exhaustive; international funding may be absent. Eligibility needs official-source verification.</p>
          </div>
          <div class="count-field">
            <label for="top_opportunities">Maximum opportunities items</label>
            <input id="top_opportunities" name="top_opportunities" type="number" min="0" max="30"
                   value="{{ form.top_opportunities }}">
          </div>
        </div>
        <div class="section-option">
          <div>
            <div class="section-heading">
              <span class="switch">
                <input type="hidden" name="include_events" value="false">
                <input id="include_events" name="include_events" type="checkbox"
                       value="true" role="switch" aria-label="Include Events and Calls"
                       {% if form.include_events == "true" %}checked{% endif %}>
                <label class="switch-track" for="include_events" aria-hidden="true"></label>
              </span>
              <label class="section-name" for="include_events">Events &amp; Calls</label>
            </div>
            <p class="section-desc">EMBL events provide limited life-science coverage, mainly in Europe and online. Coverage is not exhaustive across disciplines or regions; verify dates and eligibility at the official source.</p>
          </div>
          <div class="count-field">
            <label for="top_events">Maximum events items</label>
            <input id="top_events" name="top_events" type="number" min="0" max="30"
                   value="{{ form.top_events }}">
          </div>
        </div>
      </div>
      <div class="opportunity-profile" id="opportunity-profile"
           {% if form.include_opportunities != "true" and form.include_events != "true" %}hidden{% endif %}>
        <h3>About you for opportunity matching</h3>
        <p class="hint">These details stay on this device. Your research interests above are reused for matching, so you do not need to describe your research again.</p>
        <div class="field-grid">
          <div>
            <label for="opportunity-career-stage">Career stage</label>
            <input id="opportunity-career-stage" name="opportunity_career_stage" type="text"
                   data-opportunity-required placeholder="Postdoctoral researcher" value="{{ form.opportunity_career_stage }}">
          </div>
          <div>
            <label for="opportunity-institution-type">Institution type</label>
            <input id="opportunity-institution-type" name="opportunity_institution_type" type="text"
                   data-opportunity-required placeholder="Nonprofit university" value="{{ form.opportunity_institution_type }}">
          </div>
          <div>
            <label for="opportunity-country">Current country</label>
            <input id="opportunity-country" name="opportunity_country" type="text"
                   data-opportunity-required autocomplete="country-name" placeholder="United States" value="{{ form.opportunity_country }}">
          </div>
          <div>
            <label for="opportunity-applicant-role">Applicant role</label>
            <input id="opportunity-applicant-role" name="opportunity_applicant_role" type="text"
                   data-opportunity-required placeholder="Fellow or co-investigator" value="{{ form.opportunity_applicant_role }}">
          </div>
        </div>
        <details class="opportunity-advanced"{% if errors %} open{% endif %}>
          <summary>Optional matching preferences</summary>
          <p class="hint">Add only constraints or preferences that apply to you.</p>
          <div class="field-grid">
            <div>
              <label for="opportunity-types">Opportunity types</label>
              <input id="opportunity-types" name="opportunity_types" type="text"
                     placeholder="grant, fellowship, travel support" value="{{ form.opportunity_types }}">
            </div>
            <div>
              <label for="event-types">Event types</label>
              <input id="event-types" name="event_types" type="text"
                     placeholder="conference, workshop, course" value="{{ form.event_types }}">
            </div>
            <div>
              <label for="event-regions">Event regions</label>
              <input id="event-regions" name="event_regions" type="text"
                     placeholder="North America, Europe, online" value="{{ form.event_regions }}">
            </div>
            <div>
              <label for="event-formats">Event formats</label>
              <input id="event-formats" name="event_formats" type="text"
                     placeholder="in person, online, hybrid" value="{{ form.event_formats }}">
            </div>
            <div>
              <label for="minimum-lead-days">Minimum preparation time (days)</label>
              <input id="minimum-lead-days" name="minimum_lead_days" type="number" min="0" max="365"
                     value="{{ form.minimum_lead_days }}">
            </div>
          </div>
        </details>
      </div>
      <div class="hint">Item counts are caps; DailyDigest will show fewer when there are not enough strong candidates.</div>
    </div>

    <details class="step settings-disclosure" id="summary-options"{% if errors %} open{% endif %}>
      {% set summary_labels = {"extractive": "Local extractive", "api": "OpenAI-compatible API", "anthropic": "Anthropic Claude API", "claude_cli": "Signed-in Claude Code", "codex_cli": "Signed-in Codex"} %}
      <summary>How to summarize
        <span class="disclosure-note">Current choice: <span id="summary-current">{{ summary_labels.get(form.llm_backend, "Local extractive") }}</span></span>
      </summary>
      <p class="hint">Native mode can use local commands and configured providers directly. Browser mode can reach APIs directly or through the browser companion; signed-in CLI commands need a connected companion. Extractive summaries stay on this device in either mode.</p>
      <div class="backends">
        <label class="backend-opt" data-value="extractive">
          <input type="radio" name="llm_backend" value="extractive"
                 {% if form.llm_backend == "extractive" %}checked{% endif %}>
          <strong>Extractive</strong> — recommended for the first run.
          <div class="desc">Free. No account, API key, or paid AI subscription.</div>
        </label>

        <label class="backend-opt" data-value="api">
          <input type="radio" name="llm_backend" value="api"
                 {% if form.llm_backend == "api" %}checked{% endif %}>
          <strong>OpenAI-compatible API</strong> — optional richer summaries.
          <div class="desc">OpenAI, OpenRouter, Ollama, vLLM, or another compatible endpoint. Online providers use separate API billing.</div>
        </label>

        <label class="backend-opt" data-value="anthropic">
          <input type="radio" name="llm_backend" value="anthropic"
                 {% if form.llm_backend == "anthropic" %}checked{% endif %}>
          <strong>Anthropic Claude API</strong> — native Messages API.
          <div class="desc">Uses an Anthropic Console API key and API billing; a Claude chat subscription is not an API key.</div>
        </label>

        <label class="backend-opt" data-value="claude_cli">
          <input type="radio" name="llm_backend" value="claude_cli"
                 {% if form.llm_backend == "claude_cli" %}checked{% endif %}>
          <strong>Signed-in Claude Code</strong> — use your local Claude login.
          <div class="desc">Requires the <code>claude</code> command to be installed and signed in. Tools and session persistence are disabled for summaries.</div>
        </label>

        <label class="backend-opt" data-value="codex_cli">
          <input type="radio" name="llm_backend" value="codex_cli"
                 {% if form.llm_backend == "codex_cli" %}checked{% endif %}>
          <strong>Signed-in Codex</strong> — use your local ChatGPT/Codex login.
          <div class="desc">Requires the <code>codex</code> command to be installed and signed in. Runs ephemerally, read-only, with agent tools disabled.</div>
        </label>
      </div>

      <p class="hint">AI-backed summaries send selected article metadata and your short reader profile to the provider you choose. Extractive stays local.</p>

      <div class="api-fields" id="api-fields"{% if form.llm_backend == "extractive" %} hidden{% endif %}>
        <div id="api-auth-fields"{% if form.llm_backend not in ["api", "anthropic"] %} hidden{% endif %}>
          <label for="llm_base_url">Base URL</label>
          <input type="url" id="llm_base_url" name="llm_base_url"
                 placeholder="https://api.openai.com/v1" value="{{ form.llm_base_url }}">
          <label for="llm_api_key">API key</label>
          <input type="password" id="llm_api_key" name="llm_api_key"
                 placeholder="Provider API key" value="{{ form.llm_api_key }}">
          {% if form.llm_api_key %}
          <label class="hint" for="remove_llm_api_key">
            <input type="checkbox" id="remove_llm_api_key" name="remove_llm_api_key"
                   value="true" {% if form.remove_llm_api_key == "true" %}checked{% endif %}>
            Remove the saved API key
          </label>
          {% endif %}
        </div>
        <label for="llm_model">Model</label>
        <input type="text" id="llm_model" name="llm_model"
               placeholder="gpt-4o-mini" value="{{ form.llm_model }}">
        <div class="hint" id="provider-hint"></div>
        <div id="connection-check-controls">
          <button class="btn" type="button" id="test-api-connection">Test API connection</button>
          <p class="hint" id="connection-check-note">Only when clicked: sends a small test to this API, which may be billed. Testing does not save settings.</p>
          <p class="hint" id="connection-check-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </details>

    <div class="settings-actions">
      <p class="hint" id="settings-save-status" role="status" aria-live="polite">{% if errors %}Changes have not been saved. Correct the highlighted fields.{% else %}Changes take effect after saving.{% endif %}</p>
      <button class="brew" type="submit">Save settings and choose today’s digest</button>
    </div>
  </form>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
  const topics = document.getElementById("topics");
  const details = document.getElementById("topic-details");
  const rows = document.getElementById("interest-rows");
  const editor = document.getElementById("interest-editor");
  let checkingWording = false;
  let metadata = {};
  try { metadata = JSON.parse(details.value || "{}"); } catch (_) {}
  // Suggestions use only wording the reader supplied, without a network call.
  function wordingVariants(topic) {
    topic = topic.trim().replace(/\s+/g, ' ');
    if (!topic || topic.length > 160) return [];
    const variants = [];
    const explicit = topic.match(/^(.+?)\s*\(([^()]+)\)$/);
    if (explicit) {
      const left = explicit[1].trim(), right = explicit[2].trim();
      const acronym = /^[A-Z][A-Z0-9]{1,15}$/;
      if ((acronym.test(left) && right.split(' ').length >= 2)
          || (acronym.test(right) && left.split(' ').length >= 2)) variants.push(left, right);
    }
    // Preserve chemical bonds/identifiers such as C-H and KRAS-G12D.
    const spaced = topic.replace(/\b([a-z]{3,})[-‐‑]([a-z]{3,})\b/g, '$1 $2');
    if (spaced !== topic) variants.push(spaced);
    const seen = new Set([topic.toLowerCase()]);
    return variants.filter(term => {
      const key = term.toLowerCase();
      if (term.length > 160 || seen.has(key)) return false;
      seen.add(key); return true;
    }).slice(0, 3);
  }
  function percentages(weights) {
    const count = weights.length;
    if (!count) return [];
    const sum = weights.reduce((a, b) => a + b, 0);
    if (!(sum > 0)) return percentages(weights.map(() => 1));
    const raw = weights.map(weight => 100 * weight / sum);
    const allocated = raw.map(weight => Math.max(1, Math.floor(weight)));
    let difference = 100 - allocated.reduce((a, b) => a + b, 0);
    const order = raw.map((weight, index) => ({index, fraction: weight % 1})).sort((a, b) => b.fraction - a.fraction || a.index - b.index);
    for (let i = 0; difference > 0; i++, difference--) allocated[order[i % count].index]++;
    // Very small legacy weights can require the 1% floor. Remove those
    // extra points from the most overallocated remaining interests.
    while (difference < 0) {
      const index = allocated.map((weight, index) => ({index, excess: weight - raw[index]})).filter(row => allocated[row.index] > 1).sort((a, b) => b.excess - a.excess || a.index - b.index)[0].index;
      allocated[index]--; difference++;
    }
    return allocated;
  }
  function serialize() {
    const result = [], data = {};
    for (const row of rows.children) {
      const name = row.querySelector('[data-interest-name]').value.trim();
      const weight = row.querySelector('[data-interest-weight]').value;
      if (name) {
        result.push(`${name} | ${weight}`);
        data[name] = {aliases: row.querySelector('[data-interest-aliases]').value.split(';').map(term => term.trim()).filter(Boolean), description: row.querySelector('[data-interest-description]').value.trim()};
        if (row.dataset.correctedFrom) data[name].previous_name = row.dataset.correctedFrom;
      }
    }
    topics.value = result.join('\n'); details.value = JSON.stringify(data);
    const sum = [...rows.querySelectorAll('[data-interest-weight]')].reduce((total, input) => total + Number(input.value || 0), 0);
    const inputs = [...rows.querySelectorAll('[data-interest-weight]')];
    const valid = sum === 100 && inputs.every(input => Number.isInteger(Number(input.value)) && Number(input.value) >= 1 && Number(input.value) <= 100);
    const reminder = sum < 100 ? ` · ${100 - sum}% left to assign` : sum > 100 ? ` · ${sum - 100}% over` : ' · use whole percentages';
    document.getElementById('interest-total').textContent = `Total: ${sum}%${valid ? ' · ready to save' : reminder + ' · normalize before saving'}`;
    if (inputs.length) inputs[0].setCustomValidity(valid ? '' : 'Use whole-number percentages totaling 100%. Choose Normalize to 100% to adjust them.');
    document.getElementById('add-interest').disabled = rows.children.length >= 10;
  }
  let rowSequence = 0, weightsEdited = false;
  function addRow(name = '', weight = 100, detail = {}) {
    const row = document.createElement('div'); row.className = 'interest-row';
    const originalFacetName = detail.previous_name || name;
    if (detail.previous_name) row.dataset.correctedFrom = detail.previous_name;
    // This markup is constant; reader text is assigned through .value only.
    row.innerHTML = '<div class="interest-heading"><label>Interest<input data-interest-name type="text" required maxlength="160" placeholder="e.g. targeted protein degradation"></label><label>Priority %<input data-interest-weight type="number" min="1" max="100" step="1" required></label><button class="btn" type="button">Remove</button></div><details><summary>Search details (optional)</summary><label>Alternative search terms, separated by semicolons<input data-interest-aliases type="text" placeholder="targeted protein degradation; PROTAC; molecular glue"></label><label>What would make a paper useful?<textarea data-interest-description maxlength="600" placeholder="e.g. New degrader designs and transferable methods; basic signaling is lower priority."></textarea></label></details>';
    const number = ++rowSequence;
    for (const [selector, label] of [['[data-interest-name]', 'Research topic'], ['[data-interest-weight]', 'Priority percentage'], ['[data-interest-aliases]', 'Alternative terms'], ['[data-interest-description]', 'Useful paper description']]) {
      row.querySelector(selector).setAttribute('aria-label', `${label} ${number}`);
    }
    row.querySelector('button').setAttribute('aria-label', `Remove research topic ${number}`);
    row.querySelector('[data-interest-weight]').addEventListener('input', () => { weightsEdited = true; });
    row.querySelector('[data-interest-name]').value = name;
    row.querySelector('[data-interest-weight]').value = weight;
    row.querySelector('[data-interest-aliases]').value = (detail.aliases || []).join('; ');
    row.querySelector('[data-interest-description]').value = detail.description || '';
    row.querySelector('button').addEventListener('click', () => { row.remove(); if (!rows.children.length) addRow(); distribute(false); });
    const aliasInput = row.querySelector('[data-interest-aliases]');
    const variantActions = document.createElement('div'); variantActions.className = 'interest-actions';
    const variantStatus = document.createElement('p'); variantStatus.className = 'hint'; variantStatus.setAttribute('aria-live', 'polite');
    const suggest = document.createElement('button'); suggest.type = 'button'; suggest.className = 'btn'; suggest.textContent = 'Suggest wording variants';
    const clearVariants = () => { variantActions.replaceChildren(suggest); variantStatus.textContent = ''; };
    suggest.addEventListener('click', () => {
      clearVariants();
      const aliases = aliasInput.value.split(';').map(term => term.trim().toLowerCase()).filter(Boolean);
      const variants = wordingVariants(row.querySelector('[data-interest-name]').value).filter(term => !aliases.includes(term.toLowerCase()));
      variantStatus.textContent = variants.length
        ? 'Local wording variants only. Add one if it means the same thing in your field; save settings to use it. No synonym search was performed.'
        : 'No additional wording variants found locally. Add field-specific synonyms or established acronyms yourself; this does not mean no papers exist.';
      for (const term of variants) {
        const add = document.createElement('button'); add.type = 'button'; add.className = 'btn'; add.textContent = `Add “${term}”`;
        add.addEventListener('click', () => {
          const current = aliasInput.value.split(';').map(value => value.trim()).filter(Boolean);
          if (current.some(value => value.toLowerCase() === term.toLowerCase())) { add.disabled = true; return; }
          if (current.length >= 3) { variantStatus.textContent = 'Keep up to 3 alternative terms. Remove one before adding another.'; return; }
          aliasInput.value = [...current, term].join('; '); add.disabled = true; serialize();
          variantStatus.textContent = 'Variant added to the form. Save settings to use it for searches and ranking.';
        });
        variantActions.append(add);
      }
    });
    clearVariants();
    row.querySelector('details').append(variantActions, variantStatus);
    const nameInput = row.querySelector('[data-interest-name]');
    const spelling = document.createElement('div'); spelling.className = 'interest-spelling';
    const spellingActions = document.createElement('div'); spellingActions.className = 'interest-actions';
    const spellingStatus = document.createElement('p'); spellingStatus.className = 'hint'; spellingStatus.setAttribute('aria-live', 'polite');
    const check = document.createElement('button'); check.type = 'button'; check.className = 'btn'; check.dataset.checkWording = ''; check.textContent = 'Check wording'; check.disabled = checkingWording;
    const accept = document.createElement('button'); accept.type = 'button'; accept.className = 'btn'; accept.textContent = 'Use suggestion'; accept.hidden = true;
    const dismiss = document.createElement('button'); dismiss.type = 'button'; dismiss.className = 'btn'; dismiss.textContent = 'Keep wording'; dismiss.hidden = true;
    spellingActions.append(check, accept, dismiss); spelling.append(spellingActions, spellingStatus); row.querySelector('details').append(spelling);
    let wordingVersion = 0, suggestion = null;
    const clearSuggestion = () => { suggestion = null; accept.hidden = dismiss.hidden = true; spellingStatus.textContent = ''; };
    nameInput.addEventListener('input', () => { wordingVersion++; delete row.dataset.correctedFrom; clearSuggestion(); clearVariants(); });
    check.addEventListener('click', async () => {
      if (checkingWording) return;
      const original = nameInput.value.trim(), version = wordingVersion;
      clearSuggestion();
      if (!original) { spellingStatus.textContent = 'Enter an interest first.'; nameInput.focus(); return; }
      checkingWording = true;
      rows.querySelectorAll('[data-check-wording]').forEach(button => { button.disabled = true; });
      spellingStatus.textContent = 'Checking this interest’s spelling…';
      try {
        const response = await fetch('/setup/check-wording?' + new URLSearchParams({topic: original}), {
          method: 'POST', headers: {'X-CSRF-Token': topics.form.querySelector('[name="_csrf_token"]').value},
        });
        const result = await response.json();
        if (!row.isConnected || version !== wordingVersion) return;
        if (!response.ok) throw new Error('Spelling unavailable');
        if (!result.suggestion) { spellingStatus.textContent = 'No spelling suggestion found. Keep your wording, or add alternative terms if needed.'; return; }
        suggestion = result.suggestion;
        spellingStatus.textContent = `Did you mean “${suggestion}”? Your interest is unchanged until you choose Use suggestion.`;
        accept.hidden = dismiss.hidden = false;
      } catch (_) {
        if (row.isConnected && version === wordingVersion) spellingStatus.textContent = 'Couldn’t check wording right now. Your interest is unchanged. Try again later.';
      } finally {
        checkingWording = false;
        rows.querySelectorAll('[data-check-wording]').forEach(button => { button.disabled = false; });
      }
    });
    accept.addEventListener('click', () => {
      if (!suggestion) return;
      const duplicate = [...rows.children].some(other => other !== row && other.querySelector('[data-interest-name]').value.trim().toLowerCase() === suggestion.toLowerCase());
      if (duplicate) { clearSuggestion(); spellingStatus.textContent = 'Another interest already uses that wording. Combine or remove duplicate interests before changing this one.'; return; }
      nameInput.value = suggestion;
      nameInput.dispatchEvent(new Event('input', {bubbles: true}));
      if (originalFacetName) row.dataset.correctedFrom = originalFacetName;
      serialize();
      spellingStatus.textContent = 'Suggestion applied. Save your settings to use it for searches and ranking.';
      nameInput.focus();
    });
    dismiss.addEventListener('click', () => { clearSuggestion(); spellingStatus.textContent = 'Your wording was kept.'; nameInput.focus(); });
    row.addEventListener('input', serialize); rows.append(row);
  }
  function loadRows() {
    try { metadata = JSON.parse(details.value || '{}'); } catch (_) { metadata = {}; }
    const configured = topics.value.split('\n').filter(line => line.trim()).map(line => {
      const [name, weight = '1'] = line.split('|'); return {name: name.trim(), weight: Number(weight.trim()) || 1};
    });
    const weights = configured.map(row => row.weight);
    // Keep invalid submitted percentages visible on a validation error.
    const converted = {{ 'true' if errors and form.topic_weight_mode | default('') == 'percentage' else 'false' }} ? weights : percentages(weights);
    rows.replaceChildren();
    configured.forEach((row, index) => addRow(row.name, converted[index], metadata[row.name] || {}));
    if (!configured.length) addRow();
    serialize();
  }
  const priorities = document.getElementById('priority-options');
  const showPriorities = () => { editor.classList.toggle('show-priorities', priorities.open); };
  priorities.addEventListener('toggle', showPriorities); showPriorities();
  loadRows(); editor.hidden = false; topics.hidden = true; topics.required = false; details.disabled = false;
  document.getElementById('topic-weight-mode').disabled = false;
  document.getElementById('topics-hint').hidden = true;
  topics.addEventListener('input', loadRows); topics.addEventListener('change', loadRows);
  document.getElementById('add-interest').addEventListener('click', () => {
    if (rows.children.length >= 10) return;
    addRow('', 1);
    distribute(!weightsEdited); rows.lastElementChild.querySelector('input').focus();
  });
  function distribute(even) {
    const inputs = [...rows.querySelectorAll('[data-interest-weight]')];
    const weights = percentages(inputs.map(input => even ? 1 : Math.max(0, Number(input.value) || 0)));
    inputs.forEach((input, index) => { input.value = weights[index]; });
    serialize();
  }
  document.getElementById('normalize-interests').addEventListener('click', () => distribute(false));
  document.getElementById('even-interests').addEventListener('click', () => distribute(true));
  topics.form.addEventListener('submit', event => {
    serialize();
    if (!topics.form.checkValidity()) { event.preventDefault(); topics.form.reportValidity(); }
  });
  const exampleButton = document.getElementById('use-example-profile');
  if (exampleButton) exampleButton.addEventListener('click', () => {
    if ([...rows.querySelectorAll('[data-interest-name]')].some(input => input.value.trim())) return;
    const examples = {
      biomolecular: topics.getAttribute('placeholder'),
      engineering: 'Battery materials\nPolymer recycling\nAdditive manufacturing\nThermal energy storage',
      ecology: 'Biodiversity monitoring\nEcosystem restoration\nClimate adaptation\nEnvironmental DNA',
      chemistry: 'Asymmetric catalysis\nOrganocatalysis\nPhotoredox catalysis\nReaction mechanism prediction',
      astronomy: 'Exoplanet atmospheres\nGalaxy formation\nGravitational waves\nCosmological simulations',
    };
    topics.value = examples[document.getElementById('example-discipline').value]; loadRows();
    topics.form.dispatchEvent(new Event('input', {bubbles: true}));
    exampleButton.disabled = true;
    document.getElementById('example-profile-note').textContent = 'Example loaded. Make it your own, then save when you’re ready.';
    rows.querySelector('input').focus();
  });
  const timezoneInput = document.getElementById("user-timezone");
  try {
    const browserTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    if (timezoneInput && browserTimezone) timezoneInput.value = browserTimezone;
  } catch (_) {}

  function makeChipInput(wrapId, textId, hiddenId) {
    const wrap = document.getElementById(wrapId);
    const text = document.getElementById(textId);
    const hidden = document.getElementById(hiddenId);
    const chips = [];

    function render() {
      wrap.querySelectorAll(".chip").forEach((c) => c.remove());
      chips.forEach((val, idx) => {
	        const c = document.createElement("button");
	        c.className = "chip";
	        c.type = "button";
	        c.textContent = val + " ✕";
	        c.setAttribute("aria-label", `Remove ${val}`);
	        c.addEventListener("click", () => { chips.splice(idx, 1); render(); });
	        wrap.insertBefore(c, text);
      });
      hidden.value = chips.join(",");
    }

    function add(val) {
      const v = (val || "").trim();
      if (v && !chips.includes(v)) chips.push(v);
      text.value = "";
      render();
    }

    text.addEventListener("keydown", (e) => {
      if (e.key === "," || e.key === "Enter") {
        e.preventDefault();
        add(text.value);
      } else if (e.key === "Backspace" && !text.value && chips.length) {
        chips.pop(); render();
      }
    });
    text.addEventListener("blur", () => { if (text.value.trim()) add(text.value); });

    // Seed from initial hidden value (server-rendered).
    const init = (hidden.value || "").split(",").map((s) => s.trim()).filter(Boolean);
    init.forEach((v) => chips.push(v));
    render();
  }

	  makeChipInput("dw-input", "dw-text", "dw-hidden");

	  const errors = document.querySelector(".errors");
	  if (errors) errors.focus();

  // Reveal invalid fields before native validation focuses them.
  const settingsForm = document.querySelector('form[action="/setup"]');
  const saveStatus = document.getElementById('settings-save-status');
  const markUnsaved = () => { saveStatus.textContent = 'Unsaved changes. Save to apply your settings.'; };
  settingsForm.addEventListener('input', markUnsaved);
  settingsForm.addEventListener('change', markUnsaved);
  settingsForm.addEventListener('click', (event) => {
    if (event.target.closest('#add-interest, #even-interests, #normalize-interests, .interest-heading button, .chip')) markUnsaved();
  });
  settingsForm.addEventListener("invalid", (event) => {
    for (let node = event.target.parentElement; node && node !== settingsForm; node = node.parentElement) {
      if (node.tagName === "DETAILS") node.open = true;
      if (node.hidden) node.hidden = false;
    }
  }, true);

  // Backend reveal logic.
  const apiFields = document.getElementById("api-fields");
  const apiAuthFields = document.getElementById("api-auth-fields");
  const baseUrlInput = document.getElementById("llm_base_url");
  const modelInput = document.getElementById("llm_model");
  const providerHint = document.getElementById("provider-hint");
  const summaryCurrent = document.getElementById("summary-current");
  const radios = document.querySelectorAll('input[name="llm_backend"]');
  const providerDefaults = {
    extractive: { base: "https://api.openai.com/v1", model: "gpt-4o-mini" },
    api: { base: "https://api.openai.com/v1", model: "gpt-4o-mini" },
    anthropic: { base: "https://api.anthropic.com/v1", model: "claude-haiku-4-5-20251001" },
    claude_cli: { base: "", model: "haiku" },
    codex_cli: { base: "", model: "" },
  };
  let activeBackend = (document.querySelector('input[name="llm_backend"]:checked') || {}).value || "extractive";

  function refresh() {
    const sel = document.querySelector('input[name="llm_backend"]:checked');
    const v = sel ? sel.value : "extractive";
    const isApi = v === "api" || v === "anthropic";
    const isCli = v === "claude_cli" || v === "codex_cli";
    summaryCurrent.textContent = v === "extractive" ? "Local extractive" : sel.closest("label").querySelector("strong").textContent;
    apiFields.hidden = !(isApi || isCli);
    apiAuthFields.hidden = !isApi;
    document.getElementById('connection-check-controls').hidden = !isApi;
    if (v === "anthropic") {
      baseUrlInput.placeholder = "https://api.anthropic.com/v1";
      modelInput.placeholder = "claude-haiku-4-5-20251001";
      providerHint.textContent = "Recommended economical model: Claude Haiku 4.5.";
    } else if (v === "claude_cli") {
      modelInput.placeholder = "haiku (optional; blank uses your Claude default)";
      providerHint.textContent = "Run claude once in a terminal to install/sign in before brewing.";
    } else if (v === "codex_cli") {
      modelInput.placeholder = "optional; blank uses your Codex default";
      providerHint.textContent = "Run codex login status in a terminal to confirm sign-in before brewing.";
    } else {
      baseUrlInput.placeholder = "https://api.openai.com/v1";
      modelInput.placeholder = "gpt-4o-mini";
      providerHint.textContent = "Online API accounts are billed separately from chat subscriptions.";
    }
    document.querySelectorAll(".backend-opt").forEach((opt) => {
      opt.classList.toggle("selected", opt.dataset.value === v);
    });
  }
  radios.forEach((radio) => radio.addEventListener("change", () => {
    const previous = providerDefaults[activeBackend] || providerDefaults.extractive;
    const next = providerDefaults[radio.value] || providerDefaults.extractive;
    if (!modelInput.value.trim() || modelInput.value.trim() === previous.model) {
      modelInput.value = next.model;
    }
    if (!baseUrlInput.value.trim() || baseUrlInput.value.trim() === previous.base) {
      baseUrlInput.value = next.base;
    }
    activeBackend = radio.value;
    refresh();
  }));
  refresh();

  const connectionButton = document.getElementById('test-api-connection');
  const connectionStatus = document.getElementById('connection-check-status');
  const connectionFields = ['llm_base_url', 'llm_api_key', 'llm_model'];
  let connectionVersion = 0;
  function invalidateConnection() { connectionVersion++; connectionStatus.textContent = ''; }
  for (const id of connectionFields) document.getElementById(id).addEventListener('input', invalidateConnection);
  radios.forEach(radio => radio.addEventListener('change', invalidateConnection));
  connectionButton.addEventListener('click', async () => {
    const version = connectionVersion;
    const body = new URLSearchParams();
    body.set('llm_backend', document.querySelector('input[name="llm_backend"]:checked').value);
    for (const id of connectionFields) body.set(id, document.getElementById(id).value);
    connectionButton.disabled = true;
    connectionStatus.textContent = 'Testing this API connection…';
    try {
      const response = await fetch('/setup/test-connection', {
        method: 'POST', headers: {'X-CSRF-Token': settingsForm.querySelector('[name="_csrf_token"]').value}, body,
      });
      const result = await response.json();
      if (version !== connectionVersion) return;
      connectionStatus.textContent = response.ok ? result.message : 'Connection test unavailable. Check your settings and try again.';
    } catch (_) {
      if (version === connectionVersion) connectionStatus.textContent = 'Connection test unavailable. Check your settings and try again.';
    } finally { connectionButton.disabled = false; }
  });
  window.addEventListener('dd-companion-capabilities', (event) => {
    const backends = event.detail.backends || [];
    document.getElementById('connection-check-note').textContent = 'Only when clicked: tests the API directly from this browser with a small request that may be billed. Testing does not save settings.';
    for (const backend of ['claude_cli', 'codex_cli']) {
      const radio = document.querySelector(`input[name="llm_backend"][value="${backend}"]`);
      const available = backends.includes(backend);
      radio.disabled = !available && !radio.checked;
      const label = radio.closest('label');
      let note = label.querySelector('[data-companion-note]');
      if (!note) { note = document.createElement('div'); note.className = 'desc'; note.dataset.companionNote = ''; label.append(note); }
      note.textContent = available ? 'Connected companion supports this command.' : 'Unavailable: connect a browser companion with this command installed and signed in, or choose Extractive.';
    }
  });

  // An off section keeps its previous cap but removes the inactive control
  // from keyboard navigation and form submission.
  document.querySelectorAll('input[role="switch"]').forEach((toggle) => {
    const count = document.getElementById(toggle.id.replace("include_", "top_"));
    if (!count) return;
    function refreshSection() {
      count.disabled = !toggle.checked;
      count.min = toggle.checked ? "1" : "0";
      count.setAttribute("aria-disabled", String(!toggle.checked));
    }
    toggle.addEventListener("change", refreshSection);
    refreshSection();
  });

  const opportunityPanel = document.getElementById("opportunity-profile");
  const opportunityToggles = [
    document.getElementById("include_opportunities"),
    document.getElementById("include_events")
  ];
  function refreshOpportunityProfile() {
    const enabled = opportunityToggles.some((toggle) => toggle && toggle.checked);
    opportunityPanel.hidden = !enabled;
    opportunityPanel.querySelectorAll("input, textarea").forEach((field) => {
      field.disabled = !enabled;
    });
    opportunityPanel.querySelectorAll("[data-opportunity-required]").forEach((field) => {
      field.required = enabled;
    });
  }
  opportunityToggles.forEach((toggle) => {
    if (toggle) toggle.addEventListener("change", refreshOpportunityProfile);
  });
  refreshOpportunityProfile();
})();
</script>
{% endblock %}
